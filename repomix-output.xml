name: Histórico de Odds

on:
  schedule:
    - cron: '0 19 * * *'
  workflow_dispatch:

permissions:
  contents: write

jobs:
  save-history:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repositório
        uses: actions/checkout@v4
        with:
          token: ${{ secrets.GH_PAT }}
          persist-credentials: true

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '24'

      - name: Instalar dependências
        run: npm install axios firebase-admin

      - name: Injetar chaves de API
        run: |
          node -e "
          const fs = require('fs');
          const keys = process.env.ODDS_API_KEYS.split(',');
          let content = fs.readFileSync('pipeline/save_odds_history.js', 'utf8');
          content = content.replace(
            /const API_KEYS = \[[\s\S]*?\];/,
            'const API_KEYS = ' + JSON.stringify(keys, null, 2) + ';'
          );
          fs.writeFileSync('pipeline/save_odds_history.js', content);
          console.log('Chaves injetadas:', keys.length);
          "
        env:
          ODDS_API_KEYS: ${{ secrets.ODDS_API_KEYS }}

      - name: Restaurar histórico anterior
        run: |
          git fetch origin history 2>/dev/null && \
          git show origin/history:odds_history.tar.gz > /tmp/odds_history.tar.gz 2>/dev/null && \
          tar -xzf /tmp/odds_history.tar.gz -C . 2>/dev/null && \
          echo "Histórico restaurado" || \
          echo "Sem histórico anterior — primeira execução"
          mkdir -p odds_history

      - name: Executar coleta
        run: node pipeline/save_odds_history.js

      - name: Sincronizar histórico com Firestore
        run: node pipeline/firebase_sync.js history
        env:
          FIREBASE_SERVICE_ACCOUNT: ${{ secrets.FIREBASE_SERVICE_ACCOUNT }}

      - name: Empacotar e salvar na branch history
        run: |
          tar -czf /tmp/odds_history.tar.gz odds_history/
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git checkout --orphan history-tmp
          git rm -rf . --quiet
          cp /tmp/odds_history.tar.gz .
          git add odds_history.tar.gz
          git commit -m "odds: $(date -u '+%Y-%m-%d %H:%M') UTC"
          git push origin HEAD:history --force

      - name: Acionar atualização do modelo
        run: |
          curl -s -X POST \
            -H "Authorization: token ${{ secrets.GH_PAT }}" \
            -H "Accept: application/vnd.github.v3+json" \
            https://api.github.com/repos/ubereats-oss/edge-finder/actions/workflows/update_model.yml/dispatches \
            -d '{"ref":"main","inputs":{"sport":"all"}}'
</file>

<file path=".github/workflows/update_model.yml">
name: Atualizar Modelo

on:
  workflow_dispatch:
    inputs:
      sport:
        description: 'Esporte a atualizar'
        required: true
        default: 'nba_br'
        type: choice
        options:
          - nba_br
          - nba
          - mlb
          - tennis
          - all

permissions:
  contents: write

jobs:
  update:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repositório
        uses: actions/checkout@v4
        with:
          token: ${{ secrets.GH_PAT }}
          persist-credentials: true

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '24'

      - name: Instalar dependências
        run: npm install axios firebase-admin

      - name: Injetar chaves da Odds API no ambiente
        run: |
          node -e "
          const keys = process.env.ODDS_API_KEYS.split(',');
          const lines = [];
          keys.forEach((k, i) => {
            const name = i === 0 ? 'ODDS_API_KEY' : 'ODDS_API_KEY_' + (i + 1);
            lines.push(name + '=' + k.trim());
          });
          require('fs').appendFileSync(process.env.GITHUB_ENV, lines.join('\n') + '\n');
          console.log('Chaves injetadas no ambiente:', keys.length);
          "
        env:
          ODDS_API_KEYS: ${{ secrets.ODDS_API_KEYS }}

      - name: Restaurar histórico anterior
        run: |
          git fetch origin history 2>/dev/null && \
          git show origin/history:odds_history.tar.gz > /tmp/odds_history.tar.gz 2>/dev/null && \
          tar -xzf /tmp/odds_history.tar.gz -C . 2>/dev/null && \
          echo "Histórico restaurado" || \
          echo "Sem histórico anterior"
          mkdir -p odds_history

      - name: Restaurar dados da branch data
        run: |
          git fetch origin data 2>/dev/null || echo "Branch data não existe ainda"
          git show origin/data:nba_player_stats.json.gz > /tmp/nba_player_stats.json.gz 2>/dev/null && \
            gunzip -c /tmp/nba_player_stats.json.gz > nba_player_stats.json && \
            echo "nba_player_stats.json restaurado: $(wc -c < nba_player_stats.json) bytes" || \
            echo "nba_player_stats.json não encontrado — modelo usará stats vazios"
          git show origin/data:mlb_player_stats.json.gz > /tmp/mlb_player_stats.json.gz 2>/dev/null && \
            gunzip -c /tmp/mlb_player_stats.json.gz > mlb_player_stats.json && \
            echo "mlb_player_stats.json restaurado: $(wc -c < mlb_player_stats.json) bytes" || \
            echo "mlb_player_stats.json não encontrado — modelo usará stats vazios"
          for f in nba_player_team.json nba_boxscores_cache.json nba_injuries_today.json nba_rating.json mlb_player_team.json mlb_injuries_today.json mlb_team_rating.json; do
            git show origin/data:$f > $f 2>/dev/null && echo "Restaurado: $f" || echo "Não encontrado: $f"
          done
          git show origin/data:bets.json > bets.json 2>/dev/null && echo "bets.json restaurado" || echo '[]' > bets.json

      - name: Atualizar injuries (NBA)
        if: ${{ github.event.inputs.sport == 'nba_br' || github.event.inputs.sport == 'nba' || github.event.inputs.sport == 'all' }}
        run: node pipeline/get_nba_injuries.js

      - name: Atualizar props BR (NBA)
        if: ${{ github.event.inputs.sport == 'nba_br' || github.event.inputs.sport == 'all' }}
        run: node pipeline/get_nba_props_br.js

      - name: Rodar modelo props BR (NBA)
        if: ${{ github.event.inputs.sport == 'nba_br' || github.event.inputs.sport == 'all' }}
        run: node pipeline/model_nba_props_br.js

      - name: Atualizar odds NBA H2H
        if: ${{ github.event.inputs.sport == 'nba_br' || github.event.inputs.sport == 'nba' || github.event.inputs.sport == 'all' }}
        run: node pipeline/get_nba_odds.js

      - name: Rodar modelo NBA H2H
        if: ${{ github.event.inputs.sport == 'nba_br' || github.event.inputs.sport == 'nba' || github.event.inputs.sport == 'all' }}
        run: node pipeline/model_nba.js

      - name: Atualizar props NBA (padrão)
        if: ${{ github.event.inputs.sport == 'nba' }}
        run: node pipeline/get_nba_props.js

      - name: Rodar modelo props NBA (padrão)
        if: ${{ github.event.inputs.sport == 'nba' }}
        run: node pipeline/model_nba_props.js

      - name: Atualizar injuries (MLB)
        if: ${{ github.event.inputs.sport == 'mlb' || github.event.inputs.sport == 'all' }}
        run: node pipeline/get_mlb_injuries.js

      - name: Atualizar times MLB
        if: ${{ github.event.inputs.sport == 'mlb' || github.event.inputs.sport == 'all' }}
        run: node pipeline/get_mlb_player_teams.js

      - name: Atualizar odds MLB
        if: ${{ github.event.inputs.sport == 'mlb' || github.event.inputs.sport == 'all' }}
        run: node pipeline/get_mlb_odds.js

      - name: Rodar modelo MLB
        if: ${{ github.event.inputs.sport == 'mlb' || github.event.inputs.sport == 'all' }}
        run: node pipeline/model_mlb.js

      - name: Atualizar props MLB
        if: ${{ github.event.inputs.sport == 'mlb' || github.event.inputs.sport == 'all' }}
        run: node pipeline/get_mlb_props.js

      - name: Rodar modelo props MLB
        if: ${{ github.event.inputs.sport == 'mlb' || github.event.inputs.sport == 'all' }}
        run: node pipeline/model_mlb_props.js

      - name: Atualizar odds Tênis
        if: ${{ github.event.inputs.sport == 'tennis' }}
        run: node pipeline/get_odds.js

      - name: Rodar modelo Tênis
        if: ${{ github.event.inputs.sport == 'tennis' }}
        run: node pipeline/model_prob.js

      - name: Sincronizar resultados com Firestore
        run: node pipeline/firebase_sync.js results
        env:
          FIREBASE_SERVICE_ACCOUNT: ${{ secrets.FIREBASE_SERVICE_ACCOUNT }}

      - name: Sincronizar apostas com Firestore
        run: node pipeline/firebase_sync.js bets
        env:
          FIREBASE_SERVICE_ACCOUNT: ${{ secrets.FIREBASE_SERVICE_ACCOUNT }}

      - name: Salvar dados na branch data
        run: |
          gzip -c nba_player_stats.json > /tmp/nba_player_stats.json.gz 2>/dev/null || true
          gzip -c mlb_player_stats.json > /tmp/mlb_player_stats.json.gz 2>/dev/null || true
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git fetch origin data 2>/dev/null || true
          git checkout --orphan data-tmp
          git rm -rf . --quiet
          cp /tmp/nba_player_stats.json.gz . 2>/dev/null || true
          cp /tmp/mlb_player_stats.json.gz . 2>/dev/null || true
          rm -f nba_player_stats.json mlb_player_stats.json
          for f in nba_player_team.json nba_injuries_today.json nba_rating.json mlb_player_team.json mlb_injuries_today.json mlb_team_rating.json bets.json; do
            cp $f . 2>/dev/null || true
          done
          git add -A
          git diff --staged --quiet && echo "Sem mudanças" || git commit -m "data: $(date -u '+%Y-%m-%d %H:%M') UTC"
          git push origin HEAD:data --force
</file>

