        params: {
          apiKey: key,
          regions: REGION,
          markets: MARKETS,
          bookmakers: BOOKMAKER,
          oddsFormat: 'decimal',
        },
      });
      const remaining = res.headers['x-requests-remaining'];
      if (remaining !== undefined) console.log(`    Créditos restantes: ${remaining}`);
      return res.data;
