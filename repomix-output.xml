                borderRadius: BorderRadius.circular(12),
                border: Border.all(
                    color: const Color(0xFF7C4DFF).withValues(alpha: 0.4)),
              ),
              child: Row(
                children: [
                  Text('${kelly.toStringAsFixed(2)}% da banca',
