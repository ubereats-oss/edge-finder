<file path=".github/workflows/update_player_stats.yml">
 1: name: Atualizar Estatísticas de Jogadores
 2: 
 3: on:
 4:   schedule:
 5:     - cron: '0 10 * * *'
 6:   workflow_dispatch:
 7: 
 8: permissions:
 9:   contents: write
10: 
11: jobs:
12:   update-stats:
13:     runs-on: ubuntu-latest
14: 
15:     steps:
16:       - name: Checkout repositório
17:         uses: actions/checkout@v4
18:         with:
19:           token: ${{ secrets.GH_PAT }}
20:           persist-credentials: true
21: 
22:       - name: Setup Node.js
23:         uses: actions/setup-node@v4
24:         with:
25:           node-version: '24'
26: 
27:       - name: Instalar dependências
28:         run: npm install axios
29: 
30:       - name: Restaurar stats da branch data
31:         run: |
32:           git fetch origin data 2>/dev/null || echo "Branch data não existe ainda"
33:           git show origin/data:nba_player_stats.json.gz > /tmp/nba_player_stats.json.gz 2>/dev/null && \
34:             gunzip -c /tmp/nba_player_stats.json.gz > nba_player_stats.json && \
35:             echo "nba_player_stats.json restaurado: $(wc -c < nba_player_stats.json) bytes" || \
36:             echo "nba_player_stats.json não encontrado — será criado do zero"
37:           git show origin/data:mlb_player_stats.json.gz > /tmp/mlb_player_stats.json.gz 2>/dev/null && \
38:             gunzip -c /tmp/mlb_player_stats.json.gz > mlb_player_stats.json && \
39:             echo "mlb_player_stats.json restaurado: $(wc -c < mlb_player_stats.json) bytes" || \
40:             echo "mlb_player_stats.json não encontrado — será criado do zero"
41: 
42:       - name: Atualizar stats NBA (incremental)
43:         run: node pipeline/get_nba_player_stats.js
44: 
45:       - name: Atualizar stats MLB (incremental)
46:         run: node pipeline/get_mlb_player_stats.js
47: 
48:       - name: Salvar stats na branch data
49:         run: |
50:           gzip -c nba_player_stats.json > /tmp/nba_player_stats.json.gz
51:           gzip -c mlb_player_stats.json > /tmp/mlb_player_stats.json.gz 2>/dev/null || true
52:           git config user.name "github-actions[bot]"
53:           git config user.email "github-actions[bot]@users.noreply.github.com"
54:           git fetch origin data 2>/dev/null || true
55:           git checkout --orphan data-stats-tmp
56:           git rm -rf . --quiet
57:           printf 'node_modules/\n*.json\n' > .gitignore
58:           cp /tmp/nba_player_stats.json.gz .
59:           cp /tmp/mlb_player_stats.json.gz . 2>/dev/null || true
60:           git show origin/data:nba_player_team.json > nba_player_team.json 2>/dev/null || true
61:           git show origin/data:nba_injuries_today.json > nba_injuries_today.json 2>/dev/null || true
62:           git show origin/data:mlb_player_team.json > mlb_player_team.json 2>/dev/null || true
63:           git show origin/data:mlb_injuries_today.json > mlb_injuries_today.json 2>/dev/null || true
64:           git show origin/data:bets.json > bets.json 2>/dev/null || echo '[]' > bets.json
65:           git show origin/data:mlb_team_rating.json > mlb_team_rating.json 2>/dev/null || true
66:           printf 'node_modules/\n' > .gitignore
67:           git add .gitignore *.gz nba_player_team.json nba_injuries_today.json mlb_player_team.json mlb_injuries_today.json bets.json mlb_team_rating.json
68:           git diff --staged --quiet && echo "Sem mudanças nos stats" || git commit -m "stats: $(date -u '+%Y-%m-%d %H:%M') UTC"
69:           git push origin HEAD:data --force
</file>

