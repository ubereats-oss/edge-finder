  3: // ── Configuração ───────────────────────────────────────────────────────────────
  4: const KELLY_FRACTION  = 0.25;
  5: const HOUSE_MARGIN    = 0.05;
  6: const MIN_GAMES_MKT   = 8;
  7: const MIN_GAMES_MODEL = 5;
  8: const STAT_KEYS       = ['goals', 'assists', 'points', 'shots', 'blocked'];
  9: const BASE_SEASON     = 2025; // temporada 2024-25
 10: const WALK_SEASON     = 2026; // temporada 2025-26
 11: const BANKROLL_START  = 1000;
 12: const FLAT_STAKE_CAP  = BANKROLL_START * 0.05;
 13: const DECAY           = 0.97;
 14: const MIN_TOI_SECONDS = 300;
 15: 
 16: // ── Utilitários ────────────────────────────────────────────────────────────────
 17: function erf(x) {
 18:   const sign = x >= 0 ? 1 : -1;
 19:   x = Math.abs(x);
 20:   const a1 = 0.254829592, a2 = -0.284496736, a3 = 1.421413741;
 21:   const a4 = -1.453152027, a5 = 1.061405429, p = 0.3275911;
 22:   const t = 1 / (1 + p * x);
 23:   const y = 1 - (((((a5 * t + a4) * t) + a3) * t + a2) * t + a1) * t * Math.exp(-x * x);
 24:   return sign * y;
 25: }
 26: 
 27: function normalCDF(x, mu, sigma) {
 28:   if (sigma <= 0) return x >= mu ? 1 : 0;
 29:   return 0.5 * (1 + erf((x - mu) / (sigma * Math.sqrt(2))));
 30: }
 31: 
 32: function probOver(mu, sigma, line)  { return 1 - normalCDF(line, mu, sigma); }
 33: function probUnder(mu, sigma, line) { return normalCDF(line, mu, sigma); }
 34: 
 35: function marketOdd(p) {
 36:   if (p <= 0.01) return null;
 37:   return 1 / (p * (1 + HOUSE_MARGIN));
 38: }
 39: 
 40: function calcKelly(prob, odds) {
 41:   const b = odds - 1;
 42:   const q = 1 - prob;
 43:   const k = (prob * b - q) / b;
 44:   return Math.max(0, k * KELLY_FRACTION);
 45: }
 46: 
 47: function calcAvgStd(values) {
 48:   if (!values || values.length === 0) return null;
 49:   const avg = values.reduce((s, v) => s + v, 0) / values.length;
 50:   const variance = values.reduce((s, v) => s + Math.pow(v - avg, 2), 0) / values.length;
 51:   return { avg, std: Math.sqrt(variance), count: values.length };
 52: }
 53: 
 54: function calcWeightedAvgStd(values) {
 55:   if (!values || values.length === 0) return null;
 56:   let wSum = 0, wSumSq = 0, totalW = 0;
 57:   const n = values.length;
 58:   for (let i = 0; i < n; i++) {
 59:     const w = Math.pow(DECAY, n - 1 - i);
 60:     wSum   += values[i] * w;
 61:     wSumSq += values[i] * values[i] * w;
 62:     totalW += w;
 63:   }
 64:   const avg = wSum / totalW;
 65:   const variance = Math.max(0, wSumSq / totalW - avg * avg);
 66:   return { avg, std: Math.sqrt(variance), count: n };
 67: }
 68: 
 69: // ── Calibração isotônica (idêntica ao model_nhl_props.js) ─────────────────────
 70: const CALIB_TABLE = [
 71:   { raw: 0.519, cal: 0.504 },
 72:   { raw: 0.576, cal: 0.572 },
 73:   { raw: 0.625, cal: 0.608 },
 74:   { raw: 0.674, cal: 0.671 },
 75:   { raw: 0.723, cal: 0.720 },
 76:   { raw: 0.771, cal: 0.764 },
 77:   { raw: 0.816, cal: 0.811 },
 78: ];
 79: 
 80: function calibrate(p) {
 81:   if (p < 0.5) return 1 - calibrate(1 - p);
 82:   const n = CALIB_TABLE.length;
 83:   if (p <= CALIB_TABLE[0].raw) {
 84:     const slope = (CALIB_TABLE[1].cal - CALIB_TABLE[0].cal) /
 85:                   (CALIB_TABLE[1].raw - CALIB_TABLE[0].raw);
 86:     return Math.min(1, Math.max(0, CALIB_TABLE[0].cal + slope * (p - CALIB_TABLE[0].raw)));
 87:   }
 88:   if (p >= CALIB_TABLE[n - 1].raw) {
 89:     const slope = (CALIB_TABLE[n - 1].cal - CALIB_TABLE[n - 2].cal) /
 90:                   (CALIB_TABLE[n - 1].raw - CALIB_TABLE[n - 2].raw);
 91:     return Math.min(1, Math.max(0, CALIB_TABLE[n - 1].cal + slope * (p - CALIB_TABLE[n - 1].raw)));
 92:   }
 93:   for (let i = 0; i < n - 1; i++) {
 94:     if (p >= CALIB_TABLE[i].raw && p <= CALIB_TABLE[i + 1].raw) {
 95:       const t = (p - CALIB_TABLE[i].raw) / (CALIB_TABLE[i + 1].raw - CALIB_TABLE[i].raw);
 96:       return CALIB_TABLE[i].cal + t * (CALIB_TABLE[i + 1].cal - CALIB_TABLE[i].cal);
 97:     }
 98:   }
 99:   return p;
100: }
