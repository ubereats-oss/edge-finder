 89: function erf(x) {
 90:   const sign = x >= 0 ? 1 : -1;
 91:   x = Math.abs(x);
 92:   const a1 = 0.254829592, a2 = -0.284496736, a3 = 1.421413741;
 93:   const a4 = -1.453152027, a5 = 1.061405429, p = 0.3275911;
 94:   const t = 1 / (1 + p * x);
 95:   const y = 1 - (((((a5 * t + a4) * t) + a3) * t + a2) * t + a1) * t * Math.exp(-x * x);
 96:   return sign * y;
 97: }
 98: 
 99: function normalCDF(x, mu, sigma) {
100:   if (sigma <= 0) return x >= mu ? 1 : 0;
101:   return 0.5 * (1 + erf((x - mu) / (sigma * Math.sqrt(2))));
102: }
103: 
104: function probOverRaw(mu, sigma, line) { return 1 - normalCDF(line, mu, sigma); }
105: function probUnderRaw(mu, sigma, line) { return normalCDF(line, mu, sigma); }
