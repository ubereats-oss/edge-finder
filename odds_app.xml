498:     final event = events.firstWhere((e) {
499:       final competitors =
500:           (e['competitions'] as List).first['competitors'] as List;
501:       final names =
502:           competitors.map((c) => c['team']['displayName'] as String).toList();
503:       return names.any((n) => n.contains(t1)) &&
504:           names.any((n) => n.contains(t2));
505:     }, orElse: () => null);
506:     if (event == null) throw Exception('Jogo não encontrado no ESPN');
507:     final comp = (event['competitions'] as List).first;
508:     final statusType = comp['status']?['type'] as Map<String, dynamic>?;
509:     final completed = statusType?['completed'] as bool? ?? false;
510:     final state = statusType?['state'] as String? ?? 'pre';
511:     final clock = comp['status']?['displayClock'] as String? ?? '';
512:     final period = comp['status']?['period'] as int? ?? 0;
513:     String timeInfo;
514:     if (completed) {
515:       timeInfo = 'Encerrado';
516:     } else if (state == 'in') {
517:       final clockParts = clock.split(':');
518:       final clockSecs = clockParts.length == 2
519:           ? (int.tryParse(clockParts[0]) ?? 0) * 60 +
520:               (int.tryParse(clockParts[1]) ?? 0)
521:           : 0;
522:       final quartersLeft = 4 - period;
523:       final totalSecsLeft = quartersLeft * 12 * 60 + clockSecs;
524:       final totalMins = totalSecsLeft ~/ 60;
525:       final totalSecs = totalSecsLeft % 60;
526:       final totalStr =
527:           '${totalMins.toString().padLeft(2, '0')}:${totalSecs.toString().padLeft(2, '0')}';
528:       timeInfo =
529:           'Q$period — $clock restantes\n$totalStr restantes para o final da partida';
530:     } else {
531:       timeInfo = 'Não iniciado';
532:     }
533:     if (state != 'in' && !completed) {
534:       return {
535:         'state': state,
536:         'timeInfo': timeInfo,
537:         'realValue': null,
538:         'completed': false
539:       };
540:     }
541:     final sumRes = await http.get(Uri.parse(
542:         'https://site.api.espn.com/apis/site/v2/sports/basketball/nba/summary?event=${event['id']}'));
543:     if (sumRes.statusCode != 200) {
544:       throw Exception('Erro ao buscar box score ESPN');
545:     }
546:     final sum = jsonDecode(sumRes.body) as Map<String, dynamic>;
547:     const statMap = {
548:       'points': 'points',
549:       'rebounds': 'rebounds',
550:       'assists': 'assists',
551:       'steals': 'steals',
552:       'threes': 'threePointFieldGoalsMade-threePointFieldGoalsAttempted',
553:     };
554:     final statKey =
555:         statMap[bet['prop'] as String? ?? ''] ?? (bet['prop'] as String? ?? '');
556:     final playerLastName =
557:         (bet['player'] as String? ?? '').split(' ').last.toLowerCase();
558:     double? realValue;
559:     int minutesPlayed = 0;
560:     for (final team in (sum['boxscore']?['players'] as List? ?? [])) {
561:       for (final grp in (team['statistics'] as List? ?? [])) {
562:         final keys = (grp['keys'] as List?)?.cast<String>() ?? [];
563:         final colIdx = keys.indexOf(statKey);
564:         if (colIdx == -1) continue;
565:         for (final athlete in (grp['athletes'] as List? ?? [])) {
566:           final name =
567:               (athlete['athlete']['displayName'] as String).toLowerCase();
568:           if (name.contains(playerLastName)) {
569:             final statStr =
570:                 (athlete['stats'] as List)[colIdx] as String? ?? '0';
571:             realValue = double.tryParse(statStr.split('-').first) ?? 0;
572:             final minIdx = keys.indexOf('minutes');
573:             if (minIdx != -1) {
574:               minutesPlayed = int.tryParse(
575:                       (athlete['stats'] as List)[minIdx] as String? ?? '0') ??
576:                   0;
577:             }
578:           }
579:         }
580:       }
581:     }
582:     return {
583:       'state': state,
584:       'timeInfo': timeInfo,
585:       'realValue': realValue,
586:       'completed': completed,
587:       'minutesPlayed': minutesPlayed,
588:     };
589:   }
590: 
591:   // ── Migração: adiciona uid a apostas antigas ──────────────────────────────
592:   static Future<int> migrateOldBets() async {
593:     final token = await _authToken();
594:     final uid = _uid;
595:     final res = await http.get(
596:       Uri.parse('$_firestoreBase/bets'),
597:       headers: {'Authorization': 'Bearer $token'},
598:     );
599:     if (res.statusCode != 200) {
600:       throw Exception('Erro na migração: ${res.statusCode}');
601:     }
602:     final body = jsonDecode(res.body) as Map<String, dynamic>;
603:     final documents = body['documents'] as List? ?? [];
604:     int count = 0;
605:     for (final doc in documents) {
606:       final fields = doc['fields'] as Map<String, dynamic>? ?? {};
607:       if (!fields.containsKey('uid')) {
608:         final betId = (doc['name'] as String).split('/').last;
609:         await http.patch(
610:           Uri.parse('$_firestoreBase/bets/$betId'),
611:           headers: {
612:             'Content-Type': 'application/json',
613:             'Authorization': 'Bearer $token',
614:           },
615:           body: jsonEncode({
616:             'fields': {...fields, 'uid': {'stringValue': uid}},
617:           }),
618:         );
619:         count++;
620:       }
621:     }
622:     return count;
623:   }
624: 
625:   // ── Acionar workflow GitHub Actions ────────────────────────────────────────
626:   static Future<void> triggerUpdate(String sport) async {
627:     final token =
628:         const String.fromEnvironment('GITHUB_TOKEN', defaultValue: '');
629:     if (token.isEmpty) {
630:       throw Exception('Token GitHub não configurado');
631:     }
632:     final url =
633:         'https://api.github.com/repos/$_githubRepo/actions/workflows/update_model.yml/dispatches';
634:     final res = await http.post(
635:       Uri.parse(url),
636:       headers: {
637:         'Authorization': 'Bearer $token',
638:         'Accept': 'application/vnd.github+json',
639:         'Content-Type': 'application/json',
640:       },
641:       body: jsonEncode({
642:         'ref': 'main',
643:         'inputs': {'sport': sport},
644:       }),
645:     );
646:     if (res.statusCode != 204) {
647:       throw Exception('Erro ao acionar workflow: ${res.statusCode}');
648:     }
649:   }
650: 
651:   // ── Verificar status do workflow ───────────────────────────────────────────
652:   static Future<String> getWorkflowStatus() async {
653:     final token =
654:         const String.fromEnvironment('GITHUB_TOKEN', defaultValue: '');
655:     if (token.isEmpty) {
656:       return 'unknown';
657:     }
658:     final url =
659:         'https://api.github.com/repos/$_githubRepo/actions/workflows/update_model.yml/runs?per_page=1';
660:     final res = await http.get(
661:       Uri.parse(url),
662:       headers: {
663:         'Authorization': 'Bearer $token',
664:         'Accept': 'application/vnd.github+json',
665:       },
666:     );
667:     if (res.statusCode != 200) {
668:       return 'unknown';
669:     }
670:     final body = jsonDecode(res.body) as Map<String, dynamic>;
671:     final runs = body['workflow_runs'] as List? ?? [];
672:     if (runs.isEmpty) {
673:       return 'unknown';
674:     }
675:     return runs.first['status'] as String? ?? 'unknown';
676:   }
677: 
678:   // ── Conversão Map → Firestore ──────────────────────────────────────────────
679:   static Map<String, dynamic> _mapToFirestore(Map<String, dynamic> map) {
680:     final result = <String, dynamic>{};
681:     for (final entry in map.entries) {
682:       result[entry.key] = _valueToFirestore(entry.value);
683:     }
684:     return result;
685:   }
686: 
687:   static Map<String, dynamic> _valueToFirestore(dynamic value) {
688:     if (value == null) {
689:       return {'nullValue': null};
690:     }
691:     if (value is bool) {
692:       return {'booleanValue': value};
693:     }
694:     if (value is int) {
695:       return {'integerValue': value.toString()};
696:     }
697:     if (value is double) {
698:       return {'doubleValue': value};
699:     }
700:     if (value is String) {
701:       return {'stringValue': value};
702:     }
703:     if (value is List) {
704:       return {
705:         'arrayValue': {
706:           'values': value.map(_valueToFirestore).toList(),
707:         }
708:       };
709:     }
710:     if (value is Map<String, dynamic>) {
711:       return {
712:         'mapValue': {
713:           'fields': _mapToFirestore(value),
714:         }
715:       };
716:     }
717:     return {'stringValue': value.toString()};
718:   }
719: 
720:   // ── Legado post() ──────────────────────────────────────────────────────────
721:   static Future<String> post(String path) async {
722:     const sportMap = {
723:       'tennis/update-ranking': 'tennis',
724:       'tennis/update-odds': 'tennis',
725:       'tennis/run-model': 'tennis',
726:       'nba/update-scores': 'nba',
727:       'nba/update-odds': 'nba',
728:       'nba/run-model': 'nba',
729:       'nba/update-props': 'nba',
730:       'nba/run-props-model': 'nba',
731:       'nba/update-props-br': 'nba_br',
732:       'nba/run-props-br-model': 'nba_br',
733:       'mlb/update-scores': 'mlb',
734:       'mlb/update-odds': 'mlb',
735:       'mlb/run-model': 'mlb',
736:       'mlb/update-props': 'mlb',
737:       'mlb/run-props-model': 'mlb',
738:       'nhl/update-props': 'nhl',
739:       'nfl/update-props': 'nfl',
740:       'tennis/update-props': 'tennis_props',
741:     };
742:     final sport = sportMap[path] ?? 'all';
743:     await triggerUpdate(sport);
744:     return 'Workflow iniciado para $sport';
745:   }
746: }
</file>

