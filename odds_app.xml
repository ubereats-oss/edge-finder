 43: async function fetchEvents() {
 44:   const key = getNextValidKey();
 45:   if (!key) throw new Error('Todas as chaves esgotadas.');
 46:   const url = `https://api.the-odds-api.com/v4/sports/basketball_nba/events?apiKey=${key}`;
 47:   const res = await axios.get(url);
 48:   return res.data;
 49: }
 50: 
 51: async function fetchEventProps(eventId) {
 52:   let lastError = null;
 53:   for (let attempt = 0; attempt < API_KEYS.length; attempt++) {
 54:     const key = getNextValidKey();
 55:     if (!key) break;
 56:     try {
 57:       const res = await axios.get(
 58:         `https://api.the-odds-api.com/v4/sports/basketball_nba/events/${eventId}/odds`,
 59:         { params: { apiKey: key, regions: 'us', markets: MARKETS, oddsFormat: 'decimal' } }
 60:       );
 61:       const remaining = res.headers['x-requests-remaining'];
 62:       if (remaining !== undefined) console.log(`    Créditos restantes: ${remaining}`);
 63:       return res.data;
 64:     } catch (e) {
 65:       const msg = e.response?.data?.message || e.message || '';
 66:       if (msg.toLowerCase().includes('quota')) {
 67:         markCurrentKeyExhausted();
 68:         console.warn(`    Chave esgotada (${exhaustedKeys.size}/${API_KEYS.length}), tentando próxima...`);
 69:         await sleep(300);
 70:         lastError = e;
 71:         continue;
 72:       }
 73:       throw e;
 74:     }
 75:   }
 76:   throw lastError || new Error('Todas as chaves esgotadas para este evento.');
 77: }
 78: 
 79: async function getNbaProps() {
 80:   let playerTeam = {};
 81:   if (fs.existsSync('nba_player_team.json')) {
 82:     playerTeam = JSON.parse(fs.readFileSync('nba_player_team.json'));
 83:   } else {
 84:     console.warn('nba_player_team.json não encontrado — location não será preenchido.');
 85:   }
 86: 
 87:   try {
 88:     const events = await fetchEvents();
 89:     if (!events.length) {
 90:       console.log('Sem jogos NBA disponíveis.');
 91:       fs.writeFileSync('nba_props.json', JSON.stringify([], null, 2));
 92:       return;
 93:     }
 94: 
 95:     console.log(`Jogos encontrados: ${events.length}`);
 96:     const allProps = [];
 97: 
 98:     for (const event of events) {
 99:       if (exhaustedKeys.size >= API_KEYS.length) {
100:         console.error('Todas as chaves esgotadas — abortando.');
101:         break;
102:       }
103:       try {
104:         const data = await fetchEventProps(event.id);
105:         const bookmaker = data.bookmakers?.[0];
106:         if (!bookmaker) continue;
107: 
108:         for (const market of bookmaker.markets) {
109:           const propType = {
110:             player_points: 'points',
111:             player_rebounds: 'rebounds',
112:             player_assists: 'assists',
113:             player_steals: 'steals',
114:             player_threes: 'threes',
115:           }[market.key];
116:           if (!propType) continue;
117: 
118:           const players = {};
119:           for (const outcome of market.outcomes) {
120:             const player = outcome.description;
121:             if (!players[player]) players[player] = {};
122:             players[player][outcome.name] = { price: outcome.price, line: outcome.point };
123:           }
124: 
125:           for (const [player, sides] of Object.entries(players)) {
126:             if (!sides.Over || !sides.Under) continue;
127:             const team = playerTeam[player];
128:             let location = 'unknown';
129:             if (team) {
130:               if (team === event.home_team) location = 'home';
131:               else if (team === event.away_team) location = 'away';
132:             }
133:             allProps.push({
134:               game: `${event.home_team} x ${event.away_team}`,
135:               commence_time: event.commence_time,
136:               player,
137:               prop: propType,
138:               location,
139:               line: sides.Over.line,
140:               oddsOver: sides.Over.price,
141:               oddsUnder: sides.Under.price,
142:             });
143:           }
144:         }
145: 
146:         console.log(`  ${event.home_team} x ${event.away_team}: OK`);
147:         await sleep(300);
148:       } catch (e) {
149:         console.error(`  Erro no evento ${event.id}:`, e.response?.data?.message || e.message);
150:       }
151:     }
152: 
153:     fs.writeFileSync('nba_props.json', JSON.stringify(allProps, null, 2));
154:     console.log(`Props salvas: ${allProps.length} entradas.`);
155:   } catch (e) {
156:     console.error('Erro ao buscar props NBA:', e.response?.data || e.message);
157:   }
158: }
159: 
160: getNbaProps();
