116: async function processEvents(allEvents, raw) {
117:   let total = 0;
118: 
119:   for (const event of allEvents) {
120:     const season = event._season;
121:     try {
122:       const teams = await fetchBoxScore(event.id);
123:       total++;
124: 
125:       for (const team of teams) {
126:         const teamName = team.team?.displayName;
127:         if (!teamName) continue;
128:         const isHome = teamName === event.homeTeam;
129:         const location = isHome ? 'home' : 'away';
130:         const opponent = isHome ? event.awayTeam : event.homeTeam;
131:         const won = isHome ? event.homeWon : !event.homeWon;
132:         const teamScore = isHome ? event.homeScore : event.awayScore;
133:         const oppScore = isHome ? event.awayScore : event.homeScore;
134: 
135:         const playerMap = {};
136: 
137:         for (const group of team.statistics || []) {
138:           const labels = (group.labels || []).map(l => l.toUpperCase());
139:           const isPassing   = labels.includes('INT') && labels.includes('YDS') && (labels.includes('C/ATT') || labels.includes('COMP'));
140:           const isRushing   = labels.includes('CAR') && labels.includes('YDS') && !labels.includes('REC');
141:           const isReceiving = labels.includes('REC') && labels.includes('YDS');
142: 
143:           if (!isPassing && !isRushing && !isReceiving) continue;
144: 
145:           const idxYds = labels.indexOf('YDS');
146:           const idxTd  = labels.indexOf('TD');
147:           const idxRec = labels.indexOf('REC');
148:           const idxInt = labels.indexOf('INT');
149: 
150:           for (const athlete of group.athletes || []) {
151:             const name = athlete.athlete?.displayName;
152:             if (!name) continue;
153:             if (!playerMap[name]) playerMap[name] = { passYards: 0, passTDs: 0, ints: 0, rushYards: 0, rushTDs: 0, receptions: 0, receptionYards: 0, receptionTDs: 0 };
154: 
155:             const stats = athlete.stats || [];
156:             const yds = parseFloat(stats[idxYds]) || 0;
157:             const td  = parseInt(stats[idxTd]) || 0;
158:             const rec = parseInt(stats[idxRec]) || 0;
159:             const int = parseInt(stats[idxInt]) || 0;
160: 
161:             if (isPassing) {
162:               playerMap[name].passYards += yds;
163:               playerMap[name].passTDs   += td;
164:               playerMap[name].ints      += int;
165:             } else if (isRushing) {
166:               playerMap[name].rushYards += yds;
167:               playerMap[name].rushTDs   += td;
168:             } else if (isReceiving) {
169:               playerMap[name].receptions     += rec;
170:               playerMap[name].receptionYards += yds;
171:               playerMap[name].receptionTDs   += td;
172:             }
173:           }
174:         }
175: 
176:         for (const [name, s] of Object.entries(playerMap)) {
177:           const hasStats = s.passYards + s.rushYards + s.receptions > 0;
178:           if (!hasStats) continue;
179: 
180:           const ctx = ensurePath(raw, name, season, event.seasonType, location);
181:           const alreadyExists = ctx.fantasyPoints.some(e => e.date === event.date && e.opponent === opponent);
182:           if (alreadyExists) continue;
183: 
184:           ctx.games++;
185:           const fantasy = parseFloat(calcFantasy(s.passYards, s.passTDs, s.ints, s.rushYards, s.rushTDs, s.receptions, s.receptionYards, s.receptionTDs).toFixed(1));
186: 
187:           const meta = {
188:             date: event.date,
189:             blowout: event.blowout,
190:             won,
191:             teamScore,
192:             oppScore,
193:             opponent,
194:             _team: teamName,
195:             _eventDate: event.date,
196:           };
197:           const mkEntry = v => ({ ...meta, value: v });
198: 
199:           ctx.passYards.push(mkEntry(s.passYards));
200:           ctx.passTDs.push(mkEntry(s.passTDs));
201:           ctx.rushYards.push(mkEntry(s.rushYards));
202:           ctx.receptions.push(mkEntry(s.receptions));
203:           ctx.receptionYards.push(mkEntry(s.receptionYards));
204:           ctx.fantasyPoints.push(mkEntry(fantasy));
205:         }
206:       }
207:     } catch {
208:       // box score indisponível
209:     }
210:     await sleep(120);
211:   }
212: 
213:   return total;
214: }
