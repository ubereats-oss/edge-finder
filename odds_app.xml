 2: 
 3: class LastUpdatedBar extends StatelessWidget {
 4:   final DateTime? lastUpdated;
 5: 
 6:   const LastUpdatedBar({super.key, this.lastUpdated});
 7: 
 8:   String _formatAge() {
 9:     if (lastUpdated == null) return 'Nunca atualizado';
10:     final diff = DateTime.now().difference(lastUpdated!);
11:     if (diff.inMinutes < 1) return 'Atualizado agora';
12:     if (diff.inMinutes < 60) return 'Atualizado há ${diff.inMinutes} min';
13:     if (diff.inHours < 24) return 'Atualizado há ${diff.inHours}h';
14:     return 'Atualizado há ${diff.inDays} dia(s)';
15:   }
16: 
17:   @override
18:   Widget build(BuildContext context) {
19:     return Container(
20:       width: double.infinity,
21:       color: const Color(0xFF12121F),
22:       padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 6),
23:       child: Row(
24:         children: [
25:           Icon(
26:             Icons.access_time,
27:             size: 12,
28:             color: lastUpdated == null
29:                 ? const Color(0xFF555555)
30:                 : const Color(0xFF888888),
31:           ),
32:           const SizedBox(width: 4),
33:           Text(
34:             _formatAge(),
35:             style: TextStyle(
36:               color: lastUpdated == null
37:                   ? const Color(0xFF555555)
38:                   : const Color(0xFF888888),
