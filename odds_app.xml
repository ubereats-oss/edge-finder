  1: const fs = require('fs');
  2: 
  3: // ── Configuração ────────────────────────────────────────────────────────────────
  4: const KELLY_FRACTION  = 0.25;
  5: const HOUSE_MARGIN    = 0.05;
  6: const MIN_GAMES_MKT   = 10;
  7: const MIN_GAMES_MODEL = 5;
  8: const BANKROLL_START  = 1000;
  9: const FLAT_STAKE_CAP  = BANKROLL_START * 0.05;
 10: const DECAY           = 0.98;
 11: 
 12: const BATTER_KEYS  = ['hits', 'homeRuns'];
 13: const PITCHER_KEYS = ['strikeouts', 'hitsAllowed'];
 14: const ALL_STAT_KEYS = [...BATTER_KEYS, ...PITCHER_KEYS];
 15: 
 16: // Aliases para campos que podem ter nomes alternativos no JSON
 17: // (ex: strikeouts salvo como 'k' ou 'so' em versões antigas do pipeline)
 18: const STAT_FIELD_ALIASES = {
 19:   strikeouts: ['strikeouts', 'k', 'so', 'strikeoutsThrown'],
 20: };
 21: 
 22: // Temporadas: base = 2023+2024, walk-forward = 2025+2026
 23: const BASE_SEASONS = [2023, 2024];
 24: const WALK_SEASONS = [2025, 2026];
 25: 
 26: // ── Utilitários ─────────────────────────────────────────────────────────────────
 27: function erf(x) {
 28:   const sign = x >= 0 ? 1 : -1;
 29:   x = Math.abs(x);
 30:   const a1 = 0.254829592, a2 = -0.284496736, a3 = 1.421413741;
 31:   const a4 = -1.453152027, a5 = 1.061405429, p = 0.3275911;
 32:   const t = 1 / (1 + p * x);
 33:   const y = 1 - (((((a5 * t + a4) * t) + a3) * t + a2) * t + a1) * t * Math.exp(-x * x);
 34:   return sign * y;
 35: }
 36: 
 37: function normalCDF(x, mu, sigma) {
 38:   if (sigma <= 0) return x >= mu ? 1 : 0;
 39:   return 0.5 * (1 + erf((x - mu) / (sigma * Math.sqrt(2))));
 40: }
 41: 
 42: function probOver(mu, sigma, line)  { return 1 - normalCDF(line, mu, sigma); }
 43: function probUnder(mu, sigma, line) { return normalCDF(line, mu, sigma); }
 44: 
 45: function marketOdd(p) {
 46:   if (p <= 0.01) return null;
 47:   return 1 / (p * (1 + HOUSE_MARGIN));
 48: }
 49: 
 50: function calcKelly(prob, odds) {
 51:   const b = odds - 1;
 52:   const q = 1 - prob;
 53:   const k = (prob * b - q) / b;
 54:   return Math.max(0, k * KELLY_FRACTION);
 55: }
 56: 
 57: function calcAvgStd(values) {
 58:   if (!values || values.length === 0) return null;
 59:   const avg = values.reduce((s, v) => s + v, 0) / values.length;
 60:   const variance = values.reduce((s, v) => s + Math.pow(v - avg, 2), 0) / values.length;
 61:   return { avg, std: Math.sqrt(variance), count: values.length };
 62: }
 63: 
 64: function calcWeightedAvgStd(values) {
 65:   if (!values || values.length === 0) return null;
 66:   let wSum = 0, wSumSq = 0, totalW = 0;
 67:   const n = values.length;
 68:   for (let i = 0; i < n; i++) {
 69:     const w = Math.pow(DECAY, n - 1 - i);
 70:     wSum   += values[i] * w;
 71:     wSumSq += values[i] * values[i] * w;
 72:     totalW += w;
 73:   }
 74:   const avg = wSum / totalW;
 75:   const variance = Math.max(0, wSumSq / totalW - avg * avg);
 76:   return { avg, std: Math.sqrt(variance), count: n };
 77: }
 78: 
 79: // ── Isotônica PAVA ──────────────────────────────────────────────────────────────
 80: function isotonicRegression(pairs) {
 81:   // pairs: [{x, y}] ordenados por x, y in [0,1]
 82:   // Retorna [{x, y_iso}] com regressão isotônica crescente
 83:   const n = pairs.length;
 84:   if (n === 0) return [];
 85:   const g = pairs.map(p => ({ sum: p.y, count: 1, x: p.x }));
 86:   let i = 0;
 87:   while (i < g.length - 1) {
 88:     if (g[i].sum / g[i].count > g[i + 1].sum / g[i + 1].count) {
 89:       g[i].sum += g[i + 1].sum;
 90:       g[i].count += g[i + 1].count;
 91:       g.splice(i + 1, 1);
 92:       if (i > 0) i--;
 93:     } else {
 94:       i++;
 95:     }
 96:   }
 97:   const result = [];
 98:   for (const group of g) {
 99:     const val = group.sum / group.count;
100:     result.push({ x: group.x, y: val });
101:   }
102:   return result;
103: }
104: 
105: function buildCalibTable(predictions) {
106:   // Agrupa por faixas de 5pp e aplica isotônica
107:   const buckets = {};
108:   for (const p of predictions) {
109:     const prob = p.prob / 100;
110:     // Espelha abaixo de 0.5
111:     const normProb = prob >= 0.5 ? prob : 1 - prob;
112:     const normOutcome = prob >= 0.5 ? (p.won ? 1 : 0) : (p.won ? 0 : 1);
113:     const key = Math.round(normProb * 20) / 20; // arredonda para 0.05
114:     if (!buckets[key]) buckets[key] = { sum: 0, count: 0 };
115:     buckets[key].sum += normOutcome;
116:     buckets[key].count++;
117:   }
118: 
119:   const pairs = Object.entries(buckets)
120:     .filter(([, b]) => b.count >= 10)
121:     .map(([k, b]) => ({ x: parseFloat(k), y: b.sum / b.count }))
122:     .sort((a, b) => a.x - b.x);
123: 
124:   return isotonicRegression(pairs);
125: }
126: 
127: function calibrateWithTable(p, table) {
128:   if (table.length === 0) return p;
129:   const mirrored = p >= 0.5;
130:   const normP = mirrored ? p : 1 - p;
131: 
132:   if (normP <= table[0].x) {
133:     const cal = table[0].y;
134:     return mirrored ? cal : 1 - cal;
135:   }
136:   if (normP >= table[table.length - 1].x) {
137:     const cal = table[table.length - 1].y;
138:     return mirrored ? cal : 1 - cal;
139:   }
140:   for (let i = 0; i < table.length - 1; i++) {
141:     if (normP >= table[i].x && normP <= table[i + 1].x) {
142:       const t = (normP - table[i].x) / (table[i + 1].x - table[i].x);
143:       const cal = table[i].y + t * (table[i + 1].y - table[i].y);
144:       return mirrored ? cal : 1 - cal;
145:     }
146:   }
147:   return p;
148: }
149: 
150: // ── Extrai todas as entradas de mlb_player_stats.json ──────────────────────────
151: // Retorna array de { playerName, stat, season, location, value, date, opponent, blowout, isExtraInnings, absentStarters }
152: function extractEntries(playerStats) {
153:   const entries = [];
154:   const soNonZero = new Set();
155: 
156:   for (const [playerName, playerData] of Object.entries(playerStats)) {
157:     for (const [seasonStr, seasonData] of Object.entries(playerData)) {
158:       const season = parseInt(seasonStr);
159:       for (const gameType of ['regular', 'playoffs']) {
160:         for (const loc of ['home', 'away']) {
161:           const ctx = seasonData[gameType]?.[loc];
162:           if (!ctx) continue;
163:           for (const stat of ALL_STAT_KEYS) {
164:             // Normaliza nome do campo: tenta aliases em ordem de prioridade
165:             const aliases = STAT_FIELD_ALIASES[stat] || [stat];
166:             const arr = aliases.reduce((found, alias) => found || ctx[alias], null) || [];
167: 
168:             for (const entry of arr) {
169:               if (typeof entry !== 'object' || entry === null) continue;
170:               if (stat === 'strikeouts' && entry.value > 0 && BASE_SEASONS.includes(season)) {
171:                 soNonZero.add(playerName);
172:               }
173:               entries.push({
174:                 playerName,
175:                 stat,
176:                 season,
177:                 location: loc,
178:                 value: entry.value,
179:                 date: entry.date || '',
180:                 opponent: entry.opponent || '',
181:                 blowout: entry.blowout || false,
182:                 isExtraInnings: entry.isExtraInnings || false,
183:                 absentStarters: entry.absentStarters || [],
184:               });
185:             }
186:           }
187:         }
188:       }
189:     }
190:   }
191: 
192:   if (soNonZero.size === 0) {
193:     console.warn('[AVISO] strikeouts: nenhum pitcher com valor > 0 nas temporadas base — label ESPN provavelmente "K", não "SO". Verifique get_mlb_player_stats.js.');
194:   } else {
195:     console.log(`[INFO] strikeouts base: ${soNonZero.size} pitchers com >= 1 jogo com K > 0`);
196:   }
197: 
198:   return entries.sort((a, b) => a.date.localeCompare(b.date));
199: }
200: 
201: function filterByAbsentContext(entries, absentToday) {
202:   if (!absentToday || absentToday.length === 0) return null;
203:   const filtered = entries.filter(e =>
204:     e.absentStarters && absentToday.some(absent =>
205:       e.absentStarters.some(h =>
206:         h.toLowerCase().includes(absent.toLowerCase()) ||
207:         absent.toLowerCase().includes(h.toLowerCase())
208:       )
209:     )
210:   );
211:   return filtered.length >= MIN_GAMES_MODEL ? filtered.map(e => e.value) : null;
212: }
213: 
214: // ── Main ────────────────────────────────────────────────────────────────────────
215: function main() {
216:   if (!fs.existsSync('mlb_player_stats.json')) {
217:     console.error('ERRO: mlb_player_stats.json não encontrado.');
218:     process.exit(1);
219:   }
220: 
221:   const playerStats = JSON.parse(fs.readFileSync('mlb_player_stats.json'));
222:   console.log(`Jogadores carregados: ${Object.keys(playerStats).length}`);
223: 
224:   const allEntries = extractEntries(playerStats);
225:   console.log(`Entradas totais: ${allEntries.length}`);
226: 
227:   const baseEntries = allEntries.filter(e => BASE_SEASONS.includes(e.season));
228:   const walkEntries = allEntries.filter(e => WALK_SEASONS.includes(e.season));
229: 
230:   console.log(`Base (${BASE_SEASONS.join('+')}): ${baseEntries.length} entradas`);
231:   console.log(`Walk-forward (${WALK_SEASONS.join('+')}): ${walkEntries.length} entradas\n`);
232: 
233:   // ── Perfil de mercado (base) ─────────────────────────────────────────────────
234:   console.log('Construindo perfil de mercado...');
235:   const marketRaw = {};
236:   for (const e of baseEntries) {
237:     if (e.blowout || e.isExtraInnings) continue;
238:     const key = e.playerName;
239:     if (!marketRaw[key]) marketRaw[key] = {};
240:     for (const loc of [e.location, 'all']) {
241:       if (!marketRaw[key][loc]) marketRaw[key][loc] = {};
242:       if (!marketRaw[key][loc][e.stat]) marketRaw[key][loc][e.stat] = [];
243:       marketRaw[key][loc][e.stat].push({ value: e.value, absentStarters: e.absentStarters });
244:     }
245:   }
246: 
247:   const marketProfiles = {};
248:   for (const [name, locs] of Object.entries(marketRaw)) {
249:     marketProfiles[name] = {};
250:     for (const [loc, stats] of Object.entries(locs)) {
251:       marketProfiles[name][loc] = {};
252:       for (const [stat, entries] of Object.entries(stats)) {
253:         const values = entries.map(e => e.value);
254:         const s = calcAvgStd(values);
255:         if (s && s.count >= (loc === 'all' ? MIN_GAMES_MKT : 3)) {
256:           marketProfiles[name][loc][stat] = s;
257:         }
258:       }
259:     }
260:   }
261:   console.log(`Perfil de mercado: ${Object.keys(marketProfiles).length} jogadores\n`);
262: 
263:   // ── Walk-forward (primeira passagem — sem calibração) ────────────────────────
264:   console.log('Gerando predições walk-forward (passagem 1)...');
265: 
266:   // Índice walk: playerName -> stat -> location -> [entries em ordem de data]
267:   const modelRaw = {};
268:   const predictions = [];
269:   let skipped = 0, filtroBlowout = 0, filtroExtra = 0, filtroAusentes = 0;
270: 
271:   // Agrupa walkEntries por data+jogador para processar jogo a jogo
272:   const byDatePlayer = {};
273:   for (const e of walkEntries) {
274:     const key = `${e.date}|${e.playerName}`;
275:     if (!byDatePlayer[key]) byDatePlayer[key] = [];
276:     byDatePlayer[key].push(e);
277:   }
278: 
279:   const orderedKeys = Object.keys(byDatePlayer).sort();
280: 
281:   for (const dpKey of orderedKeys) {
282:     const gameEntries = byDatePlayer[dpKey];
283:     const { playerName, date, location, opponent, blowout, isExtraInnings } = gameEntries[0];
284: 
285:     for (const e of gameEntries) {
286:       const { stat, value, absentStarters } = e;
287: 
288:       if (e.blowout)          { filtroBlowout++; continue; }
289:       if (e.isExtraInnings)   { filtroExtra++;   continue; }
290: 
291:       // Perfil de mercado
292:       const mktProfile =
293:         marketProfiles[playerName]?.[location]?.[stat]?.count >= MIN_GAMES_MKT
294:           ? marketProfiles[playerName][location][stat]
295:           : marketProfiles[playerName]?.['all']?.[stat]?.count >= MIN_GAMES_MKT
296:           ? marketProfiles[playerName]['all'][stat]
297:           : null;
298: 
299:       const minStd = BATTER_KEYS.includes(stat) ? 0.3 : 0.5;
300:       if (!mktProfile || mktProfile.std < minStd) { skipped++; continue; }
301: 
302:       const rawLine = mktProfile.avg;
303:       const line = Math.floor(rawLine) + 0.5;
304:       if (line < 0) { skipped++; continue; }
305: 
306:       const mktPOver  = probOver(mktProfile.avg, mktProfile.std, line);
307:       const mktPUnder = probUnder(mktProfile.avg, mktProfile.std, line);
308:       if (mktPOver <= 0 || mktPUnder <= 0) { skipped++; continue; }
309: 
310:       const mktOddOver  = marketOdd(mktPOver);
311:       const mktOddUnder = marketOdd(mktPUnder);
312:       if (!mktOddOver || !mktOddUnder || !isFinite(mktOddOver) || !isFinite(mktOddUnder)) { skipped++; continue; }
313: 
314:       // Modelo walk-forward
315:       const modelEntries =
316:         modelRaw[playerName]?.[location]?.[stat] ||
317:         modelRaw[playerName]?.['all']?.[stat] ||
318:         null;
319: 
320:       let modelValues = null;
321:       let usedAbsentFilter = false;
322: 
323:       if (modelEntries && modelEntries.length >= MIN_GAMES_MODEL) {
324:         const filtered = filterByAbsentContext(modelEntries, absentStarters);
325:         if (filtered && filtered.length >= MIN_GAMES_MODEL) {
326:           modelValues = filtered;
327:           usedAbsentFilter = true;
328:           filtroAusentes++;
329:         } else {
330:           modelValues = modelEntries
331:             .filter(e => !e._blowout && !e._extra)
332:             .map(e => e.value);
333:           if (modelValues.length < MIN_GAMES_MODEL) modelValues = modelEntries.map(e => e.value);
334:         }
335:       }
336: 
337:       let modelProfile = null;
338:       if (modelValues && modelValues.length >= MIN_GAMES_MODEL) {
339:         modelProfile = calcWeightedAvgStd(modelValues);
340:       } else if (mktProfile) {
341:         modelProfile = mktProfile;
342:       }
343: 
344:       if (!modelProfile) { skipped++; continue; }
345: 
346:       const pOverRaw  = probOver(modelProfile.avg, modelProfile.std, line);
347:       const pUnderRaw = probUnder(modelProfile.avg, modelProfile.std, line);
348: 
349:       // Passagem 1: sem calibração (será aplicada na passagem 2)
350:       const pOver  = pOverRaw;
351:       const pUnder = pUnderRaw;
352: 
353:       const edgeOver  = pOver  - mktPOver;
354:       const edgeUnder = pUnder - mktPUnder;
355: 
356:       const bestSide = edgeOver >= edgeUnder ? 'Over' : 'Under';
357:       const bestProb = edgeOver >= edgeUnder ? pOver  : pUnder;
358:       const bestOdd  = edgeOver >= edgeUnder ? mktOddOver : mktOddUnder;
359:       const bestEdge = edgeOver >= edgeUnder ? edgeOver : edgeUnder;
360: 
361:       const kelly = calcKelly(bestProb, bestOdd);
362:       if (kelly <= 0) { skipped++; continue; }
363: 
364:       const won = bestSide === 'Over' ? value > line : value < line;
365: 
366:       predictions.push({
367:         date,
368:         player: playerName,
369:         stat,
370:         location,
371:         opponent,
372:         side: bestSide,
373:         line,
374:         actual: value,
375:         prob: parseFloat((bestProb * 100).toFixed(1)),
376:         edge: parseFloat((bestEdge * 100).toFixed(2)),
377:         mktOdd: parseFloat(bestOdd.toFixed(3)),
378:         kellyFrac: parseFloat((kelly * 100).toFixed(2)),
379:         modelAvg: parseFloat(modelProfile.avg.toFixed(3)),
380:         usedAbsentFilter,
381:         won,
382:         modelGames: modelValues?.length || 0,
383:       });
384:     }
385: 
386:     // Atualiza modelRaw APÓS predição (walk-forward correto)
387:     for (const e of gameEntries) {
388:       const { stat, value, absentStarters } = e;
389:       if (!modelRaw[playerName]) modelRaw[playerName] = {};
390:       const entry = {
391:         value,
392:         absentStarters,
393:         _blowout: e.blowout,
394:         _extra: e.isExtraInnings,
395:       };
396:       for (const loc of [location, 'all']) {
397:         if (!modelRaw[playerName][loc]) modelRaw[playerName][loc] = {};
398:         if (!modelRaw[playerName][loc][stat]) modelRaw[playerName][loc][stat] = [];
399:         modelRaw[playerName][loc][stat].push(entry);
400:       }
401:     }
402:   }
403: 
404:   console.log(`Props geradas: ${predictions.length} | Puladas: ${skipped}`);
405:   console.log(`Filtros — Blowout: ${filtroBlowout} | Extra innings: ${filtroExtra} | Ausentes: ${filtroAusentes}\n`);
406: 
407:   // ── Calibração isotônica própria ─────────────────────────────────────────────
408:   console.log('Calculando calibração isotônica...');
409:   const calibTable = buildCalibTable(predictions);
410: 
411:   console.log('Tabela de calibração gerada:');
412:   console.log('  raw   → cal');
413:   for (const row of calibTable) {
414:     console.log(`  ${row.x.toFixed(3)} → ${row.y.toFixed(3)}`);
415:   }
416:   console.log('');
417: 
418:   // ── Aplica calibração e recalcula métricas ───────────────────────────────────
419:   for (const p of predictions) {
420:     const rawProb = p.prob / 100;
421:     p.probCal = parseFloat((calibrateWithTable(rawProb, calibTable) * 100).toFixed(1));
422:   }
423: 
424:   // ── Calibração e Brier Score ─────────────────────────────────────────────────
425:   const buckets = {};
426:   for (let i = 0; i <= 9; i++) {
427:     buckets[(0.5 + i * 0.05).toFixed(2)] = { predicted: 0, actual: 0, n: 0 };
428:   }
429: 
430:   let brierRaw = 0, brierCal = 0, correct = 0;
431:   for (const p of predictions) {
432:     const probRaw = p.prob / 100;
433:     const probCal = p.probCal / 100;
434:     const outcome = p.won ? 1 : 0;
435:     brierRaw += Math.pow(probRaw - outcome, 2);
436:     brierCal += Math.pow(probCal - outcome, 2);
437:     if (p.won) correct++;
438:     const key = (Math.floor(probCal / 0.05) * 0.05).toFixed(2);
439:     if (buckets[key]) {
440:       buckets[key].predicted += probCal;
441:       buckets[key].actual    += outcome;
442:       buckets[key].n++;
443:     }
444:   }
445: 
446:   const accuracy     = correct / predictions.length;
447:   const brierScoreRaw = brierRaw / predictions.length;
448:   const brierScoreCal = brierCal / predictions.length;
449: 
450:   // ── ROI ───────────────────────────────────────────────────────────────────────
451:   const bestByMarket = {};
452:   for (const p of predictions) {
453:     const key = `${p.date}|${p.player}|${p.stat}`;
454:     if (!bestByMarket[key] || Math.abs(p.edge) > Math.abs(bestByMarket[key].edge)) {
