 11: class BetPlannerScreen extends StatefulWidget {
 12:   final List<Map<String, dynamic>> props;
 13:   const BetPlannerScreen({super.key, required this.props});
 14: 
 15:   @override
 16:   State<BetPlannerScreen> createState() => _BetPlannerScreenState();
 17: }
 18: 
 19: class _BetPlannerScreenState extends State<BetPlannerScreen>
 20:     with SingleTickerProviderStateMixin {
 21:   late TabController _tab;
 22:   final _stakeCtrl = TextEditingController();
 23:   final _profitCtrl = TextEditingController();
 24:   final _guaranteedProfitCtrl = TextEditingController();
 25:   int _maxLosses = 1;
 26: 
 27:   @override
 28:   void initState() {
 29:     super.initState();
 30:     _tab = TabController(length: 3, vsync: this);
 31:   }
 32: 
 33:   @override
 34:   void dispose() {
 35:     _tab.dispose();
 36:     _stakeCtrl.dispose();
 37:     _profitCtrl.dispose();
 38:     _guaranteedProfitCtrl.dispose();
 39:     super.dispose();
 40:   }
 41: 
 42:   // Kelly normalizado; fallback para peso igual
 43:   List<double> get _weights {
 44:     final kellys = widget.props
 45:         .map((p) => ((p['kelly'] as num?)?.toDouble() ?? 0).clamp(0.0, 100.0))
 46:         .toList();
 47:     final total = kellys.fold(0.0, (a, b) => a + b);
 48:     if (total <= 0) {
 49:       final eq = 1.0 / widget.props.length;
 50:       return List.filled(widget.props.length, eq);
 51:     }
 52:     return kellys.map((k) => k / total).toList();
 53:   }
 54: 
 55:   // ev = stake × (prob × odds - 1)
 56:   double _expectedProfit(List<double> bets) {
 57:     double total = 0;
 58:     for (int i = 0; i < bets.length; i++) {
 59:       final odds = (widget.props[i]['odds'] as num?)?.toDouble() ?? 1.91;
 60:       total += bets[i] * (EdgeEvaluatorService.calibratedProb(widget.props[i]) * odds - 1);
 61:     }
 62:     return total;
 63:   }
 64: 
 65:   // Solução LP exata: stake[i] = C / odds[i]  (Dutch book é o ótimo do LP).
 66:   // Prova: complementary slackness mostra que para todo |S|=K,
 67:   //   profit(S) = C * [(n-K) - Σ(1/odds[i])]  = targetProfit (constante).
 68:   // Portanto qualquer subconjunto com |S|≤K satisfaz profit(S)≥targetProfit.
 69:   List<double> _computeGuaranteedStakesLP({
 70:     required double targetProfit,
 71:     required int maxLosses,
 72:   }) {
 73:     final props = widget.props;
 74:     final n = props.length;
 75: 
 76:     if (n == 0) throw Exception('Nenhuma aposta disponível.');
 77:     if (maxLosses >= n) throw Exception('Perdas toleradas ($maxLosses) deve ser menor que o nº de apostas ($n).');
 78:     if (targetProfit <= 0) throw Exception('Lucro alvo deve ser positivo.');
 79: 
 80:     // Sanitiza odds: mínimo 1.01
 81:     final odds = props
 82:         .map((p) => ((p['odds'] as num?)?.toDouble() ?? 1.91).clamp(1.01, 100.0))
 83:         .toList();
 84: 
 85:     // Denominador = (n - K) - Σ(1/odds[i])
 86:     final sumInv = odds.fold(0.0, (s, o) => s + 1.0 / o);
 87:     final denom = (n - maxLosses) - sumInv;
 88: 
 89:     if (denom <= 1e-9) {
 90:       throw Exception(
 91:         'Problema infeasível: com $maxLosses perdas e estas odds não é possível garantir lucro positivo.');
 92:     }
 93: 
 94:     // Solução fechada
 95:     final C = targetProfit / denom;
 96:     final stakes = odds.map((o) => C / o).toList();
 97: 
 98:     // Validação combinatória completa de TODOS os subconjuntos |S| ≤ maxLosses
 99:     final violations = <String>[];
100:     _enumSubsets(n, maxLosses, (loseSet) {
101:       double profit = 0;
102:       for (int i = 0; i < n; i++) {
103:         profit += loseSet.contains(i) ? -stakes[i] : stakes[i] * (odds[i] - 1);
104:       }
105:       if (profit < targetProfit - 1e-6) {
106:         violations.add('S=$loseSet → lucro=${profit.toStringAsFixed(4)}');
107:       }
108:     });
109: 
110:     if (violations.isNotEmpty) {
111:       throw Exception('Validação falhou:\n${violations.join('\n')}');
112:     }
113: 
114:     return stakes;
115:   }
116: 
117:   // Enumera todos subconjuntos de tamanho 0..k de {0..n-1}
118:   static void _enumSubsets(int n, int k, void Function(List<int>) callback) {
119:     void gen(int start, int remaining, List<int> current) {
120:       callback(List.unmodifiable(current));
121:       if (remaining == 0) return;
122:       for (int i = start; i < n; i++) {
123:         current.add(i);
124:         gen(i + 1, remaining - 1, current);
125:         current.removeLast();
126:       }
127:     }
128:     gen(0, k, []);
129:   }
130: 
131:   List<double> _distributeStake(double total) {
132:     final w = _weights;
133:     return w.map((f) => f * total).toList();
134:   }
135: 
136:   // P = Total × Σ[ w_i × (prob_i × odds_i - 1) ]  →  Total = P / rate
137:   double _totalForProfit(double targetProfit) {
138:     final w = _weights;
139:     double rate = 0;
140:     for (int i = 0; i < widget.props.length; i++) {
141:       final odds = (widget.props[i]['odds'] as num?)?.toDouble() ?? 1.91;
142:       rate += w[i] * (EdgeEvaluatorService.calibratedProb(widget.props[i]) * odds - 1);
143:     }
144:     if (rate <= 0) return 0;
145:     return targetProfit / rate;
146:   }
