  1: const axios = require('axios');
  2: const fs = require('fs');
  3: 
  4: const TOURS = ['atp', 'wta'];
  5: 
  6: function sleep(ms) {
  7:   return new Promise(resolve => setTimeout(resolve, ms));
  8: }
  9: 
 10: function getLastProcessedDate(existing) {
 11:   let latest = null;
 12:   for (const playerData of Object.values(existing)) {
 13:     for (const surfaceData of Object.values(playerData)) {
 14:       for (const entries of Object.values(surfaceData)) {
 15:         if (!Array.isArray(entries)) continue;
 16:         for (const entry of entries) {
 17:           if (entry.date && (!latest || entry.date > latest)) latest = entry.date;
 18:         }
 19:       }
 20:     }
 21:   }
 22:   return latest;
 23: }
 24: 
 25: function detectSurface(event) {
 26:   const venue = (event.competitions?.[0]?.venue?.description || '').toLowerCase();
 27:   const name  = (event.name || '').toLowerCase();
 28:   const combined = venue + ' ' + name;
 29:   if (combined.includes('clay') || combined.includes('terre') || combined.includes('roland') || combined.includes('monte-carlo') || combined.includes('madrid') || combined.includes('rome')) return 'clay';
 30:   if (combined.includes('grass') || combined.includes('wimbledon') || combined.includes('halle') || combined.includes("queen's")) return 'grass';
 31:   if (combined.includes('indoor') || combined.includes('carpet') || combined.includes('hard indoor')) return 'hard_indoor';
 32:   return 'hard';
 33: }
 34: 
 35: function ensurePath(raw, player, surface, statKey) {
 36:   if (!raw[player]) raw[player] = {};
 37:   if (!raw[player][surface]) raw[player][surface] = { sets: [], games: [] };
 38:   return raw[player][surface];
 39: }
 40: 
 41: async function processScoreboard(tour, startDate, endDate, raw) {
 42:   const url = `https://site.api.espn.com/apis/site/v2/sports/tennis/${tour}/scoreboard?limit=200&dates=${startDate}-${endDate}`;
 43:   let res;
 44:   try {
 45:     res = await axios.get(url);
 46:   } catch (e) {
 47:     console.error(`Erro scoreboard ${tour} ${startDate}:`, e.message);
 48:     return;
 49:   }
 50: 
 51:   for (const event of (res.data.events || [])) {
 52:     const surface = detectSurface(event);
 53: 
 54:     // Partidas ficam em event.groupings[].competitions[], não em event.competitions[]
 55:     for (const grouping of (event.groupings || [])) {
 56:       for (const comp of (grouping.competitions || [])) {
 57:         if (!comp.status?.type?.completed) continue;
 58: 
 59:         const competitors = comp.competitors || [];
 60:         if (competitors.length < 2) continue;
 61: 
 62:         const c1 = competitors[0];
 63:         const c2 = competitors[1];
 64:         const p1 = c1?.athlete?.displayName;
 65:         const p2 = c2?.athlete?.displayName;
 66:         if (!p1 || !p2) continue;
 67: 
 68:         // Linescores são por-competidor: cada entrada = um set jogado
 69:         const ls1 = c1.linescores || [];
 70:         const ls2 = c2.linescores || [];
 71: 
 72:         const p1Sets  = ls1.filter(ls => ls.winner).length;
 73:         const p2Sets  = ls2.filter(ls => ls.winner).length;
 74:         const p1Games = ls1.reduce((s, ls) => s + (parseInt(ls.value) || 0), 0);
 75:         const p2Games = ls2.reduce((s, ls) => s + (parseInt(ls.value) || 0), 0);
 76: 
 77:         const date = comp.date || event.date || new Date().toISOString();
 78: 
 79:         const alreadyP1 = (raw[p1]?.[surface]?.sets || []).some(e => e.date === date && e.opponent === p2);
 80:         if (!alreadyP1) {
 81:           const ctx1 = ensurePath(raw, p1, surface);
 82:           ctx1.sets.push({ value: p1Sets, date, opponent: p2 });
 83:           ctx1.games.push({ value: p1Games, date, opponent: p2 });
 84:         }
 85: 
 86:         const alreadyP2 = (raw[p2]?.[surface]?.sets || []).some(e => e.date === date && e.opponent === p1);
 87:         if (!alreadyP2) {
 88:           const ctx2 = ensurePath(raw, p2, surface);
 89:           ctx2.sets.push({ value: p2Sets, date, opponent: p1 });
 90:           ctx2.games.push({ value: p2Games, date, opponent: p1 });
 91:         }
 92:       }
 93:     }
 94:   }
 95: }
 96: 
 97: async function getPlayerStats() {
 98:   let existing = {};
 99:   if (fs.existsSync('tennis_player_stats.json')) {
100:     try {
101:       existing = JSON.parse(fs.readFileSync('tennis_player_stats.json', 'utf-8'));
102:       console.log(`Stats tênis existentes: ${Object.keys(existing).length} jogadores.`);
103:     } catch {
104:       console.warn('tennis_player_stats.json inválido — iniciando do zero.');
105:     }
106:   }
107: 
108:   const lastDate = getLastProcessedDate(existing);
109:   let startDate, endDate;
110: 
111:   if (lastDate) {
112:     const d = new Date(lastDate);
113:     d.setDate(d.getDate() - 3);
114:     startDate = d.toISOString().slice(0, 10).replace(/-/g, '');
115:   } else {
116:     // 3 meses de histórico
117:     const d = new Date();
118:     d.setMonth(d.getMonth() - 3);
119:     startDate = d.toISOString().slice(0, 10).replace(/-/g, '');
120:   }
121:   endDate = new Date().toISOString().slice(0, 10).replace(/-/g, '');
122: 
123:   console.log(`Buscando tênis ${startDate} → ${endDate}`);
124: 
125:   for (const tour of TOURS) {
126:     console.log(`Processando ${tour.toUpperCase()}...`);
127:     await processScoreboard(tour, startDate, endDate, existing);
128:     await sleep(500);
129:   }
130: 
131:   const filtered = {};
132:   for (const [name, surfaces] of Object.entries(existing)) {
133:     let total = 0;
134:     for (const surf of Object.values(surfaces)) total += (surf.sets?.length || 0);
135:     if (total >= 5) filtered[name] = surfaces;
136:   }
137: 
138:   fs.writeFileSync('tennis_player_stats.json', JSON.stringify(filtered, null, 2));
139:   console.log(`Stats tênis salvos: ${Object.keys(filtered).length} jogadores.`);
140: }
141: 
142: getPlayerStats();
</file>

