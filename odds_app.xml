110: function calcFantasy(pYds, pTds, ints, ruYds, ruTds, recs, reYds, reTds) {
111:   return pYds / 25 + pTds * 4 - ints * 2 +
112:     ruYds / 10 + ruTds * 6 +
113:     recs * 0.5 + reYds / 10 + reTds * 6;
114: }
