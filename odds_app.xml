 79:   static dynamic _firestoreValue(Map<String, dynamic> value) {
 80:     if (value.containsKey('stringValue')) {
 81:       final s = value['stringValue'] as String;
 82:       final n = double.tryParse(s);
 83:       if (n != null) return n;
 84:       return s;
 85:     }
 86:     if (value.containsKey('integerValue')) {
 87:       return int.tryParse(value['integerValue'].toString()) ?? 0;
 88:     }
 89:     if (value.containsKey('doubleValue')) {
 90:       return (value['doubleValue'] as num).toDouble();
 91:     }
 92:     if (value.containsKey('booleanValue')) {
 93:       return value['booleanValue'] as bool;
 94:     }
 95:     if (value.containsKey('nullValue')) {
 96:       return null;
 97:     }
 98:     if (value.containsKey('arrayValue')) {
 99:       final values = value['arrayValue']['values'] as List? ?? [];
100:       return values
101:           .map((v) => _firestoreValue(v as Map<String, dynamic>))
102:           .toList();
103:     }
104:     if (value.containsKey('mapValue')) {
105:       return _firestoreToMap(
106:           value['mapValue']['fields'] as Map<String, dynamic>? ?? {});
107:     }
108:     return null;
109:   }
