149: // ── Main ───────────────────────────────────────────────────────────────────────
150: function main() {
151:   if (!fs.existsSync('nhl_player_stats.json')) {
152:     console.error('ERRO: nhl_player_stats.json não encontrado.');
153:     process.exit(1);
154:   }
155: 
156:   const playerStats = JSON.parse(fs.readFileSync('nhl_player_stats.json'));
157:   console.log(`Jogadores carregados: ${Object.keys(playerStats).length}`);
158: 
159:   const baseGames = extractPlayerGames(playerStats, [BASE_SEASON]);
160:   const walkGames = extractPlayerGames(playerStats, [WALK_SEASON]);
161: 
162:   console.log(`Base (2024-25): ${baseGames.length} player-games | Walk-forward (2025-26): ${walkGames.length} player-games`);
163: 
164:   // ── Perfil de mercado (base histórica) ────────────────────────────────────
165:   console.log('Construindo perfil de mercado...');
166:   const marketRaw = {};
167: 
168:   for (const g of baseGames) {
169:     if (g.blowout || g.toiSeconds < MIN_TOI_SECONDS) continue;
170:     if (!marketRaw[g.playerName]) marketRaw[g.playerName] = { home: {}, away: {}, all: {} };
171:     for (const stat of STAT_KEYS) {
172:       const v = g.stats[stat];
173:       if (v === null || v === undefined) continue;
174:       for (const loc of [g.location, 'all']) {
175:         if (!marketRaw[g.playerName][loc][stat]) marketRaw[g.playerName][loc][stat] = [];
176:         marketRaw[g.playerName][loc][stat].push(v);
177:       }
178:     }
179:   }
180: 
181:   const marketProfiles = {};
182:   for (const [name, locs] of Object.entries(marketRaw)) {
183:     marketProfiles[name] = {};
184:     for (const [loc, stats] of Object.entries(locs)) {
185:       marketProfiles[name][loc] = {};
186:       for (const [stat, values] of Object.entries(stats)) {
187:         const s = calcAvgStd(values);
188:         if (s && s.count >= (loc === 'all' ? MIN_GAMES_MKT : 3)) {
189:           marketProfiles[name][loc][stat] = s;
190:         }
191:       }
192:     }
193:   }
194: 
195:   console.log(`Perfil de mercado: ${Object.keys(marketProfiles).length} jogadores\n`);
196: 
197:   // ── Walk-forward ───────────────────────────────────────────────────────────
198:   const modelRaw = {}; // acumula valores walk-forward com metadados
199:   const predictions = [];
200:   let skipped = 0, filtroBlowout = 0, filtroToi = 0;
201: 
202:   console.log('Gerando predições walk-forward...');
203: 
204:   for (const g of walkGames) {
205:     const { playerName, location, stats, blowout, toiSeconds, date } = g;
206: 
207:     // ── Predição para cada stat ANTES de atualizar modelRaw ───────────────
208:     for (const stat of STAT_KEYS) {
209:       const actual = stats[stat];
210:       if (actual === null || actual === undefined) continue;
211: 
212:       if (blowout)                      { filtroBlowout++; continue; }
213:       if (toiSeconds < MIN_TOI_SECONDS) { filtroToi++;    continue; }
214: 
215:       // Perfil de mercado
216:       const mktProfile =
217:         marketProfiles[playerName]?.[location]?.[stat]?.count >= MIN_GAMES_MKT
218:           ? marketProfiles[playerName][location][stat]
219:           : marketProfiles[playerName]?.['all']?.[stat]?.count >= MIN_GAMES_MKT
220:           ? marketProfiles[playerName]['all'][stat]
221:           : null;
222: 
223:       if (!mktProfile || mktProfile.std < 0.2) { skipped++; continue; }
224: 
225:       const line = calcLine(stat, mktProfile.avg);
226:       if (line < 0.5) { skipped++; continue; }
227: 
228:       const mktPOver  = probOver(mktProfile.avg, mktProfile.std, line);
229:       const mktPUnder = probUnder(mktProfile.avg, mktProfile.std, line);
230:       if (mktPOver <= 0 || mktPUnder <= 0) { skipped++; continue; }
231: 
232:       const mktOddOver  = marketOdd(mktPOver);
233:       const mktOddUnder = marketOdd(mktPUnder);
234:       if (!mktOddOver || !mktOddUnder || !isFinite(mktOddOver) || !isFinite(mktOddUnder)) {
235:         skipped++; continue;
236:       }
237: 
238:       // Modelo walk-forward
239:       const modelEntries =
240:         modelRaw[playerName]?.[location]?.[stat] ||
241:         modelRaw[playerName]?.['all']?.[stat] ||
242:         null;
243: 
244:       let modelValues = null;
245:       if (modelEntries && modelEntries.length >= MIN_GAMES_MODEL) {
246:         modelValues = modelEntries
247:           .filter(e => !e._blowout && !e._toiLow)
248:           .map(e => e.value);
249:         if (modelValues.length < MIN_GAMES_MODEL) modelValues = modelEntries.map(e => e.value);
250:       }
251: 
252:       let modelProfile = null;
253:       if (modelValues && modelValues.length >= MIN_GAMES_MODEL) {
254:         modelProfile = calcWeightedAvgStd(modelValues);
255:       } else if (mktProfile) {
256:         modelProfile = mktProfile;
257:       }
