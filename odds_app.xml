 10: 
 11: class MixScreen extends StatefulWidget {
 12:   const MixScreen({super.key});
 13: 
 14:   @override
 15:   State<MixScreen> createState() => _MixScreenState();
 16: }
 17: 
 18: class _MixScreenState extends State<MixScreen> {
 19:   List<Map<String, dynamic>> _allProps = [];
 20:   DateTime? _lastUpdated;
 21:   bool _loading = false;
 22:   String _status = '';
 23:   double _minEdge = 0;
 24:   String _selectedSport = 'Todos';
 25:   bool _hideWarnings = false;
 26:   DateTime? _selectedDate;
 27: 
 28:   static const _sports = ['Todos', 'NBA', 'MLB', 'NHL', 'NFL', 'Tênis'];
 29:   static const _min15 = Duration(minutes: 15);
 30: 
 31:   bool _jogoValido(Map<String, dynamic> item) {
 32:     final raw = item['commence_time'] as String?;
 33:     if (raw == null) return true;
 34:     final dt = DateTime.tryParse(raw)?.toUtc();
 35:     if (dt == null) return true;
 36:     return dt.difference(DateTime.now().toUtc()) >= _min15;
 37:   }
 38: 
 39:   @override
 40:   void initState() {
 41:     super.initState();
 42:     _load();
 43:   }
 44: 
 45:   Future<void> _load() async {
 46:     setState(() {
 47:       _loading = true;
 48:       _status = 'Carregando todos os esportes...';
 49:     });
 50:     try {
 51:       final result = await ApiService.fetchAllProps();
 52:       final valid = result.data.where(_jogoValido).toList();
 53:       final enriched = await EdgeEvaluatorService.enrichAllWithContext(valid);
 54:       final normalized = _normalizeProbBySport(enriched);
 55:       final ranked = EdgeEvaluatorService.rankLocal(normalized);
 56:       setState(() {
 57:         _allProps = ranked;
 58:         _lastUpdated = result.lastUpdated;
 59:         _status = '';
 60:       });
 61:     } catch (e) {
 62:       setState(() => _status = '');
 63:       _showError(e.toString());
 64:     } finally {
 65:       setState(() => _loading = false);
 66:     }
 67:   }
 68: 
 69:   /// Normaliza _probCalibrada por esporte via z-score para comparação cross-sport justa.
 70:   List<Map<String, dynamic>> _normalizeProbBySport(
 71:       List<Map<String, dynamic>> props) {
 72:     // Agrupa probs calibradas por esporte
 73:     final sportProbs = <String, List<double>>{};
 74:     for (final p in props) {
 75:       final sport = p['sport'] as String? ?? 'unknown';
 76:       final prob = (p['_probCalibrada'] as double?) ??
 77:           EdgeEvaluatorService.calibratedProb(p);
 78:       sportProbs.putIfAbsent(sport, () => []).add(prob);
 79:     }
 80: 
 81:     // Calcula média e desvio padrão por esporte
 82:     final sportStats = <String, ({double mean, double std})>{};
 83:     for (final entry in sportProbs.entries) {
 84:       final vals = entry.value;
 85:       if (vals.length < 2) continue;
 86:       final mean = vals.reduce((a, b) => a + b) / vals.length;
 87:       final variance =
 88:           vals.map((v) => (v - mean) * (v - mean)).reduce((a, b) => a + b) /
 89:               vals.length;
 90:       final std = variance > 0 ? sqrt(variance) : 0.01;
 91:       sportStats[entry.key] = (mean: mean, std: std);
 92:     }
 93: 
 94:     // Aplica z-score e remapeia para [0.5, 1.0] mantendo ordenação relativa
 95:     return props.map((p) {
 96:       final sport = p['sport'] as String? ?? 'unknown';
 97:       final stats = sportStats[sport];
 98:       if (stats == null) return p;
 99:       final prob = (p['_probCalibrada'] as double?) ??
100:           EdgeEvaluatorService.calibratedProb(p);
101:       if (stats == null) return p;
102:       final z = (prob - stats.mean) / stats.std;
103:       final normProb = (0.75 + z * 0.125).clamp(0.50, 0.99);
104:       return {
105:         ...p,
106:         '_probNormSport': normProb
107:       }; // não sobrescreve _probCalibrada
108:     }).toList();
109:   }
