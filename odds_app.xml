 27:   static const _min15 = Duration(minutes: 15);
 28: 
 29:   bool _jogoValido(Map<String, dynamic> item) {
 30:     final raw = item['commence_time'] as String?;
 31:     if (raw == null) return true;
 32:     final dt = DateTime.tryParse(raw)?.toUtc();
 33:     if (dt == null) return true;
 34:     return dt.difference(DateTime.now().toUtc()) >= _min15;
 35:   }
 36: 
 37:   @override
 38:   void initState() {
 39:     super.initState();
 40:     _load();
 41:   }
 42: 
 43:   Future<void> _load() async {
 44:     setState(() => _loading = true);
 45:     try {
 46:       final props = await ApiService.fetchNflProps();
 47:       final enriched = await EdgeEvaluatorService.enrichWithContext(props.data, 'nfl');
 48:       final filtered = EdgeEvaluatorService.adaptiveFilter(enriched);
 49:       setState(() {
 50:         _propsResults = filtered;
 51:         _propsUpdated = props.lastUpdated;
 52:       });
 53:     } catch (e) {
 54:       _showError(e.toString());
 55:     } finally {
 56:       setState(() => _loading = false);
 57:     }
 58:   }
 59: 
 60:   Future<void> _runUpdate() async {
 61:     setState(() {
 62:       _loading = true;
 63:       _status = 'Acionando workflow NFL...';
 64:     });
 65:     try {
 66:       await ApiService.triggerUpdate('nfl');
 67:       setState(() => _status = 'Aguardando conclusão...');
 68:       for (int i = 0; i < 36; i++) {
 69:         await Future.delayed(const Duration(seconds: 5));
 70:         try {
 71:           final s = await ApiService.getWorkflowStatus();
 72:           if (s == 'completed') break;
 73:         } catch (_) {}
 74:       }
 75:       setState(() => _status = 'Carregando...');
 76:       await _load();
 77:       setState(() => _status = 'Concluído.');
 78:     } catch (e) {
 79:       _showError(e.toString());
 80:     } finally {
 81:       setState(() => _loading = false);
 82:     }
 83:   }
 84: 
 85:   void _showError(String msg) {
 86:     ScaffoldMessenger.of(context).showSnackBar(
 87:       SnackBar(content: Text(msg), backgroundColor: Colors.red),
 88:     );
 89:   }
 90: 
 91:   void _showEvaluation() {
 92:     final valid = _propsResults.where(_jogoValido).toList();
 93:     if (valid.isEmpty) { _showError('Sem props disponíveis.'); return; }
 94:     showModalBottomSheet(
