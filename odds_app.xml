259:       if (!modelProfile) { skipped++; continue; }
260: 
261:       const pOverRaw  = probOver(modelProfile.avg, modelProfile.std, line);
262:       const pUnderRaw = probUnder(modelProfile.avg, modelProfile.std, line);
263:       const pOver  = calibrate(pOverRaw);
264:       const pUnder = calibrate(pUnderRaw);
265: 
266:       const edgeOver  = pOver  - mktPOver;
267:       const edgeUnder = pUnder - mktPUnder;
268: 
269:       const bestSide = edgeOver >= edgeUnder ? 'Over' : 'Under';
270:       const bestProb = edgeOver >= edgeUnder ? pOver  : pUnder;
271:       const bestOdd  = edgeOver >= edgeUnder ? mktOddOver : mktOddUnder;
272:       const bestEdge = edgeOver >= edgeUnder ? edgeOver : edgeUnder;
273: 
274:       const kelly = calcKelly(bestProb, bestOdd);
275:       if (kelly <= 0) { skipped++; continue; }
276: 
277:       const won = bestSide === 'Over' ? actual > line : actual < line;
278: 
279:       predictions.push({
280:         date,
281:         player: playerName,
282:         stat,
283:         location,
284:         side: bestSide,
285:         line,
286:         actual,
287:         prob:      parseFloat((bestProb * 100).toFixed(1)),
288:         edge:      parseFloat((bestEdge * 100).toFixed(2)),
289:         mktOdd:    parseFloat(bestOdd.toFixed(3)),
290:         kellyFrac: parseFloat((kelly * 100).toFixed(2)),
291:         modelAvg:  parseFloat(modelProfile.avg.toFixed(2)),
292:         won,
293:         modelGames: modelValues?.length || 0,
294:       });
