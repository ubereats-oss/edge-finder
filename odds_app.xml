 47: function ensurePath(raw, player, season, gameType, location) {
 48:   if (!raw[player]) raw[player] = {};
 49:   if (!raw[player][season]) raw[player][season] = {};
 50:   if (!raw[player][season][gameType]) {
 51:     raw[player][season][gameType] = { home: emptyContext(), away: emptyContext() };
 52:   }
 53:   return raw[player][season][gameType][location];
 54: }
