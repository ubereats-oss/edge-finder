 55:   Future<void> _loadAll() async {
 56:     setState(() => _loading = true);
 57:     try {
 58:       final h2h = await ApiService.fetchMlbResults();
 59:       final props = await ApiService.fetchMlbProps();
 60:       final enriched = await EdgeEvaluatorService.enrichWithContext(props.data, 'mlb');
 61:       final filtered = EdgeEvaluatorService.adaptiveFilter(enriched);
 62:       setState(() {
