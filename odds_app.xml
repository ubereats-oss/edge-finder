 1: name: Histórico de Odds
 2: 
 3: on:
 4:   schedule:
 5:     - cron: '0 19 * * *'
 6:   workflow_dispatch:
 7: 
 8: permissions:
 9:   contents: write
10: 
11: jobs:
12:   save-history:
13:     runs-on: ubuntu-latest
14: 
15:     steps:
16:       - name: Checkout repositório
17:         uses: actions/checkout@v4
18:         with:
19:           token: ${{ secrets.GH_PAT }}
20:           persist-credentials: true
21: 
22:       - name: Setup Node.js
23:         uses: actions/setup-node@v4
24:         with:
25:           node-version: '24'
26: 
27:       - name: Instalar dependências
28:         run: npm install axios firebase-admin
29: 
30:       - name: Injetar chaves de API
31:         run: |
32:           node -e "
33:           const fs = require('fs');
34:           const keys = process.env.ODDS_API_KEYS.split(',');
35:           let content = fs.readFileSync('pipeline/save_odds_history.js', 'utf8');
36:           content = content.replace(
37:             /const API_KEYS = \[[\s\S]*?\];/,
38:             'const API_KEYS = ' + JSON.stringify(keys, null, 2) + ';'
39:           );
40:           fs.writeFileSync('pipeline/save_odds_history.js', content);
41:           console.log('Chaves injetadas:', keys.length);
42:           "
43:         env:
44:           ODDS_API_KEYS: ${{ secrets.ODDS_API_KEYS }}
45: 
46:       - name: Restaurar histórico anterior
47:         run: |
48:           git fetch origin history 2>/dev/null && \
49:           git show origin/history:odds_history.tar.gz > /tmp/odds_history.tar.gz 2>/dev/null && \
50:           tar -xzf /tmp/odds_history.tar.gz -C . 2>/dev/null && \
51:           echo "Histórico restaurado" || \
52:           echo "Sem histórico anterior — primeira execução"
53:           mkdir -p odds_history
54: 
55:       - name: Executar coleta
56:         run: node pipeline/save_odds_history.js
57: 
58:       - name: Sincronizar histórico com Firestore
59:         run: node pipeline/firebase_sync.js history
60:         env:
61:           FIREBASE_SERVICE_ACCOUNT: ${{ secrets.FIREBASE_SERVICE_ACCOUNT }}
62: 
63:       - name: Empacotar e salvar na branch history
64:         run: |
65:           tar -czf /tmp/odds_history.tar.gz odds_history/
66:           git config user.name "github-actions[bot]"
67:           git config user.email "github-actions[bot]@users.noreply.github.com"
68:           git checkout --orphan history-tmp
69:           git rm -rf . --quiet
70:           cp /tmp/odds_history.tar.gz .
71:           git add odds_history.tar.gz
72:           git commit -m "odds: $(date -u '+%Y-%m-%d %H:%M') UTC"
73:           git push origin HEAD:history --force
74: 
75:       - name: Acionar atualização do modelo
76:         run: |
77:           curl -s -X POST \
78:             -H "Authorization: token ${{ secrets.GH_PAT }}" \
79:             -H "Accept: application/vnd.github.v3+json" \
80:             https://api.github.com/repos/ubereats-oss/edge-finder/actions/workflows/update_model.yml/dispatches \
81:             -d '{"ref":"main","inputs":{"sport":"all"}}'
