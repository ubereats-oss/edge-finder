369:         const meta = getGameMeta(metaIndex, playerName, stat, location, game.homeTeam, game.awayTeam, game.date);
370:         const entry = {
371:           value: v,
372:           _absentStarters: meta?.absentStarters || [],
373:           _blowout: meta?.blowout || false,
374:           _overtime: meta?.isOvertime || false,
