 56: // Retorna a data do jogo mais recente já salvo em todos os jogadores
 57: function getLastProcessedDate(existing) {
 58:   let latest = null;
 59:   for (const playerData of Object.values(existing)) {
 60:     for (const seasonData of Object.values(playerData)) {
 61:       for (const gameTypeData of Object.values(seasonData)) {
 62:         for (const loc of ['home', 'away']) {
 63:           const ctx = gameTypeData[loc];
 64:           if (!ctx) continue;
 65:           for (const entries of Object.values(ctx)) {
 66:             if (!Array.isArray(entries)) continue;
 67:             for (const entry of entries) {
 68:               if (entry.date && (!latest || entry.date > latest)) {
 69:                 latest = entry.date;
 70:               }
 71:             }
 72:           }
 73:         }
 74:       }
 75:     }
 76:   }
 77:   return latest; // ISO string ex: "2026-04-11T00:00Z"
 78: }
