303:   static Future<Map<String, dynamic>> _resolveViaEspn(
304:       Map<String, dynamic> bet) async {
305:     final commenceTime = bet['commence_time'] as String?;
306:     if (commenceTime == null) {
307:       throw Exception('Data do jogo não disponível');
308:     }
309:     final dt = DateTime.parse(commenceTime).toLocal();
310:     final dateStr =
311:         '${dt.year}${dt.month.toString().padLeft(2, '0')}${dt.day.toString().padLeft(2, '0')}';
312:     final dtPrev = dt.subtract(const Duration(days: 1));
313:     final dateStrPrev =
314:         '${dtPrev.year}${dtPrev.month.toString().padLeft(2, '0')}${dtPrev.day.toString().padLeft(2, '0')}';
315:     final prop = bet['prop'] as String? ?? '';
316:     final sport = prop == 'hitsAllowed' ? 'baseball/mlb' : 'basketball/nba';
317:     final sbRes = await http.get(Uri.parse(
318:         'https://site.api.espn.com/apis/site/v2/sports/$sport/scoreboard?dates=$dateStr'));
319:     if (sbRes.statusCode != 200) {
320:       throw Exception('Erro ao buscar scoreboard ESPN');
321:     }
322:     var sb = jsonDecode(sbRes.body) as Map<String, dynamic>;
323:     var events = sb['events'] as List? ?? [];
324:     if (events.isEmpty) {
325:       final sbRes2 = await http.get(Uri.parse(
326:           'https://site.api.espn.com/apis/site/v2/sports/$sport/scoreboard?dates=$dateStrPrev'));
327:       if (sbRes2.statusCode == 200) {
328:         sb = jsonDecode(sbRes2.body) as Map<String, dynamic>;
329:         events = sb['events'] as List? ?? [];
330:       }
331:     }
332:     final gameParts = (bet['game'] as String? ?? '').split(' x ');
333:     final t1 = gameParts.isNotEmpty ? gameParts[0].split(' ').last : '';
334:     final t2 = gameParts.length > 1 ? gameParts[1].split(' ').last : '';
335:     final event = events.firstWhere(
336:       (e) {
337:         final competitors =
338:             (e['competitions'] as List).first['competitors'] as List;
339:         final names =
340:             competitors.map((c) => c['team']['displayName'] as String).toList();
341:         return names.any((n) => n.contains(t1)) &&
342:             names.any((n) => n.contains(t2));
343:       },
344:       orElse: () => null,
345:     );
346:     if (event == null) {
347:       throw Exception('Jogo não encontrado no ESPN');
348:     }
349:     final comp = (event['competitions'] as List).first;
350:     if (!(comp['status']?['type']?['completed'] as bool? ?? false)) {
351:       throw Exception('Jogo ainda não encerrado');
352:     }
353:     if (bet['type'] == 'h2h') {
354:       final competitors = comp['competitors'] as List;
355:       final winner = competitors.firstWhere((c) => c['winner'] == true,
356:           orElse: () => null);
357:       if (winner == null) {
358:         throw Exception('Resultado indisponível');
359:       }
360:       final loser = competitors.firstWhere((c) => c['winner'] != true);
361:       final teamStr = (bet['team'] as String? ?? '').trim();
362:       if (teamStr.isEmpty) {
363:         throw Exception(
364:             'Time não informado nesta aposta. Edite a aposta e informe o time para poder resolver.');
365:       }
366:       final won = (winner['team']['displayName'] as String)
367:           .contains(teamStr.split(' ').last);
368:       final profit = won
369:           ? double.parse((((bet['odds'] as num).toDouble() - 1) *
370:                   (bet['stake'] as num).toDouble())
371:               .toStringAsFixed(2))
372:           : -(bet['stake'] as num).toDouble();
373:       return {
374:         'realValue':
375:             '${winner['team']['displayName']} ${winner['score']}-${loser['score']}',
376:         'won': won,
377:         'profit': double.parse(profit.toStringAsFixed(2)),
378:       };
379:     }
380:     final sumUrl =
381:         'https://site.api.espn.com/apis/site/v2/sports/$sport/summary?event=${event['id']}';
382:     final sumRes = await http.get(Uri.parse(sumUrl));
383:     if (sumRes.statusCode != 200) {
384:       throw Exception('Erro ao buscar box score ESPN');
385:     }
386:     final sum = jsonDecode(sumRes.body) as Map<String, dynamic>;
387:     const nbaStatMap = {
388:       'points': 'points',
389:       'rebounds': 'rebounds',
390:       'assists': 'assists',
391:       'steals': 'steals',
392:       'threes': 'threePointFieldGoalsMade-threePointFieldGoalsAttempted',
393:     };
394:     // Para MLB: 'hits' no grupo de pitching (identificado por 'inningsPitched')
395:     const mlbStatMap = {
396:       'hitsAllowed': 'hits',
397:     };
398:     final isMlb = sport == 'baseball/mlb';
399:     final statMap = isMlb ? mlbStatMap : nbaStatMap;
400:     final statKey = statMap[prop] ?? prop;
401:     final playerLastName =
402:         (bet['player'] as String? ?? '').split(' ').last.toLowerCase();
403:     double? realValue;
404:     final players = sum['boxscore']?['players'] as List? ?? [];
405:     for (final team in players) {
406:       for (final group in (team['statistics'] as List? ?? [])) {
407:         final keys = (group['keys'] as List?)?.cast<String>() ?? [];
408:         // Para MLB, restringe ao grupo de pitching (contém 'inningsPitched')
409:         if (isMlb && !keys.contains('inningsPitched')) continue;
410:         final colIdx = keys.indexOf(statKey);
411:         if (colIdx == -1) continue;
412:         for (final athlete in (group['athletes'] as List? ?? [])) {
413:           final name =
414:               (athlete['athlete']['displayName'] as String).toLowerCase();
415:           if (name.contains(playerLastName)) {
416:             final statStr =
417:                 (athlete['stats'] as List)[colIdx] as String? ?? '0';
418:             realValue = double.tryParse(statStr.split('-').first) ?? 0;
419:           }
420:         }
421:       }
422:     }
423:     if (realValue == null) {
424:       throw Exception('Stat não encontrada no ESPN');
425:     }
426:     final side = bet['side'] as String? ?? 'Over';
427:     final line = (bet['line'] as num).toDouble();
428:     final odds = (bet['odds'] as num).toDouble();
429:     final stake = (bet['stake'] as num).toDouble();
430:     final won = side == 'Over' ? realValue > line : realValue < line;
431:     final profit = won
432:         ? double.parse(((odds - 1) * stake).toStringAsFixed(2))
433:         : double.parse((-stake).toStringAsFixed(2));
434:     return {'realValue': realValue, 'won': won, 'profit': profit};
435:   }
