 633:       final avg10 = (p['playerAvg10'] as num?)?.toDouble();
 634:       String? tendencia;
 635:       if (avg5 != null && avg10 != null && avg10 > 0) {
 636:         final t = (avg5 - avg10) / avg10 * 100;
 637:         if (t >= 8) {
