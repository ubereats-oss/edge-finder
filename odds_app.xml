<file path="firestore.rules">
 1: rules_version = '2';
 2: service cloud.firestore {
 3:   match /databases/{database}/documents {
 4: 
 5:     // results/ e odds_history/ — somente leitura pública
 6:     match /results/{document=**} {
 7:       allow read: if true;
 8:       allow write: if false;
 9:     }
10: 
11:     match /odds_history/{document=**} {
12:       allow read: if true;
13:       allow write: if false;
14:     }
15: 
16:     // bets/ — usuário autenticado acessa apenas as próprias apostas
17:     // O pipeline (service account) tem acesso admin via SDK e ignora estas regras
18:     match /bets/{betId} {
19:       allow read, update, delete: if request.auth != null
20:         && resource.data.uid == request.auth.uid;
21:       allow create: if request.auth != null
22:         && request.resource.data.uid == request.auth.uid;
23:     }
24:   }
25: }
</file>

