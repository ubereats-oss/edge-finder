<file path="lib/services/edge_evaluator_service.dart">
   1: import 'dart:convert';
   2: import 'package:http/http.dart' as http;
   3: 
   4: class EdgeEvaluatorService {
   5:   // ── Algoritmo Local ───────────────────────────────────────────────────────
   6: 
   7:   // Normaliza para 0-1 independente de escala de entrada (0-1 ou 0-100)
   8:   static double _toProb(num? v, double fallback) {
   9:     if (v == null) return fallback;
  10:     final d = v.toDouble();
  11:     return d > 1 ? d / 100 : d;
  12:   }
  13: 
  14:   static double calibratedProb(Map<String, dynamic> p) {
  15:     final model = _toProb(p['modelProb'], 0.50);
  16:     final market = _toProb(p['impliedProb'], 0.50);
  17:     final side = p['side'] as String? ?? 'Over';
  18:     final line = (p['line'] as num?)?.toDouble() ?? 0;
  19:     final avg5 = (p['playerAvg5'] as num?)?.toDouble();
  20:     final avg10 = (p['playerAvg10'] as num?)?.toDouble();
  21: 
  22:     double confidence = 0.5;
  23:     if (p['inefficientMarket'] == true) confidence += 0.1;
  24:     if (p['lowSample'] == true) confidence -= 0.2;
  25:     if (avg5 != null && avg10 != null) {
  26:       if (side == 'Over') {
  27:         if (avg5 > line && avg10 > line) confidence += 0.1;
  28:         if (avg5 < line && avg10 < line) confidence -= 0.1;
  29:       } else {
  30:         if (avg5 < line && avg10 < line) confidence += 0.1;
  31:         if (avg5 > line && avg10 > line) confidence -= 0.1;
  32:       }
  33:     }
  34:     confidence = confidence.clamp(0.2, 0.7);
  35:     return market + confidence * (model - market);
  36:   }
  37: 
  38:   static const int _minBets = 15;
  39:   static const int _maxBets = 20;
  40: 
  41:   static double _kelly(Map<String, dynamic> p) {
  42:     final stored = (p['kelly'] as num?)?.toDouble();
  43:     if (stored != null) return stored;
  44:     final prob = (p['_probCalibrada'] as double?) ?? calibratedProb(p);
  45:     final odds = (p['odds'] as num?)?.toDouble() ?? 2.0;
  46:     if (odds <= 1) return 0;
  47:     return ((prob * odds - 1) / (odds - 1) * 100).clamp(0.0, 100.0);
  48:   }
  49: 
  50:   static double _stdOutlierZ(Map<String, dynamic> p) {
  51:     final avg5 = (p['playerAvg5'] as num?)?.toDouble();
  52:     final avg = (p['playerAvg'] as num?)?.toDouble();
  53:     final std = (p['playerStd'] as num?)?.toDouble();
  54: 
  55:     if (avg5 == null || avg == null || std == null || std <= 0) return 0;
  56: 
  57:     return ((avg5 - avg).abs() / std);
  58:   }
  59: 
  60:   static bool _isStdOutlierAgainstBet(Map<String, dynamic> p) {
  61:     final side = p['side'] as String? ?? 'Over';
  62:     final avg5 = (p['playerAvg5'] as num?)?.toDouble();
  63:     final avg = (p['playerAvg'] as num?)?.toDouble();
  64:     final std = (p['playerStd'] as num?)?.toDouble();
  65: 
  66:     if (avg5 == null || avg == null || std == null || std <= 0) return false;
  67: 
  68:     final z = _stdOutlierZ(p);
  69:     if (z < 1.25) return false;
  70: 
  71:     if (side == 'Over') return avg5 < avg - std;
  72:     return avg5 > avg + std;
  73:   }
  74: 
  75:   static int _contradictionLevel(Map<String, dynamic> p) {
  76:     final side = p['side'] as String? ?? 'Over';
  77:     final line = (p['line'] as num?)?.toDouble() ?? 0;
  78:     final avg5 = (p['playerAvg5'] as num?)?.toDouble();
  79: 
  80:     if (avg5 == null || line <= 0) return 0;
  81: 
  82:     if (_isStdOutlierAgainstBet(p)) return 2;
  83: 
  84:     if (side == 'Under') {
  85:       if (avg5 > line * 1.15) return 2;
  86:       if (avg5 > line) return 1;
  87:       return 0;
  88:     }
  89: 
  90:     if (avg5 < line * 0.85) return 2;
  91:     if (avg5 < line) return 1;
  92:     return 0;
  93:   }
  94: 
  95:   static int lastQualifiedCount = 0;
  96: 
  97:   // Floors absolutos — nunca relaxados (odds, kelly, edge mínimo absoluto, cs)
  98:   static bool _absoluteFloors(Map<String, dynamic> p) {
  99:     final odds = (p['odds'] as num?)?.toDouble() ?? 0;
 100:     if (odds < 1.20 || odds > 5.00) return false;
 101:     if (_kelly(p) < 2.0) return false;
 102:     final edge = (p['edge'] as num?)?.toDouble() ?? 0;
 103:     if (edge < 2.5) return false;
 104:     final cs = (p['_contextScore'] as int?) ?? 0;
 105:     if (cs <= -2) return false;
 106:     return true;
 107:   }
 108: 
 109:   // minEdgePct em percentual (ex: 3.0 = 3%)
 110:   static bool _baseFloors(
 111:       Map<String, dynamic> p, double minProb, double minEdgePct) {
 112:     if (!_absoluteFloors(p)) return false;
 113:     final prob = (p['_probCalibrada'] as double?) ?? calibratedProb(p);
 114:     if (prob < minProb) return false;
 115:     final edge = (p['edge'] as num?)?.toDouble() ?? 0;
 116:     if (edge < minEdgePct) return false;
 117:     return true;
 118:   }
 119: 
 120:   static bool _passesContradiction(Map<String, dynamic> p) {
 121:     final cl = (p['_contradictionLevel'] as int?) ?? _contradictionLevel(p);
 122:     if (cl == 0) return true;
 123: 
 124:     final edge = (p['edge'] as num?)?.toDouble() ?? 0;
 125:     if (cl == 1) return edge >= 8 && _kelly(p) >= 4;
 126: 
 127:     final confirmed = (p['_contextConfirmed'] as bool?) ?? false;
 128:     final status = p['_contextStatus'] as String? ?? 'unknown';
 129: 
 130:     if (_isStdOutlierAgainstBet(p) && !confirmed) return false;
 131: 
 132:     final side = p['side'] as String? ?? 'Over';
 133:     final line = (p['line'] as num?)?.toDouble() ?? 0;
 134:     final avg5 = (p['playerAvg5'] as num?)?.toDouble();
 135:     final avg5ContradizLinha = avg5 != null &&
 136:         line > 0 &&
 137:         ((side == 'Over' && avg5 < line) || (side == 'Under' && avg5 > line));
 138: 
 139:     if (avg5ContradizLinha) return confirmed && status == 'positive';
 140:     return (edge >= 25 && _kelly(p) >= 8) ||
 141:         (confirmed && status == 'positive');
 142:   }
 143: 
 144:   static List<Map<String, dynamic>> adaptiveFilter(
 145:       List<Map<String, dynamic>> props) {
 146:     bool full(Map<String, dynamic> p) =>
 147:         _baseFloors(p, 0.55, 3.0) && _passesContradiction(p);
 148: 
 149:     // Relaxado: prob 0.52, edge 2.5 — contradição mantida igual
 150:     bool relaxed(Map<String, dynamic> p) {
 151:       if (!_absoluteFloors(p)) return false;
 152:       if (!_passesContradiction(p)) return false;
 153:       if (p['lowSample'] == true) return false;
 154:       final prob = (p['_probCalibrada'] as double?) ?? calibratedProb(p);
 155:       if (prob < 0.52) return false;
 156:       return true;
 157:     }
 158: 
 159:     var result = props.where(full).toList();
 160:     if (result.length < _minBets) result = props.where(relaxed).toList();
 161:     lastQualifiedCount = result.length;
 162:     return result;
 163:   }
 164: 
 165:   static double _computeScoreFinal(Map<String, dynamic> p) {
 166:     final prob = (p['_probCalibrada'] as double?) ?? calibratedProb(p);
 167:     final edge = (p['edge'] as num?)?.toDouble() ?? 0;
 168:     final cl = (p['_contradictionLevel'] as int?) ?? 0;
 169:     final status = p['_contextStatus'] as String? ?? 'unknown';
 170:     final confirmed = (p['_contextConfirmed'] as bool?) ?? false;
 171:     final lowSample = p['lowSample'] == true;
 172:     final side = p['side'] as String? ?? 'Over';
 173:     final line = (p['line'] as num?)?.toDouble() ?? 0;
 174:     final avg5 = (p['playerAvg5'] as num?)?.toDouble();
 175:     final avg10 = (p['playerAvg10'] as num?)?.toDouble();
 176: 
 177:     final stdOutlierAgainstBet = _isStdOutlierAgainstBet(p);
 178: 
 179:     final double consistencyScore;
 180:     if (cl == 2) {
 181:       consistencyScore = stdOutlierAgainstBet ? 0.0 : 0.1;
 182:     } else if (cl == 1) {
 183:       consistencyScore = 0.3;
 184:     } else {
 185:       final f5 = avg5 != null &&
 186:           line > 0 &&
 187:           ((side == 'Over' && avg5 >= line) ||
 188:               (side == 'Under' && avg5 <= line));
 189:       final f10 = avg10 != null &&
 190:           line > 0 &&
 191:           ((side == 'Over' && avg10 >= line) ||
 192:               (side == 'Under' && avg10 <= line));
 193: 
 194:       if (avg5 != null && avg10 != null) {
 195:         consistencyScore = f5 && f10
 196:             ? 1.0
 197:             : f10
 198:                 ? 0.7
 199:                 : 0.5;
 200:       } else {
 201:         consistencyScore = avg5 != null ? (f5 ? 0.8 : 0.3) : 0.5;
 202:       }
 203:     }
 204: 
 205:     double probAdj = prob;
 206: 
 207:     if (stdOutlierAgainstBet && !confirmed) {
 208:       probAdj = probAdj * 0.75;
 209:     }
 210: 
 211:     // Componentes normalizados em [0,1] antes de ponderar.
 212:     // Edge normalizado contra teto realista de 40% (edges >40% são raros e saturados).
 213:     final edgeNorm = (edge / 40).clamp(0.0, 1.0);
 214: 
 215:     // Pesos: 55% prob calibrada · 25% edge · 20% consistência estatística.
 216:     // Objetivo: priorizar alta prob de acerto com edge positivo confirmado.
 217:     double s = 55 * probAdj + 25 * edgeNorm + 20 * consistencyScore;
 218: 
 219:     if (status == 'positive') s += 8;
 220:     if (status == 'negative') s -= 15;
 221:     if (cl == 2 && !confirmed) s -= 20;
 222:     if (lowSample) s -= 8;
 223: 
 224:     return s.clamp(0.0, 100.0);
 225:   }
 226: 
 227:   static List<Map<String, dynamic>> rankLocal(
 228:       List<Map<String, dynamic>> props) {
 229:     final filtered = adaptiveFilter(props);
 230:     final scored = filtered.map((p) {
 231:       final sf = _computeScoreFinal(p);
 232:       final prob = (p['_probCalibrada'] as double?) ?? calibratedProb(p);
 233:       final edge = (p['edge'] as num?)?.toDouble() ?? 0;
 234:       final ev = edge * prob;
 235:       return {...p, '_scoreFinal': sf, '_localScore': sf, '_evScore': ev};
 236:     }).toList();
 237: 
 238:     scored.sort((a, b) {
 239:       final aNeg = (a['_contextStatus'] as String?) == 'negative' ? 1 : 0;
 240:       final bNeg = (b['_contextStatus'] as String?) == 'negative' ? 1 : 0;
 241:       if (aNeg != bNeg) {
 242:         return aNeg.compareTo(bNeg); // linha 1: negative por último
 243:       }
 244: 
 245:       final sCmp =
 246:           (b['_scoreFinal'] as double).compareTo(a['_scoreFinal'] as double);
 247:       if (sCmp != 0) return sCmp; // linha 2: maior score primeiro
 248: 
 249:       final aNorm = (a['_probNormSport'] as double?) ?? 0;
 250:       final bNorm = (b['_probNormSport'] as double?) ?? 0;
 251:       final normCmp = bNorm.compareTo(aNorm);
 252:       if (normCmp != 0) return normCmp; // linha 3: melhor dentro do esporte
 253: 
 254:       final evCmp =
 255:           (b['_evScore'] as double).compareTo(a['_evScore'] as double);
 256:       if (evCmp != 0) return evCmp; // linha 4: maior EV
 257: 
 258:       return _kelly(b).compareTo(_kelly(a)); // linha 5: maior Kelly
 259:     });
 260: 
 261:     // Validação final + cap
 262:     final isRelaxed = lastQualifiedCount < _minBets;
 263:     final minEdge = isRelaxed ? 1.5 : 2.5;
 264:     final valid = scored.where((p) {
 265:       final edge = (p['edge'] as num?)?.toDouble() ?? 0;
 266:       if (edge < minEdge || _kelly(p) < 2.0) return false;
 267:       final odds = (p['odds'] as num?)?.toDouble() ?? 0;
 268:       if (odds < 1.20 || odds > 5.00) return false;
 269:       final cl = (p['_contradictionLevel'] as int?) ?? 0;
 270:       if (cl == 2 && edge < 20) return false;
 271:       return true;
 272:     }).toList();
 273: 
 274:     lastQualifiedCount = valid.length;
 275:     return valid.take(_maxBets).toList();
 276:   }
