297:     // ── Atualiza modelRaw APÓS predição (walk-forward correto) ────────────
298:     if (!modelRaw[playerName]) modelRaw[playerName] = { home: {}, away: {}, all: {} };
299:     for (const stat of STAT_KEYS) {
300:       const v = stats[stat];
301:       if (v === null || v === undefined) continue;
302:       const entry = {
303:         value:    v,
304:         _blowout: blowout,
305:         _toiLow:  toiSeconds < MIN_TOI_SECONDS,
306:       };
307:       for (const loc of [location, 'all']) {
308:         if (!modelRaw[playerName][loc][stat]) modelRaw[playerName][loc][stat] = [];
309:         modelRaw[playerName][loc][stat].push(entry);
310:       }
311:     }
