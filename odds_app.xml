169:           for (const athlete of group.athletes || []) {
170:             const name = athlete.athlete?.displayName;
171:             if (!name) continue;
172:             const stats = athlete.stats || [];
173:             const meta = {
174:               date: event.date, isBackToBack: isBackToBack[teamName] || false,
175:               blowout: event.blowout, isExtraInnings: event.isExtraInnings,
176:               won, teamScore, oppScore, opponent,
177:               _team: teamName, _eventDate: event.date, absentStarters: [],
178:             };
179: 
180:             if (isBatterGroup) {
181:               const ab = parseFloat(stats[idxAB]) || 0;
182:               if (ab < MIN_AB_BATTER) continue;
183:               const ctx = ensurePath(raw, name, season, gameType, location);
184:               if (ctx.hits.some(e => e.date === event.date && e.opponent === opponent)) continue;
185:               ctx.games++;
186:               ctx.hits.push({ ...meta, value: parseFloat(stats[idxH]) || 0 });
187:               ctx.homeRuns.push({ ...meta, value: parseFloat(stats[idxHR]) || 0 });
188: 
189:             } else if (isPitcherGroup) {
190:               const ip = parseFloat(stats[idxIP]) || 0;
191:               if (ip < MIN_IP_PITCHER) continue;
192:               const ctx = ensurePath(raw, name, season, gameType, location);
193:               if (ctx.strikeouts.some(e => e.date === event.date && e.opponent === opponent)) continue;
194:               ctx.games++;
195:               ctx.strikeouts.push({ ...meta, value: parseFloat(stats[idxSO]) || 0 });
196:               ctx.hitsAllowed.push({ ...meta, value: parseFloat(stats[idxH]) || 0 });
197:             }
198:           }
199:         }
200:       }
201:     } catch { /* box score indisponível */ }
202:     await sleep(150);
203:     if (totalBoxScores % 100 === 0 && totalBoxScores > 0)
204:       console.log(`  ${totalBoxScores} box scores processados...`);
205:   }
206:   return totalBoxScores;
207: }
