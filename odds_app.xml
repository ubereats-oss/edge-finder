205:       final edge = (p['edge'] as num).toDouble();
206:       if (edge < _minEdge) return false;
207:       if (_selectedProp != null && p['prop'] != _selectedProp) return false;
208:       if (_hideWarnings && p['lowSample'] == true) return false;
209:       return true;
