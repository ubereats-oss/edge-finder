 860:   static List? _parseJsonList(String text) {
 861:     if (text.trim().isEmpty) return null;
 862: 
 863:     // 1. Tenta diretamente (responseMimeType garante JSON puro)
 864:     try {
 865:       final decoded = jsonDecode(text.trim());
 866:       if (decoded is List) return decoded;
 867:     } catch (_) {}
 868: 
 869:     // 2. Remove marcadores de citação do grounding: [1], [2], etc.
 870:     final cleaned = text.replaceAll(RegExp(r'\[\d+\]'), '').trim();
 871: 
 872:     // 3. Extrai de bloco markdown ```json ... ``` ou ``` ... ```
 873:     final codeBlock =
 874:         RegExp(r'```(?:json)?\s*([\s\S]*?)\s*```').firstMatch(cleaned);
 875:     if (codeBlock != null) {
 876:       try {
 877:         final decoded = jsonDecode(codeBlock.group(1)!.trim());
 878:         if (decoded is List) return decoded;
 879:       } catch (_) {}
 880:     }
 881: 
 882:     // 4. Extrai primeiro array JSON do texto
 883:     final arrayMatch = RegExp(r'\[[\s\S]*\]').firstMatch(cleaned);
 884:     if (arrayMatch != null) {
 885:       try {
 886:         final decoded = jsonDecode(arrayMatch.group(0)!);
 887:         if (decoded is List) return decoded;
 888:       } catch (_) {}
 889:     }
 890: 
 891:     // 5. Tenta de [ até o último ]
 892:     final first = cleaned.indexOf('[');
 893:     final last = cleaned.lastIndexOf(']');
 894:     if (first != -1 && last > first) {
 895:       try {
 896:         final decoded = jsonDecode(cleaned.substring(first, last + 1));
 897:         if (decoded is List) return decoded;
 898:       } catch (_) {}
 899:     }
 900: 
 901:     return null;
 902:   }
