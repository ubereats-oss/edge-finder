 459:   /// Enriquece cada prop com _contextScore, _contextLabel, _contextReason.
 460:   /// Se a API falhar, todas as props ficam com contextScore=0 (neutro).
 461:   static Future<List<Map<String, dynamic>>> enrichWithContext(
 462:       List<Map<String, dynamic>> props, String sport) async {
 463:     final injuries = await _fetchInjuries(sport);
 464:     if (injuries.isEmpty) {
 465:       return props.map((p) {
 466:         final cl = _contradictionLevel(p);
 467:         final prob = calibratedProb(p);
 468:         return {
 469:           ...p,
 470:           '_contextScore': 0,
 471:           '_contextLabel': '0',
 472:           '_contextReason': 'sem dados externos disponíveis',
 473:           '_probFinal': prob,
 474:           '_probCalibrada': prob,
 475:           '_contextStatus': 'unknown',
 476:           '_contextConfirmed': false,
 477:           '_contradictionLevel': cl,
 478:         };
 479:       }).toList();
 480:     }
 481: 
 482:     // Mapa time → contagem de OUT/DOUBTFUL (score <= -2)
 483:     final teamSevere = <String, int>{};
 484:     for (final e in injuries.entries) {
 485:       final score = _injuryStatusScore(e.value['status'] ?? '');
 486:       if (score <= -2) {
 487:         final team = e.value['team'] ?? '';
 488:         teamSevere[team] = (teamSevere[team] ?? 0) + 1;
 489:       }
 490:     }
 491: 
 492:     return props.map((p) {
 493:       final playerKey = (p['player'] as String? ?? '').toLowerCase();
 494:       final playerTeam = (p['playerTeam'] as String? ?? '').toLowerCase();
 495:       final injury = injuries[playerKey];
 496: 
 497:       int contextScore;
 498:       String reason;
 499: 
 500:       if (injury != null) {
 501:         contextScore = _injuryStatusScore(injury['status'] ?? '');
 502:         final detail = injury['detail'] ?? '';
 503:         if (contextScore <= -3) {
 504:           reason =
 505:               'Jogador confirmado fora${detail.isNotEmpty ? " ($detail)" : ""}';
 506:         } else if (contextScore == -2) {
 507:           reason = 'Jogador duvidoso${detail.isNotEmpty ? " ($detail)" : ""}';
 508:         } else if (contextScore == -1) {
 509:           reason =
 510:               'Jogador questionável${detail.isNotEmpty ? " ($detail)" : ""}';
 511:         } else {
 512:           reason = 'Jogador provável';
 513:         }
 514:       } else {
 515:         final severeCount = teamSevere[playerTeam] ?? 0;
 516:         if (severeCount >= 3) {
 517:           contextScore = 3;
 518:           reason = '$severeCount ausências no time — aumento forte de minutos';
 519:         } else if (severeCount >= 2) {
 520:           contextScore = 2;
 521:           reason = '$severeCount jogadores ausentes — aumento de uso esperado';
 522:         } else if (severeCount == 1) {
 523:           contextScore = 1;
 524:           reason = 'Titular do time ausente — possível aumento de uso';
 525:         } else {
 526:           contextScore = 0;
 527:           reason = 'Sem lesões relevantes no time';
 528:         }
 529:       }
 530: 
 531:       final probCal = calibratedProb(p);
 532:       final probFinal = (probCal + contextScore * 0.04).clamp(0.0, 1.0);
 533:       final scoreStr = contextScore > 0 ? '+$contextScore' : '$contextScore';
 534:       final contextConfirmed =
 535:           contextScore >= 1 && (injury != null || (teamSevere[playerTeam] ?? 0) > 0);
 536:       final contextStatus = contextScore >= 1
 537:           ? 'positive'
 538:           : contextScore <= -1
 539:               ? 'negative'
 540:               : contextConfirmed
 541:                   ? 'neutral'
 542:                   : 'unknown';
 543:       if (!contextConfirmed) reason = 'sem contexto externo confirmado';
 544: 
 545:       final cl = _contradictionLevel(p);
 546: 
 547:       return {
 548:         ...p,
 549:         '_contextScore': contextScore,
 550:         '_contextLabel': scoreStr,
 551:         '_contextReason': reason,
 552:         '_probFinal': probFinal,
 553:         '_probCalibrada': probCal,
 554:         '_contextStatus': contextStatus,
 555:         '_contextConfirmed': contextConfirmed,
 556:         '_contradictionLevel': cl,
 557:       };
 558:     }).toList();
 559:   }
