590: 
591:   static Future<List<Map<String, dynamic>>> rankWithGemini(
592:     List<Map<String, dynamic>> props,
593:     String apiKey,
594:     String sport,
595:   ) async {
596:     if (apiKey.isEmpty) {
597:       throw Exception(
598:           'Chave Gemini não configurada. Acesse Configurações para adicionar.');
599:     }
600: 
601:     final top = rankLocal(props).take(20).toList();
602: 
603:     // Busca notícias ESPN em paralelo com a montagem do prompt
604:     final espnNews = await _fetchEspnNews(sport);
605: 
606:     final propsData = top.map((p) {
607:       final avg5 = (p['playerAvg5'] as num?)?.toDouble();
608:       final avg10 = (p['playerAvg10'] as num?)?.toDouble();
609:       String? tendencia;
610:       if (avg5 != null && avg10 != null && avg10 > 0) {
611:         final t = (avg5 - avg10) / avg10 * 100;
612:         if (t >= 8) {
613:           tendencia =
614:               'Em alta (5j ${avg5.toStringAsFixed(1)} vs 10j ${avg10.toStringAsFixed(1)})';
615:         } else if (t <= -8) {
616:           tendencia =
617:               'Em queda (5j ${avg5.toStringAsFixed(1)} vs 10j ${avg10.toStringAsFixed(1)})';
618:         } else {
619:           tendencia =
620:               'Estável (5j ${avg5.toStringAsFixed(1)} vs 10j ${avg10.toStringAsFixed(1)})';
621:         }
622:       }
623:       return {
624:         'id': '${p['player']}_${p['prop']}_${p['side']}',
625:         'jogador': p['player'],
626:         'tipo': p['prop'],
627:         'linha': p['line'],
628:         'lado': p['side'],
629:         'edge': '${((p['edge'] as num).toDouble()).toStringAsFixed(1)}%',
630:         'probModelo':
631:             '${(p['modelProb'] as num).toDouble().toStringAsFixed(1)}%',
632:         'probMercado':
633:             '${(p['impliedProb'] as num).toDouble().toStringAsFixed(1)}%',
634:         'mediaGeral': p['playerAvg'],
635:         'media5j': avg5,
636:         'media10j': avg10,
637:         'tendencia': tendencia,
638:         'kelly': p['kelly'],
639:         'jogo': p['game'],
640:         'poucosJogos': p['lowSample'] ?? false,
641:         'mercadoIneficiente': p['inefficientMarket'] ?? false,
642:       };
643:     }).toList();
644: 
645:     final newsSection = espnNews.isNotEmpty
646:         ? 'NOTÍCIAS ESPN RECENTES ($sport):\n$espnNews\n\n'
647:         : '';
648: 
649:     final playerNames =
650:         top.map((p) => p['player'] as String).toSet().join(', ');
651: 
652:     final prompt = '''Você é um especialista em apostas esportivas de $sport.
653: 
654: ${newsSection}PROPS PARA ANÁLISE:
655: ${jsonEncode(propsData)}
656: 
657: REGRAS OBRIGATÓRIAS:
658: 1. Use Google Search agora para cada jogador: $playerNames
659:    Verifique: titular/reserva? lesionado? mudança de rotação? minutos nas últimas partidas? matchup relevante?
660: 
661: 2. fato_externo DEVE ser um fato verificado real. Exemplos válidos:
662:    "titular X fora por lesão, aumento de minutos esperado"
663:    "adversário tem defesa top-5 contra esse tipo de prop"
664:    "jogador voltou de lesão, em restrição de minutos"
665:    Se não encontrar nenhum fato externo real → fato_externo="sem validação de contexto", confirmado=false
666: 
667: 3. PROIBIDO usar como justificativa:
668:    — "média recente é outlier"
669:    — "média histórica favorece"
670:    — qualquer frase que não cite fato externo concreto
671: 
672: 4. Se avg5 contradiz a aposta (ex: aposta Over mas média recent abaixo da linha):
673:    Só confirme se houver fato externo real que explique a inversão.
674: 
675: Retorne SOMENTE JSON:
676: [{"id":"...","rank":1,"aiProbability":75.5,"justificativa":"análise citando fato externo (max 200 chars)","contextStatus":"positive","contextConfirmed":true,"contextReason":"motivo curto","externalFact":"fato verificado ou 'sem validação de contexto'"},...]''';
677: 
678:     final url =
679:         'https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-lite:generateContent?key=$apiKey';
680: 
681:     final res = await http.post(
682:       Uri.parse(url),
683:       headers: {'Content-Type': 'application/json'},
684:       body: jsonEncode({
685:         'contents': [
686:           {
687:             'parts': [
688:               {'text': prompt}
689:             ]
690:           }
691:         ],
692:         'tools': [
693:           {'google_search': {}}
694:         ],
695:         'generationConfig': {
696:           'temperature': 0.2,
697:           'maxOutputTokens': 4096,
698:         },
699:       }),
700:     );
701: 
702:     if (res.statusCode != 200) {
703:       final err = jsonDecode(res.body) as Map<String, dynamic>;
704:       final msg =
705:           (err['error'] as Map?)?['message'] ?? 'Erro ${res.statusCode}';
706:       throw Exception('Erro Gemini: $msg');
707:     }
708: 
709:     final body = jsonDecode(res.body) as Map<String, dynamic>;
710:     final candidates = body['candidates'] as List?;
711:     final firstCandidate = candidates?.isNotEmpty == true
712:         ? candidates!.first as Map<String, dynamic>
713:         : <String, dynamic>{};
714: 
715:     final rawText = ((firstCandidate['content'] as Map?)?['parts'] as List?)
716:             ?.first is Map
717:         ? ((firstCandidate['content'] as Map)['parts'][0]['text'] as String? ??
718:             '')
719:         : '';
720: 
721:     final grounding =
722:         firstCandidate['groundingMetadata'] as Map<String, dynamic>?;
723:     final groundingChunks = grounding?['groundingChunks'] as List? ?? [];
724:     final webQueries = grounding?['webSearchQueries'] as List? ?? [];
725:     final hasGrounding = groundingChunks.isNotEmpty || webQueries.isNotEmpty;
726: 
727:     final rankings = _parseJsonList(rawText);
728:     if (rankings == null) {
729:       final preview =
730:           rawText.length > 200 ? rawText.substring(0, 200) : rawText;
731:       throw Exception('Resposta Gemini inválida. Prévia: $preview');
732:     }
733: 
734:     final result = <Map<String, dynamic>>[];
735: 
736:     for (final r in rankings) {
737:       final id = r['id'] as String? ?? '';
738:       final prop = top.firstWhere(
739:         (p) => '${p['player']}_${p['prop']}_${p['side']}' == id,
740:         orElse: () => <String, dynamic>{},
741:       );
742: 
743:       if (prop.isEmpty) continue;
744: 
745:       final fact = ((r['externalFact'] as String?) ?? '').trim();
746:       final just = ((r['justificativa'] as String?) ?? '').trim();
747:       final confirmed = (r['contextConfirmed'] as bool?) ?? false;
748:       final factLower = fact.toLowerCase();
749:       final justLower = just.toLowerCase();
750: 
751:       final invalidTerms = [
752:         'média',
753:         'modelo',
754:         'prob',
755:         'tendência',
756:         'edge',
757:         'linha baixa',
758:         'linha alta',
759:         'sem validação',
760:       ];
761: 
762:       final usesOnlyInternalData = invalidTerms.any(
763:         (term) => factLower.contains(term) || justLower.contains(term),
764:       );
765: 
766:       final isValidFact =
767:           hasGrounding && confirmed && fact.isNotEmpty && !usesOnlyInternalData;
768: 
769:       if (!isValidFact) continue;
770: 
771:       result.add({
772:         ...prop,
773:         '_aiRank': (r['rank'] as num?)?.toInt() ?? 999,
774:         '_aiProb': (r['aiProbability'] as num?)?.toDouble() ?? 0,
775:         '_aiJust': just,
776:         '_aiFato': fact,
777:         '_aiConfirmado': true,
778:         '_aiContextStatus': r['contextStatus'] as String? ?? 'unknown',
779:         '_aiContextReason': r['contextReason'] as String? ?? '',
780:       });
781:     }
782: 
783:     if (result.isEmpty) {
784:       return top
785:           .map((p) => {
786:                 ...p,
787:                 '_aiRank': 999,
788:                 '_aiProb': 0,
789:                 '_aiJust': 'Sem validação externa disponível',
790:                 '_aiFato': 'Sem fonte externa',
791:                 '_aiConfirmado': false,
792:                 '_aiContextStatus': 'unknown',
793:                 '_aiContextReason': 'Gemini não encontrou informação relevante',
794:               })
795:           .toList();
796:     }
797: 
798:     // ORDENAÇÃO FINAL CORRETA
799: 
800:     double _get(Map m, String k) => (m[k] as num?)?.toDouble() ?? 0;
801: 
802:     result.sort((a, b) {
803:       final aNeg = a['_aiContextStatus'] == 'negative';
804:       final bNeg = b['_aiContextStatus'] == 'negative';
805: 
806:       // negative sempre por último
807:       if (aNeg != bNeg) return aNeg ? 1 : -1;
808: 
809:       final aEv = _get(a, 'edge') * _get(a, '_probCalibrada');
810:       final bEv = _get(b, 'edge') * _get(b, '_probCalibrada');
811: 
812:       if (aEv != bEv) return bEv.compareTo(aEv);
813: 
814:       final aScore = _get(a, '_scoreFinal');
815:       final bScore = _get(b, '_scoreFinal');
816: 
817:       if (aScore != bScore) return bScore.compareTo(aScore);
818: 
819:       final aKelly = _get(a, 'kelly');
820:       final bKelly = _get(b, 'kelly');
821: 
822:       return bKelly.compareTo(aKelly);
823:     });
824: 
825: // LIMITE FINAL
826:     return result.take(20).toList();
827:   }
828: 
829:   // ── JSON parsing robusto ─────────────────────────────────────────────────
830: 
831:   static List? _parseJsonList(String text) {
832:     if (text.trim().isEmpty) return null;
833: 
834:     // 1. Tenta diretamente (responseMimeType garante JSON puro)
835:     try {
836:       final decoded = jsonDecode(text.trim());
837:       if (decoded is List) return decoded;
838:     } catch (_) {}
839: 
840:     // 2. Remove marcadores de citação do grounding: [1], [2], etc.
841:     final cleaned = text.replaceAll(RegExp(r'\[\d+\]'), '').trim();
842: 
843:     // 3. Extrai de bloco markdown ```json ... ``` ou ``` ... ```
844:     final codeBlock =
845:         RegExp(r'```(?:json)?\s*([\s\S]*?)\s*```').firstMatch(cleaned);
846:     if (codeBlock != null) {
847:       try {
848:         final decoded = jsonDecode(codeBlock.group(1)!.trim());
849:         if (decoded is List) return decoded;
850:       } catch (_) {}
851:     }
852: 
853:     // 4. Extrai primeiro array JSON do texto
854:     final arrayMatch = RegExp(r'\[[\s\S]*\]').firstMatch(cleaned);
855:     if (arrayMatch != null) {
856:       try {
857:         final decoded = jsonDecode(arrayMatch.group(0)!);
858:         if (decoded is List) return decoded;
859:       } catch (_) {}
860:     }
861: 
862:     // 5. Tenta de [ até o último ]
863:     final first = cleaned.indexOf('[');
864:     final last = cleaned.lastIndexOf(']');
865:     if (first != -1 && last > first) {
866:       try {
867:         final decoded = jsonDecode(cleaned.substring(first, last + 1));
868:         if (decoded is List) return decoded;
869:       } catch (_) {}
870:     }
871: 
872:     return null;
873:   }
