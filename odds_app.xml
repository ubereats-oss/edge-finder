552:   static Future<String> _fetchEspnNews(String sport) async {
553:     final sl = sport.toLowerCase();
554:     final String sportPath;
555:     if (sl.contains('beisebol') || sl.contains('mlb')) {
556:       sportPath = 'baseball/mlb';
557:     } else if (sl.contains('nhl') || sl.contains('hockey')) {
558:       sportPath = 'hockey/nhl';
559:     } else if (sl.contains('nfl') || sl.contains('americano')) {
560:       sportPath = 'football/nfl';
561:     } else if (sl.contains('tênis') || sl.contains('tennis')) {
562:       sportPath = 'tennis/atp';
563:     } else {
564:       sportPath = 'basketball/nba';
565:     }
566:     try {
567:       final url =
568:           'https://site.api.espn.com/apis/site/v2/sports/$sportPath/news?limit=30';
569:       final res =
570:           await http.get(Uri.parse(url)).timeout(const Duration(seconds: 8));
571:       if (res.statusCode != 200) return '';
572:       final body = jsonDecode(res.body) as Map<String, dynamic>;
573:       final articles = body['articles'] as List? ?? [];
574:       final headlines = articles
575:           .take(25)
576:           .map((a) {
577:             final headline = a['headline'] as String? ?? '';
578:             final desc = a['description'] as String? ?? '';
579:             return desc.isNotEmpty ? '$headline — $desc' : headline;
580:           })
581:           .where((h) => h.isNotEmpty)
582:           .join('\n');
583:       return headlines;
584:     } catch (_) {
585:       return '';
586:     }
587:   }
