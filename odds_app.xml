 80: // Gera o range de datas a buscar a partir do dia seguinte ao último processado
 81: function getIncrementalRange(lastDate) {
 82:   const last = new Date(lastDate);
 83:   // Recomeça 2 dias antes para cobrir jogos que terminaram após meia-noite UTC
 84:   last.setDate(last.getDate() - 2);
 85:   const start = last.toISOString().slice(0, 10).replace(/-/g, '');
 86: 
 87:   const today = new Date();
 88:   const end = today.toISOString().slice(0, 10).replace(/-/g, '');
 89: 
 90:   // Detecta a temporada pelo mês/ano
 91:   const year = parseInt(start.slice(0, 4));
 92:   const month = parseInt(start.slice(4, 6));
 93:   const season = month >= 10 ? year + 1 : year;
 94: 
 95:   return [{ start, end, season }];
 96: }
