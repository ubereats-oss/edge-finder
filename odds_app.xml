 98: async function fetchEventIds(start, end) {
 99:   const url = `https://site.api.espn.com/apis/site/v2/sports/basketball/nba/scoreboard?limit=200&dates=${start}-${end}`;
100:   const res = await axios.get(url);
101:   return (res.data.events || [])
102:     .filter(e => e.competitions[0].status.type.completed)
103:     .map(e => {
104:       const comp = e.competitions[0];
105:       const home = comp.competitors.find(c => c.homeAway === 'home');
106:       const away = comp.competitors.find(c => c.homeAway === 'away');
107:       const homeScore = parseInt(home?.score) || 0;
108:       const awayScore = parseInt(away?.score) || 0;
109:       const periods = comp.linescores?.length || 0;
110:       return {
111:         id: e.id,
112:         date: e.date,
113:         seasonType: e.season?.type === 3 ? 'playoffs' : 'regular',
114:         season: e.season?.year,
115:         homeTeam: home?.team?.displayName,
116:         awayTeam: away?.team?.displayName,
117:         homeScore,
118:         awayScore,
119:         blowout: Math.abs(homeScore - awayScore) >= 20,
120:         isOvertime: periods > 4,
121:         homeWon: home?.winner === true,
122:       };
123:     });
124: }
