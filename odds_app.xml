313:   let brierSum = 0, correct = 0;
314:   for (const p of predictions) {
315:     const prob    = p.prob / 100;
316:     const outcome = p.won ? 1 : 0;
317:     brierSum += Math.pow(prob - outcome, 2);
318:     if (p.won) correct++;
319:     const key = (Math.floor(prob / 0.05) * 0.05).toFixed(2);
320:     if (buckets[key]) {
321:       buckets[key].predicted += prob;
322:       buckets[key].actual    += outcome;
323:       buckets[key].n++;
324:     }
325:   }
326: 
327:   const accuracy   = correct / predictions.length;
328:   const brierScore = brierSum / predictions.length;
329: 
330:   // ── ROI ────────────────────────────────────────────────────────────────────
331:   const bestByMarket = {};
332:   for (const p of predictions) {
333:     const key = `${p.date}|${p.player}|${p.stat}`;
334:     if (!bestByMarket[key] || Math.abs(p.edge) > Math.abs(bestByMarket[key].edge)) {
335:       bestByMarket[key] = p;
336:     }
337:   }
338: 
339:   const bets = Object.values(bestByMarket).sort((a, b) => a.date.localeCompare(b.date));
340: 
341:   let bankroll = BANKROLL_START, peak = BANKROLL_START, maxDrawdown = 0;
342:   let totalWagered = 0, totalReturn = 0, wins = 0, losses = 0;
343:   const bankrollHistory = [bankroll];
344: 
345:   const edgeBuckets = {
346:     '0-5%':   { bets: 0, wins: 0, wagered: 0, returned: 0 },
347:     '5-10%':  { bets: 0, wins: 0, wagered: 0, returned: 0 },
348:     '10-15%': { bets: 0, wins: 0, wagered: 0, returned: 0 },
349:     '15%+':   { bets: 0, wins: 0, wagered: 0, returned: 0 },
350:   };
351: 
352:   const statBreakdown = {};
353:   for (const stat of STAT_KEYS) statBreakdown[stat] = { bets: 0, wins: 0, wagered: 0, returned: 0 };
354: 
355:   const surfaceBreakdown = {};
356:   for (const surf of [...SURFACES, 'all']) surfaceBreakdown[surf] = { bets: 0, wins: 0, wagered: 0, returned: 0 };
357: 
358:   for (const p of bets) {
359:     if (!isFinite(p.mktOdd) || p.mktOdd <= 1) continue;
360:     const stake = Math.min(BANKROLL_START * (p.kellyFrac / 100), FLAT_STAKE_CAP);
361:     if (stake <= 0) continue;
362: 
363:     totalWagered += stake;
364:     const eKey = p.edge < 5 ? '0-5%' : p.edge < 10 ? '5-10%' : p.edge < 15 ? '10-15%' : '15%+';
365:     edgeBuckets[eKey].bets++;
366:     edgeBuckets[eKey].wagered += stake;
367:     statBreakdown[p.stat].bets++;
368:     statBreakdown[p.stat].wagered += stake;
369:     if (surfaceBreakdown[p.surface]) {
370:       surfaceBreakdown[p.surface].bets++;
371:       surfaceBreakdown[p.surface].wagered += stake;
372:     }
373: 
374:     if (p.won) {
375:       const profit = stake * (p.mktOdd - 1);
376:       bankroll    += profit;
377:       totalReturn += profit;
378:       wins++;
379:       edgeBuckets[eKey].returned    += profit;
380:       edgeBuckets[eKey].wins++;
381:       statBreakdown[p.stat].returned += profit;
382:       statBreakdown[p.stat].wins++;
383:       if (surfaceBreakdown[p.surface]) {
384:         surfaceBreakdown[p.surface].returned += profit;
385:         surfaceBreakdown[p.surface].wins++;
386:       }
387:     } else {
388:       bankroll    -= stake;
389:       totalReturn -= stake;
390:       losses++;
391:       edgeBuckets[eKey].returned    -= stake;
392:       statBreakdown[p.stat].returned -= stake;
393:       if (surfaceBreakdown[p.surface]) {
394:         surfaceBreakdown[p.surface].returned -= stake;
395:       }
396:     }
397: 
398:     if (bankroll > peak) peak = bankroll;
399:     const dd = (peak - bankroll) / peak;
400:     if (dd > maxDrawdown) maxDrawdown = dd;
401:     bankrollHistory.push(parseFloat(bankroll.toFixed(2)));
402:   }
403: 
404:   const roi     = totalWagered > 0 ? totalReturn / totalWagered : 0;
405:   const winRate = (wins + losses) > 0 ? wins / (wins + losses) : 0;
406: 
407:   // ── Output ─────────────────────────────────────────────────────────────────
408:   console.log('══════════════════════════════════════════');
409:   console.log('BACKTESTING TENNIS PROPS v1');
410:   console.log(`Split: base < ${DATA_SPLIT} | walk-forward ≥ ${DATA_SPLIT}`);
411:   console.log(`Mercado: média simples histórica por superfície | Modelo: média ponderada walk-forward`);
412:   console.log(`Filtros: sem walkover (sets=0 e games=0)`);
413:   console.log(`Kelly: ${KELLY_FRACTION * 100}% | Vig: ${HOUSE_MARGIN * 100}% | Min jogos mkt surf: ${MIN_GAMES_MKT_SURFACE} | Min jogos mkt all: ${MIN_GAMES_MKT_ALL} | Min jogos modelo: ${MIN_GAMES_MODEL}`);
414:   console.log('══════════════════════════════════════════');
415:   console.log(`Props totais       : ${predictions.length}`);
416:   console.log(`Acurácia           : ${(accuracy * 100).toFixed(1)}%`);
417:   console.log(`Brier Score        : ${brierScore.toFixed(4)}`);
418:   console.log('');
419:   console.log('Calibração por faixa:');
420:   console.log('  Faixa      | N      | Pred%  | Real%  | Desvio');
421:   console.log('  -----------|--------|--------|--------|--------');
422:   for (const [key, b] of Object.entries(buckets)) {
423:     if (b.n < 10) continue;
424:     const pred  = (b.predicted / b.n * 100).toFixed(1);
425:     const real  = (b.actual    / b.n * 100).toFixed(1);
426:     const dev   = ((b.predicted / b.n - b.actual / b.n) * 100).toFixed(1);
427:     const sinal = parseFloat(dev) > 0 ? '+' : '';
428:     console.log(`  ${key}-${(parseFloat(key) + 0.05).toFixed(2)} | ${String(b.n).padStart(6)} | ${pred.padStart(5)}% | ${real.padStart(5)}% | ${sinal}${dev}%`);
429:   }
430:   console.log('');
431:   console.log('══════════════════════════════════════════');
432:   console.log('SIMULAÇÃO DE ROI');
433:   console.log('══════════════════════════════════════════');
434:   console.log(`Mercados únicos    : ${bets.length}`);
435:   console.log(`Vitórias / Derrotas: ${wins} / ${losses} (${(winRate * 100).toFixed(1)}%)`);
436:   console.log(`Banca final        : ${bankroll.toFixed(2)} u`);
437:   console.log(`ROI                : ${(roi * 100).toFixed(2)}%`);
438:   console.log(`Max Drawdown       : ${(maxDrawdown * 100).toFixed(1)}%`);
439:   console.log('');
440:   console.log('ROI por faixa de edge:');
441:   console.log('  Faixa   | Apostas | Win%   | ROI');
442:   console.log('  --------|---------|--------|--------');
443:   for (const [faixa, b] of Object.entries(edgeBuckets)) {
444:     if (b.bets === 0) continue;
445:     const wp = (b.wins / b.bets * 100).toFixed(1);
446:     const r  = b.wagered > 0 ? (b.returned / b.wagered * 100).toFixed(2) : 'n/a';
447:     const s  = parseFloat(r) >= 0 ? '+' : '';
448:     console.log(`  ${faixa.padEnd(7)} | ${String(b.bets).padStart(7)} | ${wp.padStart(5)}% | ${s}${r}%`);
449:   }
450:   console.log('');
451:   console.log('ROI por tipo de stat:');
452:   console.log('  Stat        | Apostas | Win%   | ROI');
453:   console.log('  ------------|---------|--------|--------');
454:   for (const [stat, b] of Object.entries(statBreakdown)) {
455:     if (b.bets === 0) continue;
456:     const wp = (b.wins / b.bets * 100).toFixed(1);
457:     const r  = b.wagered > 0 ? (b.returned / b.wagered * 100).toFixed(2) : 'n/a';
458:     const s  = parseFloat(r) >= 0 ? '+' : '';
459:     console.log(`  ${stat.padEnd(11)} | ${String(b.bets).padStart(7)} | ${wp.padStart(5)}% | ${s}${r}%`);
460:   }
461:   console.log('');
462:   console.log('ROI por superfície:');
463:   console.log('  Superfície   | Apostas | Win%   | ROI');
464:   console.log('  -------------|---------|--------|--------');
465:   for (const [surf, b] of Object.entries(surfaceBreakdown)) {
466:     if (b.bets === 0) continue;
467:     const wp = (b.wins / b.bets * 100).toFixed(1);
468:     const r  = b.wagered > 0 ? (b.returned / b.wagered * 100).toFixed(2) : 'n/a';
469:     const s  = parseFloat(r) >= 0 ? '+' : '';
470:     console.log(`  ${surf.padEnd(12)} | ${String(b.bets).padStart(7)} | ${wp.padStart(5)}% | ${s}${r}%`);
471:   }
472: 
473:   fs.writeFileSync('tennis_props_backtest_results.json', JSON.stringify({
474:     version: 1,
475:     config: {
476:       dataSplit: DATA_SPLIT,
477:       kellyFraction: KELLY_FRACTION,
478:       houseMargin: HOUSE_MARGIN,
479:       minGamesMktSurface: MIN_GAMES_MKT_SURFACE,
480:       minGamesMktAll: MIN_GAMES_MKT_ALL,
481:       minGamesModel: MIN_GAMES_MODEL,
482:       decay: DECAY,
483:       filters: ['no_walkover'],
484:     },
485:     summary: {
486:       totalProps: predictions.length,
487:       skipped,
488:       walkovers,
489:       accuracy: parseFloat((accuracy * 100).toFixed(2)),
490:       brierScore: parseFloat(brierScore.toFixed(4)),
491:       uniqueMarkets: bets.length,
492:       wins, losses,
493:       winRate: parseFloat((winRate * 100).toFixed(2)),
494:       bankrollFinal: parseFloat(bankroll.toFixed(2)),
495:       roi: parseFloat((roi * 100).toFixed(2)),
496:       maxDrawdown: parseFloat((maxDrawdown * 100).toFixed(2)),
497:     },
498:     calibration: Object.fromEntries(
499:       Object.entries(buckets)
500:         .filter(([, b]) => b.n > 0)
501:         .map(([key, b]) => [key, {
502:           n: b.n,
503:           predictedPct: parseFloat((b.predicted / b.n * 100).toFixed(1)),
504:           actualPct:    parseFloat((b.actual    / b.n * 100).toFixed(1)),
505:         }])
506:     ),
507:     edgeBreakdown: edgeBuckets,
508:     statBreakdown,
509:     surfaceBreakdown,
510:     bankrollHistory,
511:   }, null, 2));
512: 
513:   console.log('\ntennis_props_backtest_results.json salvo.');
514: }
515: 
516: main();
