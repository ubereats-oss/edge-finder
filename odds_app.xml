 14: const db = admin.firestore();
 15: 
 16: const ROOT = path.join(__dirname, '..');
 17: 
 18: const SYNC_MAP = [
 19:   { file: 'model_results.json',        col: 'results', doc: 'tennis' },
 20:   { file: 'nba_results.json',          col: 'results', doc: 'nba_h2h' },
 21:   { file: 'nba_props_results.json',    col: 'results', doc: 'nba_props' },
 22:   { file: 'nba_props_br_results.json', col: 'results', doc: 'nba_props_br' },
 23:   { file: 'mlb_results.json',          col: 'results', doc: 'mlb_h2h' },
 24:   { file: 'mlb_props_results.json',    col: 'results', doc: 'mlb_props' },
 25:   { file: 'nhl_props_results.json',    col: 'results', doc: 'nhl_props' },
 26:   { file: 'nfl_props_results.json',    col: 'results', doc: 'nfl_props' },
 27:   { file: 'tennis_props_results.json', col: 'results', doc: 'tennis_props' },
 28: ];
 29: 
 30: async function syncAll() {
 31:   let synced = 0;
 32:   let skipped = 0;
 33: 
 34:   for (const { file, col, doc } of SYNC_MAP) {
 35:     const filePath = path.join(ROOT, file);
 36:     if (!fs.existsSync(filePath)) {
 37:       console.log(`  Pulando ${file} — não encontrado`);
 38:       skipped++;
 39:       continue;
 40:     }
 41: 
 42:     try {
 43:       const raw = JSON.parse(fs.readFileSync(filePath));
 44:       const data = Array.isArray(raw) ? raw : (raw.data || []);
 45:       const stat = fs.statSync(filePath);
 46: 
 47:       await db.collection(col).doc(doc).set({
 48:         data,
 49:         lastUpdated: stat.mtime.toISOString(),
 50:         updatedAt: admin.firestore.FieldValue.serverTimestamp(),
 51:       });
 52: 
 53:       console.log(`  ✅ ${file} → ${col}/${doc} (${data.length} itens)`);
 54:       synced++;
 55:     } catch (e) {
 56:       console.error(`  ❌ Erro ao sincronizar ${file}:`, e.message);
 57:     }
 58:   }
 59: 
 60:   console.log(`\nSync concluído: ${synced} arquivos sincronizados, ${skipped} pulados.`);
 61: }
 62: 
 63: async function syncBets() {
 64:   const filePath = path.join(ROOT, 'bets.json');
 65:   if (!fs.existsSync(filePath)) {
 66:     console.log('  Pulando bets.json — não encontrado');
 67:     return;
 68:   }
 69: 
 70:   try {
 71:     const bets = JSON.parse(fs.readFileSync(filePath));
 72:     const batch = db.batch();
 73: 
 74:     for (const bet of bets) {
 75:       const ref = db.collection('bets').doc(bet.id);
 76:       batch.set(ref, bet);
 77:     }
 78: 
 79:     await batch.commit();
 80:     console.log(`  ✅ bets.json → bets (${bets.length} apostas)`);
 81:   } catch (e) {
 82:     console.error('  ❌ Erro ao sincronizar bets.json:', e.message);
 83:   }
 84: }
 85: 
 86: async function syncOddsHistory() {
 87:   const histDir = path.join(ROOT, 'odds_history');
 88:   if (!fs.existsSync(histDir)) {
 89:     console.log('  Pulando odds_history — pasta não encontrada');
 90:     return;
 91:   }
 92: 
 93:   const files = fs.readdirSync(histDir).filter(f => f.endsWith('.json') && !f.startsWith('_'));
 94:   let synced = 0;
 95: 
 96:   for (const file of files) {
 97:     try {
 98:       const raw = JSON.parse(fs.readFileSync(path.join(histDir, file)));
 99:       const baseId = file.replace('.json', '');
100: 
101:       const CHUNK = 300;
102:       if (raw.length <= CHUNK) {
103:         await db.collection('odds_history').doc(baseId).set({
104:           data: raw,
105:           updatedAt: admin.firestore.FieldValue.serverTimestamp(),
106:         });
107:         synced++;
108:       } else {
109:         for (let i = 0; i * CHUNK < raw.length; i++) {
110:           const chunk = raw.slice(i * CHUNK, (i + 1) * CHUNK);
111:           const docId = `${baseId}_p${i}`;
112:           await db.collection('odds_history').doc(docId).set({
113:             data: chunk,
114:             updatedAt: admin.firestore.FieldValue.serverTimestamp(),
115:           });
116:           synced++;
117:         }
118:       }
119:     } catch (e) {
120:       console.error(`  ❌ Erro ao sincronizar odds_history/${file}:`, e.message);
121:     }
122:   }
123: 
124:   console.log(`  ✅ odds_history → Firestore (${synced} documentos)`);
125: }
126: 
127: async function main() {
128:   console.log('Iniciando sincronização com Firestore...\n');
129: 
130:   const args = process.argv.slice(2);
131:   const syncType = args[0] || 'all';
132: 
133:   if (syncType === 'all' || syncType === 'results') await syncAll();
134:   if (syncType === 'all' || syncType === 'bets') await syncBets();
135:   if (syncType === 'all' || syncType === 'history') await syncOddsHistory();
136: 
137:   if (['nhl', 'nfl', 'tennis_props'].includes(syncType)) {
138:     const fileMap = {
139:       nhl:          { file: 'nhl_props_results.json',    col: 'results', doc: 'nhl_props' },
140:       nfl:          { file: 'nfl_props_results.json',    col: 'results', doc: 'nfl_props' },
141:       tennis_props: { file: 'tennis_props_results.json', col: 'results', doc: 'tennis_props' },
142:     };
143:     const entry = fileMap[syncType];
144:     const filePath = path.join(ROOT, entry.file);
145:     if (fs.existsSync(filePath)) {
146:       const raw = JSON.parse(fs.readFileSync(filePath));
147:       const data = Array.isArray(raw) ? raw : (raw.data || []);
148:       const stat = fs.statSync(filePath);
149:       await db.collection(entry.col).doc(entry.doc).set({
150:         data,
151:         lastUpdated: stat.mtime.toISOString(),
152:         updatedAt: admin.firestore.FieldValue.serverTimestamp(),
153:       });
154:       console.log(`  ✅ ${entry.file} → ${entry.col}/${entry.doc} (${data.length} itens)`);
155:     } else {
156:       console.log(`  Pulando ${entry.file} — não encontrado`);
157:     }
158:   }
159: 
160:   console.log('\nSincronização concluída.');
161:   process.exit(0);
162: }
163: 
164: main().catch(e => {
165:   console.error('Erro fatal:', e);
166:   process.exit(1);
167: });
