 410:   static Future<Map<String, Map<String, String>>> _fetchInjuries(
 411:       String sport) async {
 412:     final now = DateTime.now();
 413:     if (_injuryCache.containsKey(sport) &&
 414:         now.difference(_injuryCacheTime[sport]!) < _cacheTtl) {
 415:       return _injuryCache[sport]!;
 416:     }
 417:     final path = _injurySportPath(sport);
 418:     try {
 419:       final res = await http
 420:           .get(Uri.parse(
 421:               'https://site.api.espn.com/apis/site/v2/sports/$path/injuries'))
 422:           .timeout(const Duration(seconds: 8));
 423:       if (res.statusCode != 200) return {};
 424:       final body = jsonDecode(res.body) as Map<String, dynamic>;
 425:       final teams = body['teams'] as List? ?? [];
 426:       final result = <String, Map<String, String>>{};
 427:       for (final t in teams) {
 428:         final teamName =
 429:             (t['team']?['displayName'] as String? ?? '').toLowerCase();
 430:         final injuries = t['injuries'] as List? ?? [];
 431:         for (final inj in injuries) {
 432:           final name =
 433:               (inj['athlete']?['displayName'] as String? ?? '').toLowerCase();
 434:           if (name.isEmpty) continue;
 435:           final status = inj['status'] as String? ??
 436:               inj['type']?['abbreviation'] as String? ??
 437:               '';
 438:           final detail = inj['details']?['type'] as String? ?? '';
 439:           result[name] = {'status': status, 'detail': detail, 'team': teamName};
 440:         }
 441:       }
 442:       _injuryCache[sport] = result;
 443:       _injuryCacheTime[sport] = now;
 444:       return result;
 445:     } catch (_) {
 446:       return {};
 447:     }
 448:   }
