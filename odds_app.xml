126: async function fetchBoxScore(eventId) {
127:   const url = `https://site.api.espn.com/apis/site/v2/sports/basketball/nba/summary?event=${eventId}`;
128:   const res = await axios.get(url);
129:   return {
130:     players: res.data.boxscore?.players || [],
131:     teamStats: res.data.boxscore?.teams || [],
132:   };
133: }
