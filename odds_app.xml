 600:     if (b['type'] == 'h2h') {
 601:       return b['team'] as String? ?? b['game'] as String? ?? '';
 602:     }
 603:     final player = b['player'] as String? ?? '';
 604:     final prop = b['prop'] as String? ?? '';
 605:     final statName = _statFullName[prop] ?? prop;
 606:     final side = b['side'] as String? ?? 'Over';
 607:     final sidePt = side == 'Over' ? 'Mais de' : 'Menos de';
 608:     final line = b['line'];
 609:     final propPt = _propLabel(prop);
 610:     return '$player - $statName\n$sidePt +$line $propPt';
 611:   }
