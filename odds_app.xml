 25: const STAT_KEYS = ['passYards', 'passTDs', 'rushYards', 'receptions', 'receptionYards', 'fantasyPoints'];
 26: 
 27: function sleep(ms) {
 28:   return new Promise(resolve => setTimeout(resolve, ms));
 29: }
 30: 
 31: function emptyContext() {
 32:   const obj = { games: 0 };
 33:   for (const k of STAT_KEYS) obj[k] = [];
 34:   return obj;
 35: }
 36: 
 37: function ensurePath(raw, player, season, gameType, location) {
 38:   if (!raw[player]) raw[player] = {};
 39:   if (!raw[player][season]) raw[player][season] = {};
 40:   if (!raw[player][season][gameType]) {
 41:     raw[player][season][gameType] = { home: emptyContext(), away: emptyContext() };
 42:   }
 43:   return raw[player][season][gameType][location];
 44: }
 45: 
 46: function getLastProcessedDate(existing) {
 47:   let latest = null;
 48:   for (const playerData of Object.values(existing)) {
 49:     for (const seasonData of Object.values(playerData)) {
 50:       for (const gameTypeData of Object.values(seasonData)) {
 51:         for (const loc of ['home', 'away']) {
 52:           const ctx = gameTypeData[loc];
 53:           if (!ctx) continue;
 54:           for (const entries of Object.values(ctx)) {
 55:             if (!Array.isArray(entries)) continue;
 56:             for (const entry of entries) {
 57:               if (entry.date && (!latest || entry.date > latest)) latest = entry.date;
 58:             }
 59:           }
 60:         }
 61:       }
 62:     }
 63:   }
 64:   return latest;
 65: }
 66: 
 67: function getIncrementalRange(lastDate) {
 68:   const last = new Date(lastDate);
 69:   last.setDate(last.getDate() - 2);
 70:   const start = last.toISOString().slice(0, 10).replace(/-/g, '');
 71:   const end = new Date().toISOString().slice(0, 10).replace(/-/g, '');
 72:   const year = parseInt(start.slice(0, 4));
 73:   const month = parseInt(start.slice(4, 6));
 74:   const season = month >= 9 ? year + 1 : year;
 75:   return [{ start, end, season }];
 76: }
