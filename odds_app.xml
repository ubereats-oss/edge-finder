104: // ── Extrai match records de tennis_player_stats.json ──────────────────────────
105: // Schema: { PlayerName: { surface: { sets: [{value, date, opponent}], games: [...] } } }
106: // Cada record representa uma partida individual de um jogador.
107: function extractMatchRecords(playerStats) {
108:   const records = [];
109:   for (const [playerName, playerData] of Object.entries(playerStats)) {
110:     for (const [surface, surfData] of Object.entries(playerData)) {
111:       const setsArr  = surfData.sets  || [];
112:       const gamesArr = surfData.games || [];
113:       const n = Math.min(setsArr.length, gamesArr.length);
114:       for (let i = 0; i < n; i++) {
115:         const se = setsArr[i];
116:         const ge = gamesArr[i];
117:         if (!se || !ge) continue;
118:         records.push({
119:           playerName,
120:           surface,
121:           date:     se.date || '',
122:           opponent: se.opponent || '',
123:           stats: {
124:             sets:  se.value ?? 0,
125:             games: ge.value ?? 0,
126:           },
127:         });
128:       }
129:     }
130:   }
131:   return records.sort((a, b) => a.date.localeCompare(b.date));
132: }
133: 
134: // ── Seleciona linha de maior |edge| entre as candidatas ───────────────────────
135: // Sets: linha fixa 1.5; se avg > 2.0 também testa 2.5
136: // Games: Math.round(avg) + 0.5
137: function selectBestLine(stat, mktProfile, modelProfile) {
138:   const candidates = stat === 'sets'
139:     ? (mktProfile.avg > 2.0 ? [1.5, 2.5] : [1.5])
140:     : [Math.round(mktProfile.avg) + 0.5];
141: 
142:   let best = null;
143:   for (const line of candidates) {
144:     const mktPO = probOver(mktProfile.avg, mktProfile.std, line);
145:     const mktPU = probUnder(mktProfile.avg, mktProfile.std, line);
146:     if (mktPO <= 0 || mktPU <= 0) continue;
147:     const mktOO = marketOdd(mktPO);
148:     const mktOU = marketOdd(mktPU);
149:     if (!mktOO || !mktOU || !isFinite(mktOO) || !isFinite(mktOU)) continue;
150: 
151:     const pO = calibrate(probOver(modelProfile.avg, modelProfile.std, line));
152:     const pU = calibrate(probUnder(modelProfile.avg, modelProfile.std, line));
153: 
154:     const edgeO = pO - mktPO;
155:     const edgeU = pU - mktPU;
156:     const bestSide = edgeO >= edgeU ? 'Over' : 'Under';
157:     const bestEdge = edgeO >= edgeU ? edgeO : edgeU;
158:     const bestProb = edgeO >= edgeU ? pO : pU;
159:     const bestOdd  = edgeO >= edgeU ? mktOO : mktOU;
160: 
161:     if (!best || Math.abs(bestEdge) > Math.abs(best.bestEdge)) {
162:       best = { line, mktOO, mktOU, pO, pU, edgeO, edgeU, bestSide, bestEdge, bestProb, bestOdd };
163:     }
164:   }
165:   return best;
166: }
