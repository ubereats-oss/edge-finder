  1: const fs = require('fs');
  2: 
  3: const playerStats = JSON.parse(fs.readFileSync('nba_player_stats.json'));
  4: const props = JSON.parse(fs.readFileSync('nba_props.json'));
  5: 
  6: const SEASON_WEIGHT = { 2024: 1, 2025: 2, 2026: 3 };
  7: const MIN_GAMES_CONTEXT = 10;
  8: const INEFFICIENT_MARKET_EDGE = 20;
  9: const KELLY_FRACTION = 0.25;
 10: 
 11: // ── Calibração isotônica (derivada do backtest walk-forward) ───────────────────
 12: // Tabela: probabilidade bruta (mid do bucket) → taxa real observada
 13: // Fonte: backtest_nba_props.js sobre temporada 2025-26
 14: const CALIB_TABLE = [
 15:   { raw: 0.525, cal: 0.500 },
 16:   { raw: 0.575, cal: 0.534 },
 17:   { raw: 0.625, cal: 0.577 },
 18:   { raw: 0.675, cal: 0.618 },
 19:   { raw: 0.725, cal: 0.655 },
 20:   { raw: 0.775, cal: 0.687 },
 21:   { raw: 0.825, cal: 0.721 },
 22:   { raw: 0.875, cal: 0.760 },
 23:   { raw: 0.925, cal: 0.813 },
 24:   { raw: 0.975, cal: 0.818 },
 25: ];
 26: 
 27: // Interpola linearmente na tabela; fora do range usa extrapolação linear das bordas
 28: function calibrate(p) {
 29:   // Para prob < 0.5: calibrar o complemento e retornar complemento
 30:   if (p < 0.5) return 1 - calibrate(1 - p);
 31: 
 32:   const n = CALIB_TABLE.length;
 33:   if (p <= CALIB_TABLE[0].raw) {
 34:     // Extrapolação abaixo: inclinação da primeira aresta
 35:     const slope = (CALIB_TABLE[1].cal - CALIB_TABLE[0].cal) /
 36:                   (CALIB_TABLE[1].raw - CALIB_TABLE[0].raw);
 37:     return Math.min(1, Math.max(0, CALIB_TABLE[0].cal + slope * (p - CALIB_TABLE[0].raw)));
 38:   }
 39:   if (p >= CALIB_TABLE[n - 1].raw) {
 40:     // Extrapolação acima: inclinação da última aresta
 41:     const slope = (CALIB_TABLE[n - 1].cal - CALIB_TABLE[n - 2].cal) /
 42:                   (CALIB_TABLE[n - 1].raw - CALIB_TABLE[n - 2].raw);
 43:     return Math.min(1, Math.max(0, CALIB_TABLE[n - 1].cal + slope * (p - CALIB_TABLE[n - 1].raw)));
 44:   }
 45:   // Interpolação linear entre os dois pontos adjacentes
 46:   for (let i = 0; i < n - 1; i++) {
 47:     if (p >= CALIB_TABLE[i].raw && p <= CALIB_TABLE[i + 1].raw) {
 48:       const t = (p - CALIB_TABLE[i].raw) / (CALIB_TABLE[i + 1].raw - CALIB_TABLE[i].raw);
 49:       return CALIB_TABLE[i].cal + t * (CALIB_TABLE[i + 1].cal - CALIB_TABLE[i].cal);
 50:     }
 51:   }
 52:   return p;
 53: }
 54: 
 55: // ── Distribuição normal ────────────────────────────────────────────────────────
 56: 
 57: function erf(x) {
 58:   const sign = x >= 0 ? 1 : -1;
 59:   x = Math.abs(x);
 60:   const a1 = 0.254829592, a2 = -0.284496736, a3 = 1.421413741;
 61:   const a4 = -1.453152027, a5 = 1.061405429, p = 0.3275911;
 62:   const t = 1 / (1 + p * x);
 63:   const y = 1 - (((((a5 * t + a4) * t) + a3) * t + a2) * t + a1) * t * Math.exp(-x * x);
 64:   return sign * y;
 65: }
 66: 
 67: function normalCDF(x, mu, sigma) {
 68:   if (sigma <= 0) return x >= mu ? 1 : 0;
 69:   return 0.5 * (1 + erf((x - mu) / (sigma * Math.sqrt(2))));
 70: }
 71: 
 72: function probOverRaw(mu, sigma, line) { return 1 - normalCDF(line, mu, sigma); }
 73: function probUnderRaw(mu, sigma, line) { return normalCDF(line, mu, sigma); }
 74: 
 75: function calcKelly(p, odd) {
 76:   const b = odd - 1;
 77:   const q = 1 - p;
 78:   const kelly = (p * b - q) / b;
 79:   return Math.max(0, parseFloat((kelly * KELLY_FRACTION * 100).toFixed(2)));
 80: }
 81: 
 82: // ── Stats ──────────────────────────────────────────────────────────────────────
 83: 
 84: function combineContexts(playerData, statKey, locations, gameTypes) {
 85:   let weightedSum = 0;
 86:   let weightedSumSq = 0;
 87:   let totalWeight = 0;
 88:   let totalGames = 0;
 89:   let contextGames = 0;
 90: 
 91:   for (const [seasonStr, seasonData] of Object.entries(playerData)) {
 92:     const season = parseInt(seasonStr);
 93:     const w = SEASON_WEIGHT[season] || 1;
 94: 
 95:     for (const gameType of gameTypes) {
 96:       for (const location of locations) {
 97:         const ctx = seasonData?.[gameType]?.[location];
 98:         if (!ctx || !ctx[statKey] || !Array.isArray(ctx[statKey])) continue;
 99: 
100:         for (const v of ctx[statKey]) {
101:           weightedSum += v * w;
102:           weightedSumSq += v * v * w;
103:           totalWeight += w;
104:           totalGames++;
105:           if (season === 2026) contextGames++;
106:         }
107:       }
108:     }
109:   }
110: 
111:   if (totalWeight === 0) return null;
112: 
113:   const avg = weightedSum / totalWeight;
114:   const variance = Math.max(0, weightedSumSq / totalWeight - avg * avg);
115: 
116:   return {
117:     avg: parseFloat(avg.toFixed(2)),
118:     std: parseFloat(Math.sqrt(variance).toFixed(2)),
119:     totalGames,
120:     contextGames,
121:     lowSample: contextGames < MIN_GAMES_CONTEXT,
122:   };
123: }
124: 
125: function findPlayer(name) {
126:   if (playerStats[name]) return playerStats[name];
127:   const lower = name.toLowerCase();
128:   for (const key of Object.keys(playerStats)) {
129:     if (key.toLowerCase().includes(lower) || lower.includes(key.toLowerCase())) {
130:       return playerStats[key];
131:     }
132:   }
133:   return null;
134: }
135: 
136: const PROP_MAP = {
137:   points: 'points',
138:   rebounds: 'rebounds',
139:   assists: 'assists',
140:   steals: 'steals',
141:   threes: 'threes',
142:   fouls: 'fouls',
143: };
144: 
145: // ── Main ───────────────────────────────────────────────────────────────────────
146: 
147: if (!props.length) {
148:   console.log('nba_props.json vazio — sem props disponíveis.');
149:   process.exit(0);
150: }
151: 
152: const NOW = Date.now();
153: const MIN_15 = 15 * 60 * 1000;
154: 
155: let descartadosSemStats = 0;
156: let descartadosSigmaBaixa = 0;
157: let descartadosJogoBloqueado = 0;
158: const results = [];
159: 
160: for (const prop of props) {
161:   const commence = new Date(prop.commence_time).getTime();
162:   if (commence - NOW < MIN_15) { descartadosJogoBloqueado++; continue; }
163: 
164:   const playerData = findPlayer(prop.player);
165:   if (!playerData) { descartadosSemStats++; continue; }
166: 
167:   const statKey = PROP_MAP[prop.prop];
168:   if (!statKey) continue;
169: 
170:   const locations = prop.location === 'home' || prop.location === 'away'
171:     ? [prop.location]
172:     : ['home', 'away'];
173: 
174:   const stats = combineContexts(playerData, statKey, locations, ['regular']);
175:   if (!stats) { descartadosSemStats++; continue; }
176:   if (stats.std < 0.3) { descartadosSigmaBaixa++; continue; }
177: 
178:   // Probabilidades brutas da distribuição normal
179:   const pOverRaw  = probOverRaw(stats.avg, stats.std, prop.line);
180:   const pUnderRaw = probUnderRaw(stats.avg, stats.std, prop.line);
181: 
182:   // Probabilidades calibradas (corrigem superstimativa sistemática)
183:   const pOver  = calibrate(pOverRaw);
184:   const pUnder = calibrate(pUnderRaw);
185: 
186:   const impliedOver  = 1 / prop.oddsOver;
187:   const impliedUnder = 1 / prop.oddsUnder;
188: 
189:   const edgeOver  = pOver  - impliedOver;
190:   const edgeUnder = pUnder - impliedUnder;
191: 
192:   const bestSide  = edgeOver >= edgeUnder ? 'Over' : 'Under';
193:   const bestEdge  = edgeOver >= edgeUnder ? edgeOver : edgeUnder;
194:   const bestProb  = edgeOver >= edgeUnder ? pOver : pUnder;
195:   const bestOdds  = edgeOver >= edgeUnder ? prop.oddsOver : prop.oddsUnder;
196: 
197:   const edgePct        = parseFloat((bestEdge * 100).toFixed(2));
198:   const kellyCrit      = calcKelly(bestProb, bestOdds);
199:   const inefficientMarket = !stats.lowSample && edgePct >= INEFFICIENT_MARKET_EDGE;
200: 
201:   results.push({
202:     game: prop.game,
203:     commence_time: prop.commence_time,
204:     player: prop.player,
205:     prop: prop.prop,
206:     location: prop.location,
207:     line: prop.line,
208:     playerAvg: stats.avg,
209:     playerStd: stats.std,
210:     side: bestSide,
211:     modelProb: parseFloat((bestProb * 100).toFixed(1)),
212:     impliedProb: parseFloat(((1 / bestOdds) * 100).toFixed(1)),
213:     edge: edgePct,
214:     odds: bestOdds,
215:     kelly: kellyCrit,
216:     totalGames: stats.totalGames,
217:     contextGames: stats.contextGames,
218:     lowSample: stats.lowSample,
219:     inefficientMarket,
220:   });
221: }
222: 
223: console.log(`Props processadas: ${results.length} | Sem stats: ${descartadosSemStats} | Sigma baixo: ${descartadosSigmaBaixa} | Jogo bloqueado: ${descartadosJogoBloqueado}`);
224: 
225: results.sort((a, b) => b.edge - a.edge);
226: 
227: results.slice(0, 15).forEach((r, i) => {
228:   const warn   = r.lowSample        ? ' ⚠️' : '';
229:   const target = r.inefficientMarket ? ' 🎯' : '';
230:   const loc    = r.location !== 'unknown' ? ` [${r.location}]` : '';
231:   console.log(
232:     `[${i + 1}] ${r.player}${warn}${target}${loc} | ${r.prop} ${r.side} ${r.line} | Edge: ${r.edge}% | Kelly: ${r.kelly}%`
233:   );
234: });
235: 
236: fs.writeFileSync('nba_props_results.json', JSON.stringify(results, null, 2));
237: console.log('nba_props_results.json salvo.');
</file>

