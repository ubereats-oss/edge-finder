 78: async function fetchEventIds(start, end) {
 79:   const url = `https://site.api.espn.com/apis/site/v2/sports/football/nfl/scoreboard?limit=200&dates=${start}-${end}`;
 80:   const res = await axios.get(url);
 81:   return (res.data.events || [])
 82:     .filter(e => e.competitions[0].status.type.completed)
 83:     .map(e => {
 84:       const comp = e.competitions[0];
 85:       const home = comp.competitors.find(c => c.homeAway === 'home');
 86:       const away = comp.competitors.find(c => c.homeAway === 'away');
 87:       const homeScore = parseInt(home?.score) || 0;
 88:       const awayScore = parseInt(away?.score) || 0;
 89:       return {
 90:         id: e.id,
 91:         date: e.date,
 92:         seasonType: e.season?.type === 3 ? 'playoffs' : 'regular',
 93:         season: e.season?.year,
 94:         homeTeam: home?.team?.displayName,
 95:         awayTeam: away?.team?.displayName,
 96:         homeScore,
 97:         awayScore,
 98:         blowout: Math.abs(homeScore - awayScore) >= 21,
 99:         homeWon: home?.winner === true,
100:       };
101:     });
102: }
103: 
104: async function fetchBoxScore(eventId) {
105:   const url = `https://site.api.espn.com/apis/site/v2/sports/football/nfl/summary?event=${eventId}`;
106:   const res = await axios.get(url);
107:   return res.data.boxscore?.players || [];
108: }
