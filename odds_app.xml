141: // Busca metadados de um jogo específico para um jogador
142: function getGameMeta(metaIndex, playerName, statKey, location, homeTeam, awayTeam, gameDate) {
143:   const idx = metaIndex[playerName]?.[statKey]?.[location];
144:   if (!idx) return null;
145:   const opponent = location === 'home' ? awayTeam : homeTeam;
146:   const oppKey = (opponent || '').split(' ').pop().toLowerCase();
147:   // Tenta match exato por data primeiro
148:   if (gameDate) {
149:     const dateKey = `${gameDate.slice(0, 10)}|${oppKey}`;
150:     if (idx.has(dateKey)) return idx.get(dateKey);
151:   }
152:   return idx.get(oppKey) || null;
153: }
154: 
155: // ── Filtra valores históricos por contexto de ausentes ────────────────────────
156: function filterByAbsentContext(values, absentToday) {
157:   if (!absentToday || absentToday.length === 0) return null;
158:   const filtered = values.filter(v =>
159:     v._absentStarters && absentToday.some(absent =>
160:       v._absentStarters.some(h =>
161:         h.toLowerCase().includes(absent.toLowerCase()) ||
162:         absent.toLowerCase().includes(h.toLowerCase())
163:       )
164:     )
165:   );
166:   return filtered.length >= 5 ? filtered.map(v => v.value) : null;
167: }
