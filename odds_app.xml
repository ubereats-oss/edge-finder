 450:   static int _injuryStatusScore(String status) {
 451:     final s = status.toUpperCase();
 452:     if (s == 'OUT' || s == 'O') return -3;
 453:     if (s == 'DOUBTFUL' || s == 'D') return -2;
 454:     if (s == 'QUESTIONABLE' || s == 'Q' || s == 'DTD') return -1;
 455:     if (s == 'PROBABLE' || s == 'P') return 0;
 456:     return 0;
 457:   }
