231: // calcRecentAvg definida fora do loop — corrigido
232: function calcRecentAvg(playerData, statKey, n) {
233:   const entries = [];
234:   for (const [, seasonData] of Object.entries(playerData)) {
235:     for (const [, locs] of Object.entries(seasonData)) {
236:       for (const [, ctx] of Object.entries(locs)) {
237:         if (!ctx || !ctx[statKey] || !Array.isArray(ctx[statKey])) continue;
238:         for (const entry of ctx[statKey]) {
239:           if (entry.blowout) continue;
240:           const val = typeof entry === 'object' ? entry.value : entry;
241:           const date = entry.date || '';
242:           entries.push({ val, date });
243:         }
244:       }
245:     }
246:   }
247:   entries.sort((a, b) => b.date.localeCompare(a.date));
248:   const slice = entries.slice(0, n);
249:   if (!slice.length) return null;
250:   return parseFloat((slice.reduce((s, e) => s + e.val, 0) / slice.length).toFixed(1));
251: }
