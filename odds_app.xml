  1: const fs = require('fs');
  2: 
  3: // ── Configuração ───────────────────────────────────────────────────────────────
  4: const TENNIS_STATS_FILE     = 'tennis_player_stats.json';
  5: const DATA_SPLIT            = '2025-01-01';
  6: const KELLY_FRACTION        = 0.25;
  7: const HOUSE_MARGIN          = 0.05;
  8: const MIN_GAMES_MKT_SURFACE = 6;
  9: const MIN_GAMES_MKT_ALL     = 10;
 10: const MIN_GAMES_MODEL       = 5;
 11: const STAT_KEYS             = ['sets', 'games'];
 12: const SURFACES              = ['clay', 'grass', 'hard', 'hard_indoor'];
 13: const BANKROLL_START        = 1000;
 14: const FLAT_STAKE_CAP        = BANKROLL_START * 0.05;
 15: const DECAY                 = 0.96;
 16: const MIN_STD               = { sets: 0.3, games: 0.5 };
 17: 
 18: // ── Utilitários ────────────────────────────────────────────────────────────────
 19: function erf(x) {
 20:   const sign = x >= 0 ? 1 : -1;
 21:   x = Math.abs(x);
 22:   const a1 = 0.254829592, a2 = -0.284496736, a3 = 1.421413741;
 23:   const a4 = -1.453152027, a5 = 1.061405429, p = 0.3275911;
 24:   const t = 1 / (1 + p * x);
 25:   const y = 1 - (((((a5 * t + a4) * t) + a3) * t + a2) * t + a1) * t * Math.exp(-x * x);
 26:   return sign * y;
 27: }
 28: 
 29: function normalCDF(x, mu, sigma) {
 30:   if (sigma <= 0) return x >= mu ? 1 : 0;
 31:   return 0.5 * (1 + erf((x - mu) / (sigma * Math.sqrt(2))));
 32: }
 33: 
 34: function probOver(mu, sigma, line)  { return 1 - normalCDF(line, mu, sigma); }
 35: function probUnder(mu, sigma, line) { return normalCDF(line, mu, sigma); }
 36: 
 37: function marketOdd(p) {
 38:   if (p <= 0.01) return null;
 39:   return 1 / (p * (1 + HOUSE_MARGIN));
 40: }
 41: 
 42: function calcKelly(prob, odds) {
 43:   const b = odds - 1;
 44:   const q = 1 - prob;
 45:   const k = (prob * b - q) / b;
 46:   return Math.max(0, k * KELLY_FRACTION);
 47: }
 48: 
 49: function calcAvgStd(values) {
 50:   if (!values || values.length === 0) return null;
 51:   const avg = values.reduce((s, v) => s + v, 0) / values.length;
 52:   const variance = values.reduce((s, v) => s + Math.pow(v - avg, 2), 0) / values.length;
 53:   return { avg, std: Math.sqrt(variance), count: values.length };
 54: }
 55: 
 56: function calcWeightedAvgStd(values) {
 57:   if (!values || values.length === 0) return null;
 58:   let wSum = 0, wSumSq = 0, totalW = 0;
 59:   const n = values.length;
 60:   for (let i = 0; i < n; i++) {
 61:     const w = Math.pow(DECAY, n - 1 - i);
 62:     wSum   += values[i] * w;
 63:     wSumSq += values[i] * values[i] * w;
 64:     totalW += w;
 65:   }
 66:   const avg = wSum / totalW;
 67:   const variance = Math.max(0, wSumSq / totalW - avg * avg);
 68:   return { avg, std: Math.sqrt(variance), count: n };
 69: }
 70: 
 71: // ── Calibração isotônica (de model_tennis_props.js) ───────────────────────────
 72: const CALIB_TABLE = [
 73:   { raw: 0.519, cal: 0.504 },
 74:   { raw: 0.576, cal: 0.572 },
 75:   { raw: 0.625, cal: 0.608 },
 76:   { raw: 0.674, cal: 0.671 },
 77:   { raw: 0.723, cal: 0.720 },
 78:   { raw: 0.771, cal: 0.764 },
 79:   { raw: 0.816, cal: 0.811 },
 80: ];
 81: 
 82: function calibrate(p) {
 83:   if (p < 0.5) return 1 - calibrate(1 - p);
 84:   const n = CALIB_TABLE.length;
 85:   if (p <= CALIB_TABLE[0].raw) {
 86:     const slope = (CALIB_TABLE[1].cal - CALIB_TABLE[0].cal) /
 87:                   (CALIB_TABLE[1].raw - CALIB_TABLE[0].raw);
 88:     return Math.min(1, Math.max(0, CALIB_TABLE[0].cal + slope * (p - CALIB_TABLE[0].raw)));
 89:   }
 90:   if (p >= CALIB_TABLE[n - 1].raw) {
 91:     const slope = (CALIB_TABLE[n - 1].cal - CALIB_TABLE[n - 2].cal) /
 92:                   (CALIB_TABLE[n - 1].raw - CALIB_TABLE[n - 2].raw);
 93:     return Math.min(1, Math.max(0, CALIB_TABLE[n - 1].cal + slope * (p - CALIB_TABLE[n - 1].raw)));
 94:   }
 95:   for (let i = 0; i < n - 1; i++) {
 96:     if (p >= CALIB_TABLE[i].raw && p <= CALIB_TABLE[i + 1].raw) {
 97:       const t = (p - CALIB_TABLE[i].raw) / (CALIB_TABLE[i + 1].raw - CALIB_TABLE[i].raw);
 98:       return CALIB_TABLE[i].cal + t * (CALIB_TABLE[i + 1].cal - CALIB_TABLE[i].cal);
 99:     }
100:   }
101:   return p;
102: }
