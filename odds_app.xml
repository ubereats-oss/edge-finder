 34:   static Future<FetchResult> _fetchFirestore(
 35:       String collection, String document) async {
 36:     final url = '$_firestoreBase/$collection/$document';
 37:     final res = await http.get(Uri.parse(url));
 38:     if (res.statusCode != 200) {
 39:       throw Exception(
 40:           'Erro ao buscar $collection/$document: ${res.statusCode}');
 41:     }
 42:     final body = jsonDecode(res.body) as Map<String, dynamic>;
 43:     final fields = body['fields'] as Map<String, dynamic>?;
 44:     if (fields == null) {
 45:       return const FetchResult(data: []);
 46:     }
 47: 
 48:     final dataField = fields['data'];
 49:     final List<Map<String, dynamic>> data = [];
 50:     if (dataField != null) {
 51:       final values = dataField['arrayValue']?['values'] as List? ?? [];
 52:       for (final item in values) {
 53:         final map = _firestoreToMap(
 54:             item['mapValue']?['fields'] as Map<String, dynamic>? ?? {});
 55:         data.add(map);
 56:       }
 57:     }
 58: 
 59:     DateTime? lastUpdated;
 60:     final luField = fields['lastUpdated'];
 61:     if (luField != null) {
 62:       final luStr = luField['stringValue'] as String?;
 63:       if (luStr != null) {
 64:         lastUpdated = DateTime.tryParse(luStr);
 65:       }
 66:     }
 67:     return FetchResult(data: data, lastUpdated: lastUpdated);
