  4: class EdgeEvaluatorService {
  5:   // ── Algoritmo Local ───────────────────────────────────────────────────────
  6: 
  7:   // Normaliza para 0-1 independente de escala de entrada (0-1 ou 0-100)
  8:   static double _toProb(num? v, double fallback) {
  9:     if (v == null) return fallback;
 10:     final d = v.toDouble();
 11:     return d > 1 ? d / 100 : d;
 12:   }
 13: 
 14:   static double calibratedProb(Map<String, dynamic> p) {
 15:     final model = _toProb(p['modelProb'], 0.50);
 16:     final market = _toProb(p['impliedProb'], 0.50);
 17:     final side = p['side'] as String? ?? 'Over';
 18:     final line = (p['line'] as num?)?.toDouble() ?? 0;
 19:     final avg5 = (p['playerAvg5'] as num?)?.toDouble();
 20:     final avg10 = (p['playerAvg10'] as num?)?.toDouble();
 21: 
 22:     double confidence = 0.5;
 23:     if (p['inefficientMarket'] == true) confidence += 0.1;
 24:     if (p['lowSample'] == true) confidence -= 0.2;
 25:     if (avg5 != null && avg10 != null) {
 26:       if (side == 'Over') {
 27:         if (avg5 > line && avg10 > line) confidence += 0.1;
 28:         if (avg5 < line && avg10 < line) confidence -= 0.1;
 29:       } else {
 30:         if (avg5 < line && avg10 < line) confidence += 0.1;
 31:         if (avg5 > line && avg10 > line) confidence -= 0.1;
 32:       }
 33:     }
 34:     confidence = confidence.clamp(0.2, 0.7);
 35:     return market + confidence * (model - market);
 36:   }
 37: 
 38:   static const int _minBets = 15;
 39:   static const int _maxBets = 20;
 40: 
 41:   static double _kelly(Map<String, dynamic> p) {
 42:     final stored = (p['kelly'] as num?)?.toDouble();
 43:     if (stored != null) return stored;
 44:     final prob = (p['_probCalibrada'] as double?) ?? calibratedProb(p);
 45:     final odds = (p['odds'] as num?)?.toDouble() ?? 2.0;
 46:     if (odds <= 1) return 0;
 47:     return ((prob * odds - 1) / (odds - 1) * 100).clamp(0.0, 100.0);
 48:   }
 49: 
 50:   static double _stdOutlierZ(Map<String, dynamic> p) {
 51:     final avg5 = (p['playerAvg5'] as num?)?.toDouble();
 52:     final avg = (p['playerAvg'] as num?)?.toDouble();
 53:     final std = (p['playerStd'] as num?)?.toDouble();
 54: 
 55:     if (avg5 == null || avg == null || std == null || std <= 0) return 0;
 56: 
 57:     return ((avg5 - avg).abs() / std);
 58:   }
 59: 
 60:   static bool _isStdOutlierAgainstBet(Map<String, dynamic> p) {
 61:     final side = p['side'] as String? ?? 'Over';
 62:     final avg5 = (p['playerAvg5'] as num?)?.toDouble();
 63:     final avg = (p['playerAvg'] as num?)?.toDouble();
 64:     final std = (p['playerStd'] as num?)?.toDouble();
 65: 
 66:     if (avg5 == null || avg == null || std == null || std <= 0) return false;
 67: 
 68:     final z = _stdOutlierZ(p);
 69:     if (z < 1.25) return false;
 70: 
 71:     if (side == 'Over') return avg5 < avg - std;
 72:     return avg5 > avg + std;
 73:   }
 74: 
 75:   static int _contradictionLevel(Map<String, dynamic> p) {
 76:     final side = p['side'] as String? ?? 'Over';
 77:     final line = (p['line'] as num?)?.toDouble() ?? 0;
 78:     final avg5 = (p['playerAvg5'] as num?)?.toDouble();
 79: 
 80:     if (avg5 == null || line <= 0) return 0;
 81: 
 82:     if (_isStdOutlierAgainstBet(p)) return 2;
 83: 
 84:     if (side == 'Under') {
 85:       if (avg5 > line * 1.15) return 2;
 86:       if (avg5 > line) return 1;
 87:       return 0;
 88:     }
 89: 
 90:     if (avg5 < line * 0.85) return 2;
 91:     if (avg5 < line) return 1;
 92:     return 0;
 93:   }
 94: 
 95:   static int lastQualifiedCount = 0;
 96: 
 97:   // Floors absolutos — nunca relaxados (odds, kelly, edge mínimo absoluto, cs)
 98:   static bool _absoluteFloors(Map<String, dynamic> p) {
 99:     final odds = (p['odds'] as num?)?.toDouble() ?? 0;
100:     if (odds < 1.45 || odds > 2.40) return false;
101:     if (_kelly(p) < 2.0) return false;
102:     final edge = (p['edge'] as num?)?.toDouble() ?? 0;
103:     if (edge < 2.5) return false;
104:     final cs = (p['_contextScore'] as int?) ?? 0;
105:     if (cs <= -2) return false;
106:     return true;
107:   }
108: 
109:   // minEdgePct em percentual (ex: 3.0 = 3%)
110:   static bool _baseFloors(
111:       Map<String, dynamic> p, double minProb, double minEdgePct) {
112:     if (!_absoluteFloors(p)) return false;
113:     final prob = (p['_probCalibrada'] as double?) ?? calibratedProb(p);
114:     if (prob < minProb) return false;
115:     final edge = (p['edge'] as num?)?.toDouble() ?? 0;
116:     if (edge < minEdgePct) return false;
117:     return true;
118:   }
119: 
120:   static bool _passesContradiction(Map<String, dynamic> p) {
121:     final cl = (p['_contradictionLevel'] as int?) ?? _contradictionLevel(p);
122:     if (cl == 0) return true;
123: 
124:     final edge = (p['edge'] as num?)?.toDouble() ?? 0;
125:     if (cl == 1) return edge >= 8 && _kelly(p) >= 4;
126: 
127:     final confirmed = (p['_contextConfirmed'] as bool?) ?? false;
128:     final status = p['_contextStatus'] as String? ?? 'unknown';
129: 
130:     if (_isStdOutlierAgainstBet(p) && !confirmed) return false;
131: 
132:     return (edge >= 25 && _kelly(p) >= 8) ||
133:         (confirmed && status == 'positive');
134:   }
135: 
136:   static List<Map<String, dynamic>> adaptiveFilter(
137:       List<Map<String, dynamic>> props) {
138:     bool full(Map<String, dynamic> p) =>
139:         _baseFloors(p, 0.55, 3.0) && _passesContradiction(p);
140: 
141:     // Relaxado: prob 0.52, edge 2.5 — contradição mantida igual
142:     bool relaxed(Map<String, dynamic> p) {
143:       if (!_absoluteFloors(p)) return false;
144:       if (!_passesContradiction(p)) return false;
145:       final prob = (p['_probCalibrada'] as double?) ?? calibratedProb(p);
146:       if (prob < 0.52) return false;
147:       return true;
148:     }
149: 
150:     var result = props.where(full).toList();
151:     if (result.length < _minBets) result = props.where(relaxed).toList();
152:     lastQualifiedCount = result.length;
153:     return result;
154:   }
155: 
156:   static double _computeScoreFinal(Map<String, dynamic> p) {
157:     final prob = (p['_probCalibrada'] as double?) ?? calibratedProb(p);
158:     final edge = (p['edge'] as num?)?.toDouble() ?? 0;
159:     final cl = (p['_contradictionLevel'] as int?) ?? 0;
160:     final status = p['_contextStatus'] as String? ?? 'unknown';
161:     final confirmed = (p['_contextConfirmed'] as bool?) ?? false;
162:     final lowSample = p['lowSample'] == true;
163:     final side = p['side'] as String? ?? 'Over';
164:     final line = (p['line'] as num?)?.toDouble() ?? 0;
165:     final avg5 = (p['playerAvg5'] as num?)?.toDouble();
166:     final avg10 = (p['playerAvg10'] as num?)?.toDouble();
167: 
168:     final stdOutlierAgainstBet = _isStdOutlierAgainstBet(p);
169: 
170:     final double consistencyScore;
171:     if (cl == 2) {
172:       consistencyScore = stdOutlierAgainstBet ? 0.0 : 0.1;
173:     } else if (cl == 1) {
174:       consistencyScore = 0.3;
175:     } else {
176:       final f5 = avg5 != null &&
177:           line > 0 &&
178:           ((side == 'Over' && avg5 >= line) ||
179:               (side == 'Under' && avg5 <= line));
180:       final f10 = avg10 != null &&
181:           line > 0 &&
182:           ((side == 'Over' && avg10 >= line) ||
183:               (side == 'Under' && avg10 <= line));
184: 
185:       if (avg5 != null && avg10 != null) {
186:         consistencyScore = f5 && f10
187:             ? 1.0
188:             : f10
189:                 ? 0.7
190:                 : 0.5;
191:       } else {
192:         consistencyScore = avg5 != null ? (f5 ? 0.8 : 0.3) : 0.5;
193:       }
194:     }
195: 
196:     double probAdj = prob;
197: 
198:     if (stdOutlierAgainstBet && !confirmed) {
199:       probAdj = probAdj * 0.75;
200:     }
201: 
202:     double s =
203:         50 * probAdj + 30 * (edge / 30).clamp(0.0, 1.0) + 20 * consistencyScore;
204: 
205:     if (status == 'positive') s += 10;
206:     if (status == 'negative') s -= 20;
207:     if (cl == 2 && !confirmed) s -= 25;
208:     if (lowSample) s -= 10;
209: 
210:     return s.clamp(0.0, 100.0);
211:   }
212: 
213:   static List<Map<String, dynamic>> rankLocal(
214:       List<Map<String, dynamic>> props) {
215:     final filtered = adaptiveFilter(props);
216:     final scored = filtered.map((p) {
217:       final sf = _computeScoreFinal(p);
218:       final prob = (p['_probCalibrada'] as double?) ?? calibratedProb(p);
219:       final edge = (p['edge'] as num?)?.toDouble() ?? 0;
220:       final ev = edge * prob;
221:       return {...p, '_scoreFinal': sf, '_localScore': sf, '_evScore': ev};
222:     }).toList();
223: 
224:     scored.sort((a, b) {
225:       final aNeg = (a['_contextStatus'] as String?) == 'negative' ? 1 : 0;
226:       final bNeg = (b['_contextStatus'] as String?) == 'negative' ? 1 : 0;
227:       if (aNeg != bNeg) return aNeg.compareTo(bNeg);
228: 
229:       final sCmp =
230:           (b['_scoreFinal'] as double).compareTo(a['_scoreFinal'] as double);
231:       if (sCmp != 0) return sCmp;
232: 
233:       final evCmp =
234:           (b['_evScore'] as double).compareTo(a['_evScore'] as double);
235:       if (evCmp != 0) return evCmp;
236: 
237:       return _kelly(b).compareTo(_kelly(a));
238:     });
239: 
240:     // Validação final + cap
241:     final valid = scored.where((p) {
242:       final edge = (p['edge'] as num?)?.toDouble() ?? 0;
243:       if (edge < 2.5 || _kelly(p) < 2.0) return false;
244:       final odds = (p['odds'] as num?)?.toDouble() ?? 0;
245:       if (odds < 1.45 || odds > 2.40) return false;
246:       final cl = (p['_contradictionLevel'] as int?) ?? 0;
247:       if (cl == 2 && edge < 20) return false;
248:       return true;
249:     }).toList();
250: 
251:     lastQualifiedCount = valid.length;
252:     return valid.take(_maxBets).toList();
253:   }
