322:   // ── Calibração e Brier Score ───────────────────────────────────────────────
323:   const buckets = {};
324:   for (let i = 0; i <= 9; i++) {
325:     buckets[(0.5 + i * 0.05).toFixed(2)] = { predicted: 0, actual: 0, n: 0 };
326:   }
