291: 
292:         // Modelo walk-forward: tenta filtrar por ausentes antes de usar valores brutos
293:         const modelEntries =
294:           modelRaw[playerName]?.[location]?.[stat] ||
295:           modelRaw[playerName]?.['all']?.[stat] ||
296:           null;
297: 
298:         let modelValues = null;
299:         let usedAbsentFilter = false;
300: 
301:         if (modelEntries && modelEntries.length >= MIN_GAMES_MODEL) {
302:           // Tenta filtro de ausentes
303:           const filtered = filterByAbsentContext(modelEntries, absentToday);
304:           if (filtered && filtered.length >= MIN_GAMES_MODEL) {
305:             modelValues = filtered;
306:             usedAbsentFilter = true;
307:             filtroAusentes++;
308:           } else {
309:             // Fallback: exclui blowouts e overtimes mas usa todos
310:             modelValues = modelEntries
311:               .filter(e => !e._blowout && !e._overtime)
312:               .map(e => e.value);
313:             if (modelValues.length < MIN_GAMES_MODEL) modelValues = modelEntries.map(e => e.value);
314:           }
315:         }
316: 
317:         let modelProfile = null;
318:         if (modelValues && modelValues.length >= MIN_GAMES_MODEL) {
319:           modelProfile = calcWeightedAvgStd(modelValues);
320:         } else if (mktProfile) {
321:           modelProfile = mktProfile;
322:         }
323: 
324:         if (!modelProfile) { skipped++; continue; }
325: 
326:         const pOverRaw  = probOver(modelProfile.avg, modelProfile.std, line);
327:         const pUnderRaw = probUnder(modelProfile.avg, modelProfile.std, line);
328:         const pOver  = calibrate(pOverRaw);
329:         const pUnder = calibrate(pUnderRaw);
330: 
331:         const edgeOver  = pOver  - mktPOver;
332:         const edgeUnder = pUnder - mktPUnder;
333: 
334:         const bestSide = edgeOver >= edgeUnder ? 'Over' : 'Under';
335:         const bestProb = edgeOver >= edgeUnder ? pOver  : pUnder;
336:         const bestOdd  = edgeOver >= edgeUnder ? mktOddOver : mktOddUnder;
337:         const bestEdge = edgeOver >= edgeUnder ? edgeOver : edgeUnder;
338: 
339:         const kelly = calcKelly(bestProb, bestOdd);
340:         if (kelly <= 0) { skipped++; continue; }
341: 
342:         const won = bestSide === 'Over' ? actual > line : actual < line;
343: 
344:         predictions.push({
345:           date: game.date,
346:           player: playerName,
347:           stat,
348:           location,
349:           side: bestSide,
350:           line,
351:           actual,
352:           prob: parseFloat((bestProb * 100).toFixed(1)),
353:           edge: parseFloat((bestEdge * 100).toFixed(2)),
354:           mktOdd: parseFloat(bestOdd.toFixed(3)),
355:           kellyFrac: parseFloat((kelly * 100).toFixed(2)),
356:           modelAvg: parseFloat(modelProfile.avg.toFixed(2)),
357:           usedAbsentFilter,
358:           won,
359:           modelGames: modelValues?.length || 0,
360:         });
361:       }
