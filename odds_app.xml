134: function combineContexts(playerData, statKey, locations, gameTypes, absentToday) {
135:   let weightedSum = 0;
136:   let weightedSumSq = 0;
137:   let totalWeight = 0;
138:   let totalGames = 0;
139:   let contextGames = 0;
140: 
141:   const hasAbsentContext = absentToday.length > 0;
142:   let usedAbsentFilter = false;
143: 
144:   if (hasAbsentContext) {
145:     let filteredSum = 0, filteredSumSq = 0, filteredWeight = 0, filteredGames = 0, filteredContext = 0;
146: 
147:     for (const [seasonStr, seasonData] of Object.entries(playerData)) {
148:       const season = parseInt(seasonStr);
149:       const w = SEASON_WEIGHT[season] || 1;
150: 
151:       for (const gameType of gameTypes) {
152:         for (const location of locations) {
153:           const ctx = seasonData?.[gameType]?.[location];
154:           if (!ctx || !ctx[statKey] || !Array.isArray(ctx[statKey])) continue;
155: 
156:           for (const entry of ctx[statKey]) {
157:             if (entry.blowout) continue;
158:             if (!matchesAbsentContext(entry.absentStarters || [], absentToday)) continue;
159: 
160:             filteredSum += entry.value * w;
161:             filteredSumSq += entry.value * entry.value * w;
162:             filteredWeight += w;
163:             filteredGames++;
164:             if (season === 2026) filteredContext++;
165:           }
166:         }
167:       }
168:     }
169: 
170:     if (filteredGames >= 5) {
171:       weightedSum = filteredSum;
172:       weightedSumSq = filteredSumSq;
173:       totalWeight = filteredWeight;
174:       totalGames = filteredGames;
175:       contextGames = filteredContext;
176:       usedAbsentFilter = true;
177:     }
178:   }
179: 
180:   if (!usedAbsentFilter) {
181:     for (const [seasonStr, seasonData] of Object.entries(playerData)) {
182:       const season = parseInt(seasonStr);
183:       const w = SEASON_WEIGHT[season] || 1;
184: 
185:       for (const gameType of gameTypes) {
186:         for (const location of locations) {
187:           const ctx = seasonData?.[gameType]?.[location];
188:           if (!ctx || !ctx[statKey] || !Array.isArray(ctx[statKey])) continue;
189: 
190:           for (const entry of ctx[statKey]) {
191:             if (entry.blowout) continue;
192: 
193:             const value = typeof entry === 'object' ? entry.value : entry;
194:             weightedSum += value * w;
195:             weightedSumSq += value * value * w;
196:             totalWeight += w;
197:             totalGames++;
198:             if (season === 2026) contextGames++;
199:           }
200:         }
201:       }
202:     }
203:   }
204: 
205:   if (totalWeight === 0) return null;
206: 
207:   const avg = weightedSum / totalWeight;
208:   const variance = Math.max(0, weightedSumSq / totalWeight - avg * avg);
209: 
210:   return {
211:     avg: parseFloat(avg.toFixed(2)),
212:     std: parseFloat(Math.sqrt(variance).toFixed(2)),
213:     totalGames,
214:     contextGames,
215:     lowSample: contextGames < MIN_GAMES_CONTEXT,
216:     usedAbsentFilter,
217:   };
218: }
