164:               title: 'Atualização rápida',
165:               subtitle: 'Odds e props do dia · ~30 segundos',
166:               onTap: () {
167:                 Navigator.pop(context);
168:                 _runQuick();
169:               },
170:             ),
171:             const SizedBox(height: 12),
172:             _UpdateOption(
