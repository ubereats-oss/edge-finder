168: // ── Main ───────────────────────────────────────────────────────────────────────
169: function main() {
170:   if (!fs.existsSync(TENNIS_STATS_FILE)) {
171:     console.error(`ERRO: ${TENNIS_STATS_FILE} não encontrado.`);
172:     process.exit(1);
173:   }
174: 
175:   const playerStats = JSON.parse(fs.readFileSync(TENNIS_STATS_FILE));
176:   console.log(`Jogadores carregados: ${Object.keys(playerStats).length}`);
177: 
178:   const allRecords  = extractMatchRecords(playerStats);
179:   const baseRecords = allRecords.filter(r => r.date < DATA_SPLIT);
180:   const walkRecords = allRecords.filter(r => r.date >= DATA_SPLIT);
181: 
182:   console.log(`Base (< ${DATA_SPLIT}): ${baseRecords.length} partidas | Walk-forward (≥ ${DATA_SPLIT}): ${walkRecords.length} partidas`);
183: 
184:   // ── Perfil de mercado (base histórica) ────────────────────────────────────
185:   console.log('Construindo perfil de mercado...');
186:   const marketRaw = {};
187: 
188:   for (const record of baseRecords) {
189:     const { playerName, surface, stats } = record;
