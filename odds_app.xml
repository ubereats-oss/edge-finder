254: // Recalcula titulares habituais e absentStarters em todo o dataset
255: function recalculateAbsents(raw) {
256:   const habituais = {};
257:   for (const [playerName, playerData] of Object.entries(raw)) {
258:     for (const [seasonStr, seasonData] of Object.entries(playerData)) {
259:       const season = parseInt(seasonStr);
260:       for (const gameType of ['regular', 'playoffs']) {
261:         for (const loc of ['home', 'away']) {
262:           const ctx = seasonData[gameType]?.[loc];
263:           if (!ctx) continue;
264:           for (const entry of ctx.points) {
265:             const team = entry._team;
266:             if (!team) continue;
267:             if (!habituais[team]) habituais[team] = {};
268:             if (!habituais[team][season]) habituais[team][season] = {};
269:             if (!habituais[team][season][playerName]) {
270:               habituais[team][season][playerName] = { total: 0, starter: 0 };
271:             }
272:             habituais[team][season][playerName].total++;
273:             if (entry.minutes >= MIN_MINUTES_STARTER) {
274:               habituais[team][season][playerName].starter++;
275:             }
276:           }
277:         }
278:       }
279:     }
280:   }
281: 
282:   const starterSets = {};
283:   for (const [team, seasons] of Object.entries(habituais)) {
284:     starterSets[team] = {};
285:     for (const [season, players] of Object.entries(seasons)) {
286:       starterSets[team][season] = new Set();
287:       for (const [player, counts] of Object.entries(players)) {
288:         if (counts.total >= 10 && counts.starter / counts.total >= MIN_STARTER_RATE) {
289:           starterSets[team][season].add(player);
290:         }
291:       }
292:     }
293:   }
294: 
295:   const presentMap = {};
296:   for (const [playerName, playerData] of Object.entries(raw)) {
297:     for (const seasonData of Object.values(playerData)) {
298:       for (const gameType of ['regular', 'playoffs']) {
299:         for (const loc of ['home', 'away']) {
300:           const ctx = seasonData[gameType]?.[loc];
301:           if (!ctx) continue;
302:           for (const entry of ctx.points) {
303:             const key = `${entry._eventDate}|${entry._team}`;
304:             if (!presentMap[key]) presentMap[key] = new Set();
305:             presentMap[key].add(playerName);
306:           }
307:         }
308:       }
309:     }
310:   }
311: 
312:   for (const [playerName, playerData] of Object.entries(raw)) {
313:     for (const [seasonStr, seasonData] of Object.entries(playerData)) {
314:       const season = parseInt(seasonStr);
315:       for (const gameType of ['regular', 'playoffs']) {
316:         for (const loc of ['home', 'away']) {
317:           const ctx = seasonData[gameType]?.[loc];
318:           if (!ctx) continue;
319:           for (const statKey of STAT_KEYS) {
320:             for (const entry of ctx[statKey] || []) {
321:               const key = `${entry._eventDate}|${entry._team}`;
322:               const present = presentMap[key] || new Set();
323:               const starters = starterSets[entry._team]?.[season] || new Set();
324:               entry.absentStarters = [...starters].filter(s => !present.has(s));
325:             }
326:           }
327:         }
328:       }
329:     }
330:   }
331: }
332: 
333: function stripInternalFields(raw) {
334:   for (const playerData of Object.values(raw)) {
335:     for (const seasonData of Object.values(playerData)) {
336:       for (const gameTypeData of Object.values(seasonData)) {
337:         for (const loc of ['home', 'away']) {
338:           const ctx = gameTypeData[loc];
339:           if (!ctx) continue;
340:           for (const statKey of STAT_KEYS) {
341:             ctx[statKey] = (ctx[statKey] || []).map(({ _team, _eventDate, ...rest }) => rest);
342:           }
343:         }
344:       }
345:     }
346:   }
347: }
