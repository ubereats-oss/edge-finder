272: const NOW = Date.now();
273: const MIN_15 = 0;
274: 
275: let descartadosSemStats = 0;
276: let descartadosSigmaBaixa = 0;
277: let descartadosJogoBloqueado = 0;
278: let comFiltroAusentes = 0;
279: const results = [];
280: 
281: for (const prop of props) {
282:   const commence = new Date(prop.commence_time).getTime();
283:   if (commence - NOW < MIN_15) { descartadosJogoBloqueado++; continue; }
284: 
285:   const playerData = findPlayer(prop.player);
286:   if (!playerData) { descartadosSemStats++; continue; }
287: 
288:   const isPlayerAbsent = Object.values(injuriesToday).some(players =>
289:     players.some(absent =>
290:       absent.toLowerCase().includes(prop.player.toLowerCase()) ||
291:       prop.player.toLowerCase().includes(absent.toLowerCase())
292:     )
293:   );
294:   if (isPlayerAbsent) { descartadosSemStats++; continue; }
295: 
296:   const statKey = PROP_MAP[prop.prop];
297:   if (!statKey) continue;
298: 
299:   const locations = prop.location === 'home' || prop.location === 'away'
300:     ? [prop.location]
301:     : ['home', 'away'];
302: 
303:   const gameParts = prop.game ? prop.game.split(' x ') : [];
304:   let teamName = 'unknown';
305:   if (prop.location === 'home' && gameParts.length >= 1) teamName = gameParts[0];
306:   else if (prop.location === 'away' && gameParts.length >= 2) teamName = gameParts[1];
307: 
308:   const absentToday = getAbsentToday(teamName);
309: 
310:   const stats = combineContexts(playerData, statKey, locations, ['regular'], absentToday);
311:   if (!stats) { descartadosSemStats++; continue; }
312:   if (stats.std < 0.3) { descartadosSigmaBaixa++; continue; }
313:   const marginRatio = Math.abs(prop.line - stats.avg) / stats.std;
314:   if (marginRatio < 0.4) continue;
315:   const lowMarginRatio = marginRatio < 0.75;
316:   if (stats.usedAbsentFilter) comFiltroAusentes++;
317: 
318:   const avg5  = calcRecentAvg(playerData, statKey, 5);
319:   const avg10 = calcRecentAvg(playerData, statKey, 10);
320: 
321:   const pOverRaw  = probOverRaw(stats.avg, stats.std, prop.line);
322:   const pUnderRaw = probUnderRaw(stats.avg, stats.std, prop.line);
323: 
324:   const pOver  = calibrate(pOverRaw);
325:   const pUnder = calibrate(pUnderRaw);
326: 
327:   const impliedOver  = 1 / prop.oddsOver;
328:   const impliedUnder = 1 / prop.oddsUnder;
329: 
330:   const edgeOver  = pOver  - impliedOver;
331:   const edgeUnder = pUnder - impliedUnder;
332: 
333:   const bestSide  = edgeOver >= edgeUnder ? 'Over' : 'Under';
334:   const bestEdge  = edgeOver >= edgeUnder ? edgeOver : edgeUnder;
335:   const bestProb  = edgeOver >= edgeUnder ? pOver : pUnder;
336:   const bestOdds  = edgeOver >= edgeUnder ? prop.oddsOver : prop.oddsUnder;
337: 
338:   const edgePct           = parseFloat((bestEdge * 100).toFixed(2));
339:   const kellyCrit         = calcKelly(bestProb, bestOdds);
340:   const inefficientMarket = !stats.lowSample && edgePct >= INEFFICIENT_MARKET_EDGE;
341: 
342:   if (edgePct < 10) { continue; }
343:   results.push({
344:     game: prop.game,
345:     commence_time: prop.commence_time,
346:     player: prop.player,
347:     prop: prop.prop,
348:     location: prop.location,
349:     line: prop.line,
350:     playerAvg: stats.avg,
351:     playerStd: stats.std,
352:     playerAvg5: avg5,
353:     playerAvg10: avg10,
354:     playerTeam: playerTeamMap[prop.player] ?? null,
355:     side: bestSide,
356:     modelProb: parseFloat((bestProb * 100).toFixed(1)),
357:     impliedProb: parseFloat(((1 / bestOdds) * 100).toFixed(1)),
358:     edge: edgePct,
359:     odds: bestOdds,
360:     oddsOver: prop.oddsOver,
361:     oddsUnder: prop.oddsUnder,
362:     kelly: kellyCrit,
363:     totalGames: stats.totalGames,
364:     contextGames: stats.contextGames,
365:     lowSample: stats.lowSample,
366:     inefficientMarket,
367:     lowMarginRatio,
368:     absentFilter: stats.usedAbsentFilter,
369:     absentToday: absentToday.length > 0 ? classifyAbsents(absentToday, prop.player) : undefined,
370:     playerPosition: playerPositions[prop.player]?.position ?? null,
371:     formWarning: avg5 !== null && (bestSide === 'Over' ? avg5 < prop.line : avg5 > prop.line),
372:   });
