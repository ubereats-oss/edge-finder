 397:   // Cache por sport: Map<playerNameLower, {status, detail, team}>
 398:   static final Map<String, Map<String, Map<String, String>>> _injuryCache = {};
 399:   static final Map<String, DateTime> _injuryCacheTime = {};
 400:   static const _cacheTtl = Duration(minutes: 30);
 401: 
 402:   static String _injurySportPath(String sport) {
 403:     final s = sport.toLowerCase();
 404:     if (s.contains('mlb') || s.contains('beisebol')) return 'baseball/mlb';
 405:     if (s.contains('nhl') || s.contains('hockey')) return 'hockey/nhl';
 406:     if (s.contains('nfl') || s.contains('americano')) return 'football/nfl';
 407:     return 'basketball/nba';
 408:   }
