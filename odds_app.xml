242:           ? marketProfiles[playerName][surface][stat]
243:           : (marketProfiles[playerName]?.['all']?.[stat]?.count >= MIN_GAMES_MKT_ALL)
244:           ? marketProfiles[playerName]['all'][stat]
245:           : null;
246: 
247:       if (!mktProfile || mktProfile.std < MIN_STD[stat]) { skipped++; continue; }
248: 
249:       // Perfil do modelo walk-forward: superfície → 'all' → fallback mercado
250:       const modelEntries =
