100: // ── Carrega metadados do nba_player_stats.json ────────────────────────────────
101: // Monta índice: playerName -> statKey -> location -> [{ value, blowout, isOvertime, absentStarters, opponent, date }]
102: // Indexado por opponent+date para cruzamento com cache
103: function buildMetaIndex(playerStats) {
104:   // metaIndex[playerName][statKey][location] = Map<date|oppKey, entry>
105:   const metaIndex = {};
106: 
107:   for (const [playerName, playerData] of Object.entries(playerStats)) {
108:     metaIndex[playerName] = {};
109:     for (const statKey of STAT_KEYS) {
110:       metaIndex[playerName][statKey] = { home: new Map(), away: new Map() };
111:       for (const seasonData of Object.values(playerData)) {
112:         for (const gameType of ['regular', 'playoffs']) {
113:           for (const loc of ['home', 'away']) {
114:             const ctx = seasonData[gameType]?.[loc];
115:             if (!ctx || !ctx[statKey]) continue;
116:             for (const entry of ctx[statKey]) {
117:               if (typeof entry !== 'object' || entry === null) continue;
118:               const oppKey = (entry.opponent || '').split(' ').pop().toLowerCase();
119:               if (!oppKey) continue;
120:               const val = {
121:                 blowout: entry.blowout || false,
122:                 isOvertime: entry.isOvertime || false,
123:                 absentStarters: entry.absentStarters || [],
124:               };
125:               // Chave primária: date (YYYY-MM-DD) + oppKey
126:               if (entry.date) {
127:                 const dateKey = `${entry.date.slice(0, 10)}|${oppKey}`;
128:                 metaIndex[playerName][statKey][loc].set(dateKey, val);
129:               }
130:               // Chave fallback: só oppKey (último match vence — usado se date não disponível)
131:               metaIndex[playerName][statKey][loc].set(oppKey, val);
132:             }
133:           }
134:         }
135:       }
136:     }
137:   }
138:   return metaIndex;
139: }
