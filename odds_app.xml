259:   static String generateLocalJustification(Map<String, dynamic> p) {
260:     final edge = (p['edge'] as num?)?.toDouble() ?? 0;
261:     final modelProb = (p['modelProb'] as num?)?.toDouble() ?? 50;
262:     final impliedProb = (p['impliedProb'] as num?)?.toDouble() ?? 50;
263:     final kelly = (p['kelly'] as num?)?.toDouble() ?? 0;
264:     final lowSample = p['lowSample'] == true;
265:     final inefficientMarket = p['inefficientMarket'] == true;
266:     final playerAvg = (p['playerAvg'] as num?)?.toDouble();
267:     final playerAvg5 = (p['playerAvg5'] as num?)?.toDouble();
268:     final playerAvg10 = (p['playerAvg10'] as num?)?.toDouble();
269:     final playerStd = (p['playerStd'] as num?)?.toDouble();
270:     final line = (p['line'] as num?)?.toDouble() ?? 0;
271:     final side = p['side'] as String? ?? 'Over';
272: 
273:     final parts = <String>[];
274: 
275:     // 1. Qualidade do edge
276:     final gap = modelProb - impliedProb;
277:     if (edge >= 15) {
278:       parts.add('Edge excepcional de ${edge.toStringAsFixed(1)}% '
279:           '(modelo ${modelProb.toStringAsFixed(1)}% vs mercado ${impliedProb.toStringAsFixed(1)}%)');
280:     } else if (edge >= 8) {
281:       parts.add('Edge alto de ${edge.toStringAsFixed(1)}% '
282:           '(vantagem de ${gap.toStringAsFixed(1)}pp sobre o mercado)');
283:     } else if (edge >= 4) {
284:       parts.add('Edge razoável de ${edge.toStringAsFixed(1)}% '
285:           '(modelo ${modelProb.toStringAsFixed(1)}% vs ${impliedProb.toStringAsFixed(1)}% do mercado)');
286:     } else {
287:       parts.add('Edge baixo de ${edge.toStringAsFixed(1)}% — risco elevado');
288:     }
289: 
290:     // 2. Forma recente vs linha
291:     if (playerAvg5 != null && line > 0) {
292:       final diff5 = playerAvg5 - line;
293:       final pct5 = (diff5.abs() / line * 100);
294:       final favors5 =
295:           (side == 'Over' && diff5 > 0) || (side == 'Under' && diff5 < 0);
296:       if (favors5) {
297:         parts.add('Méd. últimos 5 jogos (${playerAvg5.toStringAsFixed(1)}) '
298:             '${side == 'Over' ? 'acima' : 'abaixo'} da linha '
299:             '${line.toStringAsFixed(1)} em ${pct5.toStringAsFixed(0)}%');
300:       } else {
301:         parts.add('ATENÇÃO: méd. 5j (${playerAvg5.toStringAsFixed(1)}) '
302:             '${side == 'Over' ? 'abaixo' : 'acima'} da linha '
303:             '${line.toStringAsFixed(1)} em ${pct5.toStringAsFixed(0)}%');
304:       }
305:     }
306: 
307:     // 3. Tendência (avg5 vs avg10)
308:     if (playerAvg5 != null && playerAvg10 != null && playerAvg10 > 0) {
309:       final trendPct = (playerAvg5 - playerAvg10) / playerAvg10 * 100;
310:       if (trendPct >= 10) {
311:         parts.add('Jogador em alta: méd. últimos 5j '
312:             '(${playerAvg5.toStringAsFixed(1)}) é '
313:             '${trendPct.toStringAsFixed(0)}% acima da méd. 10j '
314:             '(${playerAvg10.toStringAsFixed(1)})');
315:       } else if (trendPct <= -10) {
316:         parts.add('Jogador em queda: méd. últimos 5j '
317:             '(${playerAvg5.toStringAsFixed(1)}) é '
318:             '${trendPct.abs().toStringAsFixed(0)}% abaixo da méd. 10j '
319:             '(${playerAvg10.toStringAsFixed(1)})');
320:       } else {
321:         parts.add('Forma estável: méd. 5j (${playerAvg5.toStringAsFixed(1)}) '
322:             'alinhada com méd. 10j (${playerAvg10.toStringAsFixed(1)})');
323:       }
324:     }
325: 
326:     // 4. Média geral vs linha
327:     if (playerAvg != null && line > 0) {
328:       final diffAvg = playerAvg - line;
329:       final pctAvg = (diffAvg.abs() / line * 100);
330:       final favorsAvg =
331:           (side == 'Over' && diffAvg > 0) || (side == 'Under' && diffAvg < 0);
332:       if (pctAvg >= 15) {
333:         parts.add('Média histórica (${playerAvg.toStringAsFixed(1)}) '
334:             '${favorsAvg ? 'consistentemente favorável' : 'contra a aposta'} '
335:             '— linha ${pctAvg.toStringAsFixed(0)}% '
336:             '${favorsAvg ? 'abaixo' : 'acima'} da média');
337:       }
338:     }
339: 
340:     // 5. Consistência
341:     if (playerStd != null && playerAvg != null && playerAvg > 0) {
342:       final cv = playerStd / playerAvg;
343:       if (cv < 0.2) {
344:         parts.add('Jogador muito consistente '
345:             '(desvio padrão baixo: ${playerStd.toStringAsFixed(1)})');
346:       } else if (cv > 0.45) {
347:         parts.add('Jogador volátil — alto desvio padrão '
348:             '(${playerStd.toStringAsFixed(1)}), resultados imprevisíveis');
349:       }
350:     }
351: 
352:     // 6. Kelly e mercado
353:     if (inefficientMarket) {
354:       parts.add('Mercado ineficiente detectado — oportunidade de valor real');
355:     }
356:     if (kelly >= 8) {
357:       parts.add(
358:           'Kelly Criterion recomenda aposta de ${kelly.toStringAsFixed(1)}% '
359:           'da banca — sinal forte');
360:     } else if (kelly >= 3) {
361:       parts.add('Kelly sugere ${kelly.toStringAsFixed(1)}% da banca');
362:     }
363:     if (lowSample) {
364:       parts.add('Amostra reduzida de jogos — validar com contexto recente');
365:     }
366: 
367:     return parts.join('\n');
368:   }
