343: async function getMlbPlayerStats() {
344:   let existing = {};
345:   if (fs.existsSync('mlb_player_stats.json')) {
346:     try {
347:       existing = JSON.parse(fs.readFileSync('mlb_player_stats.json', 'utf-8'));
348:       console.log(`Stats existentes carregados: ${Object.keys(existing).length} jogadores.`);
349:     } catch {
350:       console.warn('mlb_player_stats.json inválido — iniciando do zero.');
351:     }
352:   }
353: 
354:   const lastDate = getLastProcessedDate(existing);
355:   let months;
356: 
357:   if (lastDate) {
358:     console.log(`Última data processada: ${lastDate}`);
359:     months = getIncrementalRange(lastDate);
360:     console.log(`Modo incremental: buscando de ${months[0].start} até ${months[0].end}`);
361:   } else {
362:     console.log('Nenhum dado existente — processando histórico completo.');
363:     months = FULL_MONTHS;
364:   }
365: 
366:   const allEvents = [];
367:   for (const { start, end, season } of months) {
368:     console.log(`Buscando eventos: ${start}–${end} (temporada ${season})...`);
369:     try {
370:       const events = await fetchEventIds(start, end);
371:       for (const ev of events) ev._season = season;
372:       allEvents.push(...events);
373:       console.log(`  ${events.length} jogos completos`);
374:     } catch (e) {
375:       console.error(`Erro ao buscar IDs ${start}:`, e.message);
376:     }
377:     await sleep(200);
378:   }
379: 
380:   allEvents.sort((a, b) => new Date(a.date) - new Date(b.date));
381:   console.log(`Total de jogos a processar: ${allEvents.length}`);
382: 
383:   if (!allEvents.length) {
384:     console.log('Nenhum jogo novo encontrado. Stats já atualizados.');
385:     return;
386:   }
387: 
388:   const teamGameDates = {};
389:   for (const playerData of Object.values(existing)) {
390:     for (const seasonData of Object.values(playerData)) {
391:       for (const gameTypeData of Object.values(seasonData)) {
392:         for (const loc of ['home', 'away']) {
393:           const ctx = gameTypeData[loc];
394:           if (!ctx) continue;
395:           const refKey = (ctx.hits || []).length > 0 ? 'hits' : 'strikeouts';
396:           for (const entry of ctx[refKey] || []) {
397:             if (!entry._team || !entry.date) continue;
398:             if (!teamGameDates[entry._team]) teamGameDates[entry._team] = [];
399:             if (!teamGameDates[entry._team].includes(entry.date))
400:               teamGameDates[entry._team].push(entry.date);
401:           }
402:         }
403:       }
404:     }
405:   }
406:   for (const dates of Object.values(teamGameDates)) dates.sort();
407: 
408:   const totalBoxScores = await processEvents(allEvents, existing, teamGameDates);
409: 
410:   console.log(`${totalBoxScores} box scores processados. Recalculando ausentes...`);
411:   recalculateAbsents(existing);
412:   buildTeamRatings(existing);
413:   stripInternalFields(existing);
414: 
415:   const playerStats = {};
416:   for (const [name, seasons] of Object.entries(existing)) {
417:     let totalGames = 0;
418:     for (const seasonData of Object.values(seasons)) {
419:       for (const gameTypeData of Object.values(seasonData)) {
420:         totalGames += (gameTypeData.home?.games || 0) + (gameTypeData.away?.games || 0);
421:       }
422:     }
423:     if (totalGames < MIN_GAMES_TOTAL) continue;
424:     playerStats[name] = seasons;
425:   }
426: 
427:   if (!Object.keys(playerStats).length) {
428:     console.error('ERRO: nenhum jogador processado.');
429:     return;
430:   }
431: 
432:   fs.writeFileSync('mlb_player_stats.json', JSON.stringify(playerStats, null, 2));
433:   console.log(`Stats salvos: ${Object.keys(playerStats).length} jogadores, ${totalBoxScores} novos box scores.`);
434: }
435: 
436: getMlbPlayerStats();
</file>

