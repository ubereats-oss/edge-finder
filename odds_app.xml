 70:   // ── Conversão Firestore → Map ──────────────────────────────────────────────
 71:   static Map<String, dynamic> _firestoreToMap(Map<String, dynamic> fields) {
 72:     final result = <String, dynamic>{};
 73:     for (final entry in fields.entries) {
 74:       result[entry.key] = _firestoreValue(entry.value as Map<String, dynamic>);
 75:     }
 76:     return result;
 77:   }
