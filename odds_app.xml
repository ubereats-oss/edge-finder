209: function recalculateAbsents(raw) {
210:   const habituais = {};
211:   for (const [playerName, playerData] of Object.entries(raw)) {
212:     for (const [seasonStr, seasonData] of Object.entries(playerData)) {
213:       const season = parseInt(seasonStr);
214:       for (const gameType of ['regular', 'playoffs']) {
215:         for (const loc of ['home', 'away']) {
216:           const ctx = seasonData[gameType]?.[loc];
217:           if (!ctx) continue;
218:           const refKey = (ctx.hits || []).length > 0 ? 'hits' : 'strikeouts';
219:           for (const entry of ctx[refKey] || []) {
220:             const team = entry._team;
221:             if (!team) continue;
222:             if (!habituais[team]) habituais[team] = {};
223:             if (!habituais[team][season]) habituais[team][season] = {};
224:             if (!habituais[team][season][playerName]) habituais[team][season][playerName] = { total: 0 };
225:             habituais[team][season][playerName].total++;
226:           }
227:         }
228:       }
229:     }
230:   }
231: 
232:   const starterSets = {};
233:   for (const [team, seasons] of Object.entries(habituais)) {
234:     starterSets[team] = {};
235:     for (const [season, players] of Object.entries(seasons)) {
236:       starterSets[team][season] = new Set();
237:       for (const [player, counts] of Object.entries(players)) {
238:         if (counts.total >= MIN_STARTER_GAMES) starterSets[team][season].add(player);
239:       }
240:     }
241:   }
242: 
243:   const presentMap = {};
244:   for (const [playerName, playerData] of Object.entries(raw)) {
245:     for (const seasonData of Object.values(playerData)) {
246:       for (const gameType of ['regular', 'playoffs']) {
247:         for (const loc of ['home', 'away']) {
248:           const ctx = seasonData[gameType]?.[loc];
249:           if (!ctx) continue;
250:           const refKey = (ctx.hits || []).length > 0 ? 'hits' : 'strikeouts';
251:           for (const entry of ctx[refKey] || []) {
252:             const key = `${entry._eventDate}|${entry._team}`;
253:             if (!presentMap[key]) presentMap[key] = new Set();
254:             presentMap[key].add(playerName);
255:           }
256:         }
257:       }
258:     }
259:   }
260: 
261:   for (const [, playerData] of Object.entries(raw)) {
262:     for (const [seasonStr, seasonData] of Object.entries(playerData)) {
263:       const season = parseInt(seasonStr);
264:       for (const gameType of ['regular', 'playoffs']) {
265:         for (const loc of ['home', 'away']) {
266:           const ctx = seasonData[gameType]?.[loc];
267:           if (!ctx) continue;
268:           for (const statKey of ALL_STAT_KEYS) {
269:             for (const entry of ctx[statKey] || []) {
270:               const key = `${entry._eventDate}|${entry._team}`;
271:               const present  = presentMap[key] || new Set();
272:               const starters = starterSets[entry._team]?.[season] || new Set();
273:               entry.absentStarters = [...starters].filter(s => !present.has(s));
274:             }
275:           }
276:         }
277:       }
278:     }
279:   }
280: }
