1272:     final impliedProb =
1273:         modelProb > 0 && ((bet['impliedProb'] as num?)?.toDouble() ?? 0) == 0
1274:             ? (1 / odds * 100)
1275:             : (bet['impliedProb'] as num?)?.toDouble() ?? 0;
1276:     final edge = modelProb > 0 && ((bet['edge'] as num?)?.toDouble() ?? 0) == 0
1277:         ? modelProb - (1 / odds * 100)
1278:         : (bet['edge'] as num?)?.toDouble() ?? 0;
1279: 
1280:     final ev = modelProb > 0
