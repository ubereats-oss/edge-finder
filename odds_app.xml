106: 
107:         // Agrega a melhor odd Over e Under por mercado entre todas as casas disponíveis
108:         const bestMarkets = {};
109:         for (const bm of data.bookmakers) {
110:           for (const mkt of (bm.markets ?? [])) {
111:             if (!bestMarkets[mkt.key]) bestMarkets[mkt.key] = { key: mkt.key, bestOutcomes: {} };
112:             for (const outcome of mkt.outcomes) {
113:               const k = `${outcome.description}||${outcome.name}`;
114:               if (!bestMarkets[mkt.key].bestOutcomes[k] ||
115:                   outcome.price > bestMarkets[mkt.key].bestOutcomes[k].price) {
116:                 bestMarkets[mkt.key].bestOutcomes[k] = outcome;
117:               }
118:             }
119:           }
120:         }
121: 
122:         for (const market of Object.values(bestMarkets)) {
