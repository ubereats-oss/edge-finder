109: // ── Extrai registros de jogo a partir de nhl_player_stats.json ───────────────
110: // Retorna array de { playerName, date, location, season, stats, blowout, toiSeconds }
111: // Um registro por (jogador × jogo), ordenado por data.
112: // Todos os stats de um jogo compartilham o mesmo índice no array do ctx.
113: function extractPlayerGames(playerStats, seasons) {
114:   const games = [];
115:   for (const [playerName, playerData] of Object.entries(playerStats)) {
116:     for (const [seasonStr, seasonData] of Object.entries(playerData)) {
117:       const season = parseInt(seasonStr);
118:       if (!seasons.includes(season)) continue;
119:       for (const gameType of ['regular', 'playoffs']) {
120:         for (const loc of ['home', 'away']) {
121:           const ctx = seasonData[gameType]?.[loc];
122:           if (!ctx || !ctx.goals || ctx.goals.length === 0) continue;
123:           const n = ctx.goals.length;
124:           for (let i = 0; i < n; i++) {
125:             const base = ctx.goals[i]; // porta date, blowout, toiSeconds
126:             const stats = {};
127:             for (const stat of STAT_KEYS) {
128:               const arr = ctx[stat];
129:               stats[stat] = arr && arr[i] !== undefined ? (arr[i].value ?? 0) : 0;
130:             }
131:             games.push({
132:               playerName,
133:               date:       base.date       || '',
134:               location:   loc,
135:               season,
136:               stats,
137:               blowout:    base.blowout    || false,
138:               toiSeconds: base.toiSeconds || 0,
139:               opponent:   base.opponent   || '',
140:             });
141:           }
142:         }
143:       }
144:     }
145:   }
146:   return games.sort((a, b) => a.date.localeCompare(b.date));
147: }
