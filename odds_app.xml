371: 
372:   // Cache por sport: Map<playerNameLower, {status, detail, team}>
373:   static final Map<String, Map<String, Map<String, String>>> _injuryCache = {};
374:   static final Map<String, DateTime> _injuryCacheTime = {};
375:   static const _cacheTtl = Duration(minutes: 30);
376: 
377:   static String _injurySportPath(String sport) {
378:     final s = sport.toLowerCase();
379:     if (s.contains('mlb') || s.contains('beisebol')) return 'baseball/mlb';
380:     if (s.contains('nhl') || s.contains('hockey')) return 'hockey/nhl';
381:     if (s.contains('nfl') || s.contains('americano')) return 'football/nfl';
382:     return 'basketball/nba';
383:   }
384: 
385:   static Future<Map<String, Map<String, String>>> _fetchInjuries(
386:       String sport) async {
387:     final now = DateTime.now();
388:     if (_injuryCache.containsKey(sport) &&
389:         now.difference(_injuryCacheTime[sport]!) < _cacheTtl) {
390:       return _injuryCache[sport]!;
391:     }
392:     final path = _injurySportPath(sport);
393:     try {
394:       final res = await http
395:           .get(Uri.parse(
396:               'https://site.api.espn.com/apis/site/v2/sports/$path/injuries'))
397:           .timeout(const Duration(seconds: 8));
398:       if (res.statusCode != 200) return {};
399:       final body = jsonDecode(res.body) as Map<String, dynamic>;
400:       final teams = body['teams'] as List? ?? [];
401:       final result = <String, Map<String, String>>{};
402:       for (final t in teams) {
403:         final teamName =
404:             (t['team']?['displayName'] as String? ?? '').toLowerCase();
405:         final injuries = t['injuries'] as List? ?? [];
406:         for (final inj in injuries) {
407:           final name =
408:               (inj['athlete']?['displayName'] as String? ?? '').toLowerCase();
409:           if (name.isEmpty) continue;
410:           final status = inj['status'] as String? ??
411:               inj['type']?['abbreviation'] as String? ??
412:               '';
413:           final detail = inj['details']?['type'] as String? ?? '';
414:           result[name] = {'status': status, 'detail': detail, 'team': teamName};
415:         }
416:       }
417:       _injuryCache[sport] = result;
418:       _injuryCacheTime[sport] = now;
419:       return result;
420:     } catch (_) {
421:       return {};
422:     }
423:   }
424: 
425:   static int _injuryStatusScore(String status) {
426:     final s = status.toUpperCase();
427:     if (s == 'OUT' || s == 'O') return -3;
428:     if (s == 'DOUBTFUL' || s == 'D') return -2;
429:     if (s == 'QUESTIONABLE' || s == 'Q' || s == 'DTD') return -1;
430:     if (s == 'PROBABLE' || s == 'P') return 0;
431:     return 0;
432:   }
433: 
434:   /// Enriquece cada prop com _contextScore, _contextLabel, _contextReason.
435:   /// Se a API falhar, todas as props ficam com contextScore=0 (neutro).
436:   static Future<List<Map<String, dynamic>>> enrichWithContext(
437:       List<Map<String, dynamic>> props, String sport) async {
438:     final injuries = await _fetchInjuries(sport);
439:     if (injuries.isEmpty) {
440:       return props.map((p) {
441:         final cl = _contradictionLevel(p);
442:         final prob = calibratedProb(p);
443:         return {
444:           ...p,
445:           '_contextScore': 0,
446:           '_contextLabel': '0',
447:           '_contextReason': 'sem dados externos disponíveis',
448:           '_probFinal': prob,
449:           '_probCalibrada': prob,
450:           '_contextStatus': 'unknown',
451:           '_contextConfirmed': false,
452:           '_contradictionLevel': cl,
453:         };
454:       }).toList();
455:     }
456: 
457:     // Mapa time → contagem de OUT/DOUBTFUL (score <= -2)
458:     final teamSevere = <String, int>{};
459:     for (final e in injuries.entries) {
460:       final score = _injuryStatusScore(e.value['status'] ?? '');
461:       if (score <= -2) {
462:         final team = e.value['team'] ?? '';
463:         teamSevere[team] = (teamSevere[team] ?? 0) + 1;
464:       }
465:     }
466: 
467:     return props.map((p) {
468:       final playerKey = (p['player'] as String? ?? '').toLowerCase();
469:       final playerTeam = (p['playerTeam'] as String? ?? '').toLowerCase();
470:       final injury = injuries[playerKey];
471: 
472:       int contextScore;
473:       String reason;
474: 
475:       if (injury != null) {
476:         contextScore = _injuryStatusScore(injury['status'] ?? '');
477:         final detail = injury['detail'] ?? '';
478:         if (contextScore <= -3) {
479:           reason =
480:               'Jogador confirmado fora${detail.isNotEmpty ? " ($detail)" : ""}';
481:         } else if (contextScore == -2) {
482:           reason = 'Jogador duvidoso${detail.isNotEmpty ? " ($detail)" : ""}';
483:         } else if (contextScore == -1) {
484:           reason =
485:               'Jogador questionável${detail.isNotEmpty ? " ($detail)" : ""}';
486:         } else {
487:           reason = 'Jogador provável';
488:         }
489:       } else {
490:         final severeCount = teamSevere[playerTeam] ?? 0;
491:         if (severeCount >= 3) {
492:           contextScore = 3;
493:           reason = '$severeCount ausências no time — aumento forte de minutos';
494:         } else if (severeCount >= 2) {
495:           contextScore = 2;
496:           reason = '$severeCount jogadores ausentes — aumento de uso esperado';
497:         } else if (severeCount == 1) {
498:           contextScore = 1;
499:           reason = 'Titular do time ausente — possível aumento de uso';
500:         } else {
501:           contextScore = 0;
502:           reason = 'Sem lesões relevantes no time';
503:         }
504:       }
505: 
506:       final probCal = calibratedProb(p);
507:       final probFinal = (probCal + contextScore * 0.04).clamp(0.0, 1.0);
508:       final scoreStr = contextScore > 0 ? '+$contextScore' : '$contextScore';
509:       final contextConfirmed =
510:           injury != null || (teamSevere[playerTeam] ?? 0) > 0;
511:       final contextStatus = contextScore >= 1
512:           ? 'positive'
513:           : contextScore <= -1
514:               ? 'negative'
515:               : contextConfirmed
516:                   ? 'neutral'
517:                   : 'unknown';
518:       if (!contextConfirmed) reason = 'sem contexto externo confirmado';
519: 
520:       final cl = _contradictionLevel(p);
521: 
522:       return {
523:         ...p,
524:         '_contextScore': contextScore,
525:         '_contextLabel': scoreStr,
526:         '_contextReason': reason,
527:         '_probFinal': probFinal,
528:         '_probCalibrada': probCal,
529:         '_contextStatus': contextStatus,
530:         '_contextConfirmed': contextConfirmed,
531:         '_contradictionLevel': cl,
532:       };
533:     }).toList();
534:   }
