 278:   static String generateLocalJustification(Map<String, dynamic> p) {
 279:     final edge = (p['edge'] as num?)?.toDouble() ?? 0;
 280:     final modelProb = (p['modelProb'] as num?)?.toDouble() ?? 50;
 281:     final impliedProb = (p['impliedProb'] as num?)?.toDouble() ?? 50;
 282:     final kelly = (p['kelly'] as num?)?.toDouble() ?? 0;
 283:     final lowSample = p['lowSample'] == true;
 284:     final inefficientMarket = p['inefficientMarket'] == true;
 285:     final playerAvg = (p['playerAvg'] as num?)?.toDouble();
 286:     final playerAvg5 = (p['playerAvg5'] as num?)?.toDouble();
 287:     final playerAvg10 = (p['playerAvg10'] as num?)?.toDouble();
 288:     final playerStd = (p['playerStd'] as num?)?.toDouble();
 289:     final line = (p['line'] as num?)?.toDouble() ?? 0;
 290:     final side = p['side'] as String? ?? 'Over';
 291: 
 292:     final parts = <String>[];
 293: 
 294:     // 1. Qualidade do edge
 295:     final gap = modelProb - impliedProb;
 296:     if (edge >= 15) {
 297:       parts.add('Edge excepcional de ${edge.toStringAsFixed(1)}% '
 298:           '(modelo ${modelProb.toStringAsFixed(1)}% vs mercado ${impliedProb.toStringAsFixed(1)}%)');
 299:     } else if (edge >= 8) {
 300:       parts.add('Edge alto de ${edge.toStringAsFixed(1)}% '
 301:           '(vantagem de ${gap.toStringAsFixed(1)}pp sobre o mercado)');
 302:     } else if (edge >= 4) {
 303:       parts.add('Edge razoável de ${edge.toStringAsFixed(1)}% '
 304:           '(modelo ${modelProb.toStringAsFixed(1)}% vs ${impliedProb.toStringAsFixed(1)}% do mercado)');
 305:     } else {
 306:       parts.add('Edge baixo de ${edge.toStringAsFixed(1)}% — risco elevado');
 307:     }
 308: 
 309:     // 2. Forma recente vs linha
 310:     if (playerAvg5 != null && line > 0) {
 311:       final diff5 = playerAvg5 - line;
 312:       final pct5 = (diff5.abs() / line * 100);
 313:       final favors5 =
 314:           (side == 'Over' && diff5 > 0) || (side == 'Under' && diff5 < 0);
 315:       if (favors5) {
 316:         parts.add('Méd. últimos 5 jogos (${playerAvg5.toStringAsFixed(1)}) '
 317:             '${side == 'Over' ? 'acima' : 'abaixo'} da linha '
 318:             '${line.toStringAsFixed(1)} em ${pct5.toStringAsFixed(0)}%');
 319:       } else {
 320:         parts.add('ATENÇÃO: méd. 5j (${playerAvg5.toStringAsFixed(1)}) '
 321:             '${side == 'Over' ? 'abaixo' : 'acima'} da linha '
 322:             '${line.toStringAsFixed(1)} em ${pct5.toStringAsFixed(0)}%');
 323:       }
 324:     }
 325: 
 326:     // formWarning
 327:     final formWarning = p['formWarning'] == true;
 328:     if (formWarning) {
 329:       parts.add('⚠️ Forma recente contra a direção da aposta');
 330:     }
 331: 
 332:     // 3. Tendência (avg5 vs avg10)
 333:     if (playerAvg5 != null && playerAvg10 != null && playerAvg10 > 0) {
 334:       final trendPct = (playerAvg5 - playerAvg10) / playerAvg10 * 100;
 335:       if (trendPct >= 10) {
 336:         parts.add('Jogador em alta: méd. últimos 5j '
 337:             '(${playerAvg5.toStringAsFixed(1)}) é '
 338:             '${trendPct.toStringAsFixed(0)}% acima da méd. 10j '
 339:             '(${playerAvg10.toStringAsFixed(1)})');
 340:       } else if (trendPct <= -10) {
 341:         parts.add('Jogador em queda: méd. últimos 5j '
 342:             '(${playerAvg5.toStringAsFixed(1)}) é '
 343:             '${trendPct.abs().toStringAsFixed(0)}% abaixo da méd. 10j '
 344:             '(${playerAvg10.toStringAsFixed(1)})');
 345:       } else {
 346:         parts.add('Forma estável: méd. 5j (${playerAvg5.toStringAsFixed(1)}) '
 347:             'alinhada com méd. 10j (${playerAvg10.toStringAsFixed(1)})');
 348:       }
 349:     }
 350: 
 351:     // 4. Média geral vs linha
 352:     if (playerAvg != null && line > 0) {
 353:       final diffAvg = playerAvg - line;
 354:       final pctAvg = (diffAvg.abs() / line * 100);
 355:       final favorsAvg =
 356:           (side == 'Over' && diffAvg > 0) || (side == 'Under' && diffAvg < 0);
 357:       if (pctAvg >= 15) {
 358:         parts.add('Média histórica (${playerAvg.toStringAsFixed(1)}) '
 359:             '${favorsAvg ? 'consistentemente favorável' : 'contra a aposta'} '
 360:             '— linha ${pctAvg.toStringAsFixed(0)}% '
 361:             '${favorsAvg ? 'abaixo' : 'acima'} da média');
 362:       }
 363:     }
 364: 
 365:     // 5. Consistência
 366:     if (playerStd != null && playerAvg != null && playerAvg > 0) {
 367:       final cv = playerStd / playerAvg;
 368:       if (cv < 0.2) {
 369:         parts.add('Jogador muito consistente '
 370:             '(desvio padrão baixo: ${playerStd.toStringAsFixed(1)})');
 371:       } else if (cv > 0.45) {
 372:         parts.add('Jogador volátil — alto desvio padrão '
 373:             '(${playerStd.toStringAsFixed(1)}), resultados imprevisíveis');
 374:       }
 375:     }
 376: 
 377:     // 6. Kelly e mercado
 378:     if (inefficientMarket) {
 379:       parts.add('Mercado ineficiente detectado — oportunidade de valor real');
 380:     }
 381:     if (kelly >= 8) {
 382:       parts.add(
 383:           'Kelly Criterion recomenda aposta de ${kelly.toStringAsFixed(1)}% '
 384:           'da banca — sinal forte');
 385:     } else if (kelly >= 3) {
 386:       parts.add('Kelly sugere ${kelly.toStringAsFixed(1)}% da banca');
 387:     }
 388:     if (lowSample) {
 389:       parts.add('Amostra reduzida de jogos — validar com contexto recente');
 390:     }
 391: 
 392:     return parts.join('\n');
 393:   }
