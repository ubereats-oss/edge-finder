 1: const axios = require('axios');
 2: const fs = require('fs');
 3: 
 4: if (fs.existsSync('.env')) {
 5:   for (const line of fs.readFileSync('.env', 'utf-8').split('\n')) {
 6:     const [k, ...v] = line.split('=');
 7:     if (k) process.env[k.trim()] = v.join('=').trim();
 8:   }
 9: }
10: 
11: const API_KEYS = [];
12: for (let i = 1; i <= 19; i++) {
13:   const key = i === 1 ? process.env.ODDS_API_KEY : process.env[`ODDS_API_KEY_${i}`];
14:   if (key && key.trim()) API_KEYS.push(key.trim());
15: }
16: if (!API_KEYS.length) { console.error('Nenhuma chave ODDS_API_KEY encontrada.'); process.exit(1); }
17: 
18: async function getOdds() {
19:   let lastError = null;
20:   for (let i = 0; i < API_KEYS.length; i++) {
21:     try {
22:       const url = `https://api.the-odds-api.com/v4/sports/tennis_atp/odds/?apiKey=${API_KEYS[i]}&regions=eu&markets=h2h`;
23:       const response = await axios.get(url);
24:       const remaining = response.headers['x-requests-remaining'];
25:       if (remaining !== undefined) console.log(`Créditos restantes: ${remaining}`);
26:       const odds = [];
27:       response.data.forEach(match => {
28:         if (!match.bookmakers.length) return;
29:         const bookmaker = match.bookmakers[0];
30:         const market = bookmaker.markets.find(m => m.key === 'h2h');
31:         if (!market) return;
32:         const p1 = market.outcomes[0];
33:         const p2 = market.outcomes[1];
34:         odds.push({ player1: p1.name, player2: p2.name, odds1: p1.price, odds2: p2.price });
35:       });
36:       fs.writeFileSync('odds.json', JSON.stringify(odds, null, 2));
37:       console.log('Odds salvas');
38:       return;
39:     } catch (err) {
40:       const msg = err.response?.data?.message || err.message || '';
41:       if (msg.toLowerCase().includes('quota')) {
42:         console.warn(`    Chave esgotada (${i + 1}/${API_KEYS.length}), tentando próxima...`);
43:         lastError = err;
44:         continue;
45:       }
46:       console.error('Erro ao buscar odds:', err.response?.status, err.response?.data || err.message);
47:       return;
48:     }
49:   }
50:   console.error('Erro ao buscar odds: todas as chaves esgotadas.', lastError?.response?.data || lastError?.message);
51: }
52: 
53: getOdds();
