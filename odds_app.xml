135: // Processa eventos e acumula em `raw` (pode ser existente ou vazio)
136: async function processEvents(allEvents, raw, teamGameDates) {
137:   let totalBoxScores = 0;
138: 
139:   for (const event of allEvents) {
140:     const season = event._season;
141:     try {
142:       const { players: teams, teamStats } = await fetchBoxScore(event.id);
143:       totalBoxScores++;
144: 
145:       const isBackToBack = {};
146:       for (const teamName of [event.homeTeam, event.awayTeam]) {
147:         if (!teamName) continue;
148:         if (!teamGameDates[teamName]) teamGameDates[teamName] = [];
149:         const prev = teamGameDates[teamName];
150:         if (prev.length > 0) {
151:           const diffDays = (new Date(event.date) - new Date(prev[prev.length - 1])) / 86400000;
152:           isBackToBack[teamName] = diffDays <= 1;
153:         } else {
154:           isBackToBack[teamName] = false;
155:         }
156:         teamGameDates[teamName].push(event.date);
157:       }
158: 
159:       const teamFouls = {};
160:       for (const ts of teamStats || []) {
161:         const tName = ts.team?.displayName;
162:         if (!tName) continue;
163:         for (const stat of ts.statistics || []) {
164:           if (stat.name === 'teamFouls' || stat.abbreviation === 'PF') {
165:             teamFouls[tName] = parseInt(stat.displayValue) || 0;
166:             break;
167:           }
168:         }
169:       }
170: 
171:       const opponentFouls = {
172:         [event.homeTeam]: teamFouls[event.awayTeam] || 0,
173:         [event.awayTeam]: teamFouls[event.homeTeam] || 0,
174:       };
175: 
176:       for (const team of teams) {
177:         const teamName = team.team?.displayName;
178:         if (!teamName) continue;
179:         const isHome = teamName === event.homeTeam;
180:         const location = isHome ? 'home' : 'away';
181:         const gameType = event.seasonType;
182:         const opponent = isHome ? event.awayTeam : event.homeTeam;
183:         const won = isHome ? event.homeWon : !event.homeWon;
184:         const teamScore = isHome ? event.homeScore : event.awayScore;
185:         const oppScore = isHome ? event.awayScore : event.homeScore;
186: 
187:         const group = team.statistics?.[0];
188:         if (!group) continue;
189: 
190:         const labels = group.labels || [];
191:         const idxMin   = labels.indexOf('MIN');
192:         const idxPts   = labels.indexOf('PTS');
193:         const idxReb   = labels.indexOf('REB');
194:         const idxAst   = labels.indexOf('AST');
195:         const idxStl   = labels.indexOf('STL');
196:         const idxPf    = labels.indexOf('PF');
197:         const idxThree = labels.indexOf('3PT');
198: 
199:         const parseThrees = str => {
200:           if (!str) return 0;
201:           return parseFloat(str.split('-')[0]) || 0;
202:         };
203: 
204:         for (const athlete of group.athletes || []) {
205:           const stats = athlete.stats || [];
206:           const minutes = parseFloat(stats[idxMin]) || 0;
207:           if (minutes < 5) continue;
208: 
209:           const name = athlete.athlete?.displayName;
210:           if (!name) continue;
211: 
212:           // Pula entrada duplicada (jogo já processado)
213:           const ctx = ensurePath(raw, name, season, gameType, location);
214:           const alreadyExists = ctx.points.some(e => e.date === event.date && e.opponent === opponent);
215:           if (alreadyExists) continue;
216: 
217:           ctx.games++;
218: 
219:           const meta = {
220:             date: event.date,
221:             minutes,
222:             isBackToBack: isBackToBack[teamName] || false,
223:             blowout: event.blowout,
224:             isOvertime: event.isOvertime,
225:             won,
226:             teamScore,
227:             oppScore,
228:             opponent,
229:             opponentFouls: opponentFouls[teamName] || 0,
230:             _team: teamName,
231:             _eventDate: event.date,
232:             absentStarters: [],
233:           };
234: 
235:           const mkEntry = v => ({ ...meta, value: v });
236: 
237:           ctx.points.push(mkEntry(parseFloat(stats[idxPts]) || 0));
238:           ctx.rebounds.push(mkEntry(parseFloat(stats[idxReb]) || 0));
239:           ctx.assists.push(mkEntry(parseFloat(stats[idxAst]) || 0));
240:           ctx.steals.push(mkEntry(parseFloat(stats[idxStl]) || 0));
241:           ctx.fouls.push(mkEntry(parseFloat(stats[idxPf]) || 0));
242:           ctx.threes.push(mkEntry(parseThrees(stats[idxThree])));
243:         }
244:       }
245:     } catch {
246:       // box score indisponível
247:     }
248:     await sleep(100);
249:   }
250: 
251:   return totalBoxScores;
252: }
