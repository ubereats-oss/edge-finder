349: async function getPlayerStats() {
350:   // Carrega dados existentes (incremental) ou inicia do zero
351:   let existing = {};
352:   if (fs.existsSync('nba_player_stats.json')) {
353:     try {
354:       existing = JSON.parse(fs.readFileSync('nba_player_stats.json', 'utf-8'));
355:       console.log(`Stats existentes carregados: ${Object.keys(existing).length} jogadores.`);
356:     } catch {
357:       console.warn('nba_player_stats.json inválido — iniciando do zero.');
358:     }
359:   }
360: 
361:   const lastDate = getLastProcessedDate(existing);
362:   let months;
363: 
364:   if (lastDate) {
365:     console.log(`Última data processada: ${lastDate}`);
366:     months = getIncrementalRange(lastDate);
367:     console.log(`Modo incremental: buscando de ${months[0].start} até ${months[0].end}`);
368:   } else {
369:     console.log('Nenhum dado existente — processando histórico completo.');
370:     months = FULL_MONTHS;
371:   }
372: 
373:   // Coleta eventos do período
374:   const allEvents = [];
375:   for (const { start, end, season } of months) {
376:     console.log(`Buscando eventos: ${start}–${end} (temporada ${season})...`);
377:     try {
378:       const events = await fetchEventIds(start, end);
379:       for (const ev of events) ev._season = season;
380:       allEvents.push(...events);
381:       console.log(`  ${events.length} jogos completos`);
382:     } catch (e) {
383:       console.error(`Erro ao buscar IDs ${start}:`, e.message);
384:     }
385:   }
386: 
387:   allEvents.sort((a, b) => new Date(a.date) - new Date(b.date));
388:   console.log(`Total de jogos a processar: ${allEvents.length}`);
389: 
390:   if (!allEvents.length) {
391:     console.log('Nenhum jogo novo encontrado. Stats já atualizados.');
392:     return;
393:   }
394: 
395:   // Reconstrói teamGameDates a partir dos dados existentes (para back-to-back correto)
396:   const teamGameDates = {};
397:   for (const playerData of Object.values(existing)) {
398:     for (const seasonData of Object.values(playerData)) {
399:       for (const gameTypeData of Object.values(seasonData)) {
400:         for (const loc of ['home', 'away']) {
401:           const ctx = gameTypeData[loc];
402:           if (!ctx) continue;
403:           for (const entry of ctx.points || []) {
404:             if (!entry._team || !entry.date) continue;
405:             if (!teamGameDates[entry._team]) teamGameDates[entry._team] = [];
406:             if (!teamGameDates[entry._team].includes(entry.date)) {
407:               teamGameDates[entry._team].push(entry.date);
408:             }
409:           }
410:         }
411:       }
412:     }
413:   }
414:   for (const dates of Object.values(teamGameDates)) {
415:     dates.sort();
416:   }
417: 
418:   // Processa novos box scores mesclando com existing
419:   const totalBoxScores = await processEvents(allEvents, existing, teamGameDates);
420: 
421:   console.log(`${totalBoxScores} box scores processados. Recalculando ausentes...`);
422:   recalculateAbsents(existing);
423:   stripInternalFields(existing);
424: 
425:   // Filtra jogadores com menos de 10 jogos
426:   const playerStats = {};
427:   for (const [name, seasons] of Object.entries(existing)) {
428:     let totalGames = 0;
429:     for (const seasonData of Object.values(seasons)) {
430:       for (const gameTypeData of Object.values(seasonData)) {
431:         totalGames += (gameTypeData.home?.games || 0) + (gameTypeData.away?.games || 0);
432:       }
433:     }
434:     if (totalGames < 10) continue;
435:     playerStats[name] = seasons;
436:   }
437: 
438:   if (!Object.keys(playerStats).length) {
439:     console.error('ERRO: nenhum jogador processado.');
440:     return;
441:   }
442: 
443:   fs.writeFileSync('nba_player_stats.json', JSON.stringify(playerStats, null, 2));
444:   console.log(`Stats salvos: ${Object.keys(playerStats).length} jogadores, ${totalBoxScores} novos box scores.`);
445: }
446: 
447: getPlayerStats();
