282: function buildTeamRatings(raw) {
283:   const ratings = {};
284:   for (const [, playerData] of Object.entries(raw)) {
285:     for (const [seasonStr, seasonData] of Object.entries(playerData)) {
286:       const season = parseInt(seasonStr);
287:       for (const loc of ['home', 'away']) {
288:         const ctx = seasonData.regular?.[loc];
289:         if (!ctx) continue;
290:         const refKey = (ctx.hits || []).length > 0 ? 'hits' : 'strikeouts';
291:         for (const entry of ctx[refKey] || []) {
292:           if (!entry._team || !entry.date) continue;
293:           const team    = entry._team;
294:           const gameKey = `${entry.date}|${entry.opponent}|${loc}`;
295:           if (!ratings[team]) ratings[team] = {};
296:           if (!ratings[team][season]) ratings[team][season] = { regular: {} };
297:           if (!ratings[team][season].regular[loc])
298:             ratings[team][season].regular[loc] = { wins: 0, games: new Set() };
299:           const bucket = ratings[team][season].regular[loc];
300:           if (!bucket.games.has(gameKey)) {
301:             bucket.games.add(gameKey);
302:             if (entry.won) bucket.wins++;
303:           }
304:         }
305:       }
306:     }
307:   }
308: 
309:   const teamRating = {};
310:   for (const [team, seasons] of Object.entries(ratings)) {
311:     teamRating[team] = {};
312:     for (const [season, seasonData] of Object.entries(seasons)) {
313:       teamRating[team][season] = { regular: {} };
314:       for (const loc of ['home', 'away']) {
315:         const bucket = seasonData.regular?.[loc];
316:         if (!bucket || bucket.games.size < 5) continue;
317:         teamRating[team][season].regular[loc] =
318:           parseFloat((bucket.wins / bucket.games.size).toFixed(4));
319:       }
320:     }
321:   }
322: 
323:   fs.writeFileSync('mlb_team_rating.json', JSON.stringify(teamRating, null, 2));
324:   console.log(`mlb_team_rating.json salvo: ${Object.keys(teamRating).length} times.`);
325: }
