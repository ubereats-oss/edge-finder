  1: const axios = require('axios');
  2: const fs = require('fs');
  3: 
  4: const FULL_MONTHS = [
  5:   { start: '20231001', end: '20231031', season: 2024 },
  6:   { start: '20231101', end: '20231130', season: 2024 },
  7:   { start: '20231201', end: '20231231', season: 2024 },
  8:   { start: '20240101', end: '20240131', season: 2024 },
  9:   { start: '20240201', end: '20240229', season: 2024 },
 10:   { start: '20240301', end: '20240331', season: 2024 },
 11:   { start: '20240401', end: '20240430', season: 2024 },
 12:   { start: '20240501', end: '20240531', season: 2024 },
 13:   { start: '20240601', end: '20240630', season: 2024 },
 14:   { start: '20241001', end: '20241031', season: 2025 },
 15:   { start: '20241101', end: '20241130', season: 2025 },
 16:   { start: '20241201', end: '20241231', season: 2025 },
 17:   { start: '20250101', end: '20250131', season: 2025 },
 18:   { start: '20250201', end: '20250228', season: 2025 },
 19:   { start: '20250301', end: '20250331', season: 2025 },
 20:   { start: '20250401', end: '20250430', season: 2025 },
 21:   { start: '20250501', end: '20250531', season: 2025 },
 22:   { start: '20251001', end: '20251031', season: 2026 },
 23:   { start: '20251101', end: '20251130', season: 2026 },
 24:   { start: '20251201', end: '20251231', season: 2026 },
 25:   { start: '20260101', end: '20260131', season: 2026 },
 26:   { start: '20260201', end: '20260228', season: 2026 },
 27:   { start: '20260301', end: '20260331', season: 2026 },
 28:   { start: '20260401', end: '20260430', season: 2026 },
 29: ];
 30: 
 31: const STAT_KEYS = ['goals', 'assists', 'points', 'shots', 'blocked'];
 32: const MIN_TOI_SECONDS = 300;
 33: 
 34: function sleep(ms) {
 35:   return new Promise(resolve => setTimeout(resolve, ms));
 36: }
 37: 
 38: function parseToi(toi) {
 39:   if (!toi) return 0;
 40:   const parts = String(toi).split(':');
 41:   if (parts.length === 2) return parseInt(parts[0]) * 60 + parseInt(parts[1]);
 42:   return 0;
 43: }
 44: 
 45: function emptyContext() {
 46:   const obj = { games: 0 };
 47:   for (const k of STAT_KEYS) obj[k] = [];
 48:   return obj;
 49: }
 50: 
 51: function ensurePath(raw, player, season, gameType, location) {
 52:   if (!raw[player]) raw[player] = {};
 53:   if (!raw[player][season]) raw[player][season] = {};
 54:   if (!raw[player][season][gameType]) {
 55:     raw[player][season][gameType] = { home: emptyContext(), away: emptyContext() };
 56:   }
 57:   return raw[player][season][gameType][location];
 58: }
 59: 
 60: function getLastProcessedDate(existing) {
 61:   let latest = null;
 62:   for (const playerData of Object.values(existing)) {
 63:     for (const seasonData of Object.values(playerData)) {
 64:       for (const gameTypeData of Object.values(seasonData)) {
 65:         for (const loc of ['home', 'away']) {
 66:           const ctx = gameTypeData[loc];
 67:           if (!ctx) continue;
 68:           for (const entries of Object.values(ctx)) {
 69:             if (!Array.isArray(entries)) continue;
 70:             for (const entry of entries) {
 71:               if (entry.date && (!latest || entry.date > latest)) latest = entry.date;
 72:             }
 73:           }
 74:         }
 75:       }
 76:     }
 77:   }
 78:   return latest;
 79: }
 80: 
 81: function getIncrementalRange(lastDate) {
 82:   const last = new Date(lastDate);
 83:   last.setDate(last.getDate() - 2);
 84:   const start = last.toISOString().slice(0, 10).replace(/-/g, '');
 85:   const end = new Date().toISOString().slice(0, 10).replace(/-/g, '');
 86:   const year = parseInt(start.slice(0, 4));
 87:   const month = parseInt(start.slice(4, 6));
 88:   const season = month >= 10 ? year + 1 : year;
 89:   return [{ start, end, season }];
 90: }
 91: 
 92: async function fetchEventIds(start, end) {
 93:   const url = `https://site.api.espn.com/apis/site/v2/sports/hockey/nhl/scoreboard?limit=200&dates=${start}-${end}`;
 94:   const res = await axios.get(url);
 95:   return (res.data.events || [])
 96:     .filter(e => e.competitions[0].status.type.completed)
 97:     .map(e => {
 98:       const comp = e.competitions[0];
 99:       const home = comp.competitors.find(c => c.homeAway === 'home');
100:       const away = comp.competitors.find(c => c.homeAway === 'away');
101:       const homeScore = parseInt(home?.score) || 0;
102:       const awayScore = parseInt(away?.score) || 0;
103:       return {
104:         id: e.id,
105:         date: e.date,
106:         seasonType: e.season?.type === 3 ? 'playoffs' : 'regular',
107:         season: e.season?.year,
108:         homeTeam: home?.team?.displayName,
109:         awayTeam: away?.team?.displayName,
110:         homeScore,
111:         awayScore,
112:         blowout: Math.abs(homeScore - awayScore) >= 4,
113:         homeWon: home?.winner === true,
114:       };
115:     });
116: }
117: 
118: async function fetchBoxScore(eventId) {
119:   const url = `https://site.api.espn.com/apis/site/v2/sports/hockey/nhl/summary?event=${eventId}`;
120:   const res = await axios.get(url);
121:   return res.data.boxscore?.players || [];
122: }
123: 
124: async function processEvents(allEvents, raw) {
125:   let total = 0;
126: 
127:   for (const event of allEvents) {
128:     const season = event._season;
129:     try {
130:       const teams = await fetchBoxScore(event.id);
131:       total++;
132: 
133:       for (const team of teams) {
134:         const teamName = team.team?.displayName;
135:         if (!teamName) continue;
136:         const isHome = teamName === event.homeTeam;
137:         const location = isHome ? 'home' : 'away';
138:         const opponent = isHome ? event.awayTeam : event.homeTeam;
139:         const won = isHome ? event.homeWon : !event.homeWon;
140:         const teamScore = isHome ? event.homeScore : event.awayScore;
141:         const oppScore = isHome ? event.awayScore : event.homeScore;
142: 
143:         const group = team.statistics?.[0];
144:         if (!group) continue;
145: 
146:         const labels = group.labels || [];
147:         const idxToi = labels.findIndex(l => l.toUpperCase() === 'TOI');
148:         const idxG   = labels.findIndex(l => l.toUpperCase() === 'G');
149:         const idxA   = labels.findIndex(l => l.toUpperCase() === 'A');
150:         const idxPts = labels.findIndex(l => l.toUpperCase() === 'PTS');
151:         const idxS   = labels.findIndex(l => l.toUpperCase() === 'SOG' || l.toUpperCase() === 'S');
152:         const idxBs  = labels.findIndex(l => l.toUpperCase() === 'BS' || l.toUpperCase() === 'BLK');
153: 
154:         for (const athlete of group.athletes || []) {
155:           const stats = athlete.stats || [];
156:           const toiSecs = parseToi(stats[idxToi]);
157:           if (toiSecs < MIN_TOI_SECONDS) continue;
158: 
159:           const name = athlete.athlete?.displayName;
160:           if (!name) continue;
161: 
162:           const ctx = ensurePath(raw, name, season, event.seasonType, location);
163:           const alreadyExists = ctx.goals.some(e => e.date === event.date && e.opponent === opponent);
164:           if (alreadyExists) continue;
165: 
166:           ctx.games++;
167: 
168:           const meta = {
169:             date: event.date,
170:             toiSeconds: toiSecs,
171:             blowout: event.blowout,
172:             won,
173:             teamScore,
174:             oppScore,
175:             opponent,
176:             _team: teamName,
177:             _eventDate: event.date,
178:           };
179: 
180:           const mkEntry = v => ({ ...meta, value: v });
181:           const gv = parseInt(stats[idxG]) || 0;
182:           const av = parseInt(stats[idxA]) || 0;
183: 
184:           ctx.goals.push(mkEntry(gv));
185:           ctx.assists.push(mkEntry(av));
186:           ctx.points.push(mkEntry(gv + av));
187:           ctx.shots.push(mkEntry(parseInt(stats[idxS]) || 0));
188:           ctx.blocked.push(mkEntry(parseInt(stats[idxBs]) || 0));
189:         }
190:       }
191:     } catch {
192:       // box score indisponível
193:     }
194:     await sleep(120);
195:   }
196: 
197:   return total;
198: }
199: 
200: function stripInternalFields(raw) {
201:   for (const playerData of Object.values(raw)) {
202:     for (const seasonData of Object.values(playerData)) {
203:       for (const gameTypeData of Object.values(seasonData)) {
204:         for (const loc of ['home', 'away']) {
205:           const ctx = gameTypeData[loc];
206:           if (!ctx) continue;
207:           for (const statKey of STAT_KEYS) {
208:             ctx[statKey] = (ctx[statKey] || []).map(({ _team, _eventDate, ...rest }) => rest);
209:           }
210:         }
211:       }
212:     }
213:   }
214: }
215: 
216: async function getPlayerStats() {
217:   let existing = {};
218:   if (fs.existsSync('nhl_player_stats.json')) {
219:     try {
220:       existing = JSON.parse(fs.readFileSync('nhl_player_stats.json', 'utf-8'));
221:       console.log(`Stats NHL existentes: ${Object.keys(existing).length} jogadores.`);
222:     } catch {
223:       console.warn('nhl_player_stats.json inválido — iniciando do zero.');
224:     }
225:   }
226: 
227:   const lastDate = getLastProcessedDate(existing);
228:   let months;
229: 
230:   if (lastDate) {
231:     console.log(`Última data: ${lastDate}`);
232:     months = getIncrementalRange(lastDate);
233:     console.log(`Incremental: ${months[0].start} → ${months[0].end}`);
234:   } else {
235:     console.log('Histórico completo...');
236:     months = FULL_MONTHS;
237:   }
238: 
239:   const allEvents = [];
240:   for (const { start, end, season } of months) {
241:     console.log(`Buscando ${start}–${end} (temporada ${season})...`);
242:     try {
243:       const events = await fetchEventIds(start, end);
244:       for (const ev of events) ev._season = season;
245:       allEvents.push(...events);
