135:             players[player][outcome.name] = { price: outcome.price, line: outcome.point };
136:           }
137: 
138:           for (const [player, sides] of Object.entries(players)) {
139:             if (!sides.Over || !sides.Under) continue;
140:             const team = playerTeam[player];
141:             let location = 'unknown';
142:             if (team) {
143:               if (team === event.home_team) location = 'home';
144:               else if (team === event.away_team) location = 'away';
145:             }
146:             allProps.push({
147:               game: `${event.home_team} x ${event.away_team}`,
148:               commence_time: event.commence_time,
149:               player,
150:               prop: propType,
151:               location,
152:               line: sides.Over.line,
153:               oddsOver: sides.Over.price,
154:               oddsUnder: sides.Under.price,
155:             });
156:           }
157:         }
