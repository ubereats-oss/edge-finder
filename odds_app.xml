 16: 
 17: class _FootballScreenState extends State<FootballScreen> {
 18:   List<Map<String, dynamic>> _propsResults = [];
 19:   DateTime? _propsUpdated;
 20:   bool _loading = false;
 21:   String _status = '';
 22:   double _minEdge = 0;
