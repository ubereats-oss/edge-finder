877:   static String buildExportText({
878:     required String sport,
879:     required List<Map<String, dynamic>> localRanked,
880:     required List<Map<String, dynamic>>? geminiRanked,
881:   }) {
882:     final now = DateTime.now();
883:     final dateStr =
884:         '${now.day.toString().padLeft(2, '0')}/${now.month.toString().padLeft(2, '0')}/${now.year} '
885:         '${now.hour.toString().padLeft(2, '0')}:${now.minute.toString().padLeft(2, '0')}';
886: 
887:     final buf = StringBuffer();
888:     buf.writeln('EDGE FINDER — AVALIAÇÃO DE EDGES');
889:     buf.writeln('Esporte: $sport');
890:     buf.writeln('Gerado em: $dateStr');
891:     buf.writeln('=' * 60);
892: 
893:     buf.writeln();
894:     buf.writeln('ALGORITMO LOCAL');
895:     buf.writeln('=' * 60);
896: 
897:     for (int i = 0; i < localRanked.length; i++) {
898:       final p = localRanked[i];
899:       final rank = i + 1;
900:       final score = (p['_localScore'] as double).toStringAsFixed(0);
901:       final edge = (p['edge'] as num).toDouble().toStringAsFixed(1);
902:       final modelProb = (p['modelProb'] as num).toDouble().toStringAsFixed(1);
903:       final impliedProb =
904:           (p['impliedProb'] as num).toDouble().toStringAsFixed(1);
905:       final line = (p['line'] as num).toDouble().toStringAsFixed(1);
906:       final side = p['side'] as String;
907:       final avg5 = (p['playerAvg5'] as num?)?.toDouble().toStringAsFixed(1);
908:       final avg10 = (p['playerAvg10'] as num?)?.toDouble().toStringAsFixed(1);
909:       final avg = (p['playerAvg'] as num?)?.toDouble().toStringAsFixed(1);
910:       final kelly = (p['kelly'] as num?)?.toDouble().toStringAsFixed(1);
911:       final just = generateLocalJustification(p);
912: 
913:       buf.writeln();
914:       buf.writeln('#$rank — Score: $score/100');
915:       buf.writeln('Jogador: ${p['player']}');
916:       buf.writeln(
917:           'Aposta: ${_propLabel(p['prop'] as String)} ${side == 'Over' ? 'Over' : 'Under'} $line');
918:       buf.writeln('Jogo: ${p['game']}');
919:       buf.writeln(
920:           'Edge: $edge% | Modelo: $modelProb% | Mercado: $impliedProb%');
921:       if (avg != null) buf.writeln('Média geral: $avg');
922:       if (avg5 != null || avg10 != null) {
923:         buf.writeln(
924:             'Forma: ${avg5 != null ? 'Méd.5j=$avg5' : ''} ${avg10 != null ? 'Méd.10j=$avg10' : ''}'
925:                 .trim());
926:       }
927:       if (kelly != null) buf.writeln('Kelly: $kelly%');
928:       if (p['inefficientMarket'] == true) buf.writeln('★ Mercado ineficiente');
929:       if (p['lowSample'] == true) buf.writeln('⚠ Amostra reduzida');
930:       buf.writeln('Análise:');
931:       for (final line2 in just.split('\n')) {
932:         buf.writeln('  • $line2');
933:       }
934:       buf.writeln('-' * 40);
935:     }
936: 
937:     if (geminiRanked != null && geminiRanked.isNotEmpty) {
938:       buf.writeln();
939:       buf.writeln();
940:       buf.writeln('GEMINI AI (gemini-2.5-flash-lite + Google Search)');
941:       buf.writeln('=' * 60);
942: 
943:       for (int i = 0; i < geminiRanked.length; i++) {
944:         final p = geminiRanked[i];
945:         final rank = i + 1;
946:         final aiProb = (p['_aiProb'] as num).toDouble().toStringAsFixed(0);
947:         final just = p['_aiJust'] as String? ?? '';
948:         final edge = (p['edge'] as num).toDouble().toStringAsFixed(1);
949:         final line = (p['line'] as num).toDouble().toStringAsFixed(1);
950:         final side = p['side'] as String;
951: 
952:         buf.writeln();
953:         buf.writeln('#$rank — Prob. IA: $aiProb%');
954:         buf.writeln('Jogador: ${p['player']}');
955:         buf.writeln(
956:             'Aposta: ${_propLabel(p['prop'] as String)} ${side == 'Over' ? 'Over' : 'Under'} $line');
957:         buf.writeln('Jogo: ${p['game']}');
958:         buf.writeln('Edge: $edge%');
959:         if (just.isNotEmpty) {
960:           buf.writeln('Análise IA: $just');
961:         }
962:         buf.writeln('-' * 40);
963:       }
964:     }
965: 
966:     return buf.toString();
967:   }
