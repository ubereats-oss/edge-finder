 55:   Future<void> _loadAll() async {
 56:     setState(() => _loading = true);
 57:     try {
 58:       final h2h = await ApiService.fetchNbaResults();
 59:       final props = await ApiService.fetchNbaProps();
 60:       final enriched = await EdgeEvaluatorService.enrichWithContext(props.data, 'nba');
 61:       final filtered = EdgeEvaluatorService.adaptiveFilter(enriched);
 62:       setState(() {
 63:         _h2hResults = h2h.data;
 64:         _propsResults = filtered;
 65:         _h2hUpdated = h2h.lastUpdated;
 66:         _propsUpdated = props.lastUpdated;
 67:       });
