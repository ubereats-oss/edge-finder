 1: const fs = require('fs');
 2: 
 3: function readJsonSafe(file, fallback) {
 4:   if (!fs.existsSync(file)) return fallback;
 5:   try { return JSON.parse(fs.readFileSync(file, 'utf-8')); } catch { return fallback; }
 6: }
 7: 
 8: const ranking = readJsonSafe('ranking.json', {});
 9: const odds = readJsonSafe('odds.json', []);
10: 
11: if (!Object.keys(ranking).length) {
12:   console.log('ranking.json não encontrado — modelo tênis ignorado.');
13:   fs.writeFileSync('model_results.json', JSON.stringify([], null, 2));
14:   process.exit(0);
15: }
16: 
17: function rankToRating(rank) {
18:   return 2000 - (rank * 5);
19: }
20: 
21: function calcProb(r1, r2) {
22:   return 1 / (1 + Math.pow(10, -(r1 - r2) / 400));
23: }
24: 
25: function findRank(apiName) {
26:   if (ranking[apiName]) return ranking[apiName];
27: 
28:   const parts = apiName.trim().split(' ');
29:   for (let i = 1; i < parts.length; i++) {
30:     const candidate = parts.slice(i).join(' ') + ' ' + parts.slice(0, i).join(' ');
31:     if (ranking[candidate]) return ranking[candidate];
32:   }
33: 
34:   return null;
35: }
36: 
37: if (!odds.length) {
38:   console.log('odds.json vazio — sem partidas disponíveis no momento.');
39:   process.exit(0);
40: }
41: 
42: let descartados = 0;
43: 
44: const results = odds.map(m => {
45:   const r1 = findRank(m.player1);
46:   const r2 = findRank(m.player2);
47: 
48:   if (!r1 || !r2) {
49:     descartados++;
50:     return null;
51:   }
52: 
53:   const rating1 = rankToRating(r1);
54:   const rating2 = rankToRating(r2);
55: 
56:   const modelProb1 = calcProb(rating1, rating2);
57:   const modelProb2 = 1 - modelProb1;
58: 
59:   const probOdds1 = 1 / m.odds1;
60:   const probOdds2 = 1 / m.odds2;
61: 
62:   const edge1 = modelProb1 - probOdds1;
63:   const edge2 = modelProb2 - probOdds2;
64: 
65:   return {
66:     match: `${m.player1} x ${m.player2}`,
67:     modelProb1: parseFloat((modelProb1 * 100).toFixed(1)),
68:     modelProb2: parseFloat((modelProb2 * 100).toFixed(1)),
69:     impliedProb1: parseFloat((probOdds1 * 100).toFixed(1)),
70:     impliedProb2: parseFloat((probOdds2 * 100).toFixed(1)),
71:     edge1: parseFloat((edge1 * 100).toFixed(2)),
72:     edge2: parseFloat((edge2 * 100).toFixed(2))
73:   };
74: }).filter(Boolean);
75: 
76: console.log(`Partidas processadas: ${results.length} | Descartadas (sem ranking): ${descartados}`);
77: 
78: if (results.length) {
79:   results
80:     .sort((a, b) => Math.max(b.edge1, b.edge2) - Math.max(a.edge1, a.edge2))
81:     .slice(0, 10)
82:     .forEach((m, i) => {
83:       const edge = m.edge1 >= m.edge2
84:         ? `${m.match.split(' x ')[0]} EDGE: ${m.edge1}%`
85:         : `${m.match.split(' x ')[1]} EDGE: ${m.edge2}%`;
86:       console.log(`[${i + 1}] ${m.match} | ${edge}`);
87:     });
88: }
89: 
90: fs.writeFileSync('model_results.json', JSON.stringify(results, null, 2));
91: console.log('model_results.json salvo.');
</file>

