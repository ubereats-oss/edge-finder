 75:   Future<void> _waitForWorkflow() async {
 76:     for (int i = 0; i < 36; i++) {
 77:       await Future.delayed(const Duration(seconds: 5));
 78:       try {
 79:         final status = await ApiService.getWorkflowStatus();
 80:         if (status == 'completed') return;
 81:       } catch (_) {}
 82:     }
 83:   }
 84: 
 85:   Future<void> _runQuick() async {
 86:     setState(() {
 87:       _loading = true;
 88:       _status = 'Acionando workflow...';
 89:     });
 90:     try {
 91:       await ApiService.triggerUpdate('mlb');
 92:       setState(() => _status = 'Aguardando conclusão...');
 93:       await _waitForWorkflow();
 94:       setState(() => _status = 'Carregando...');
 95:       await _loadAll();
 96:       setState(() => _status = 'Concluído.');
 97:     } catch (e) {
 98:       _showError(e.toString());
 99:     } finally {
100:       setState(() => _loading = false);
101:     }
102:   }
103: 
104:   Future<void> _runFull() async {
105:     setState(() {
106:       _loading = true;
107:       _status = 'Acionando atualização completa...';
108:     });
109:     try {
110:       await ApiService.triggerUpdate('all');
111:       setState(() => _status = 'Aguardando conclusão (~20 min)...');
112:       await _waitForWorkflow();
113:       setState(() => _status = 'Carregando...');
114:       await _loadAll();
115:       setState(() => _status = 'Concluído.');
116:     } catch (e) {
117:       _showError(e.toString());
