 34:   bool _jogoValido(Map<String, dynamic> item) {
 35:     final raw = item['commence_time'] as String?;
 36:     if (raw == null) return true;
 37:     final dt = DateTime.tryParse(raw)?.toUtc();
 38:     if (dt == null) return true;
 39:     return dt.difference(DateTime.now().toUtc()) >= _min15;
