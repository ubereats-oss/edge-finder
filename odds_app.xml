149:       ),
150:       builder: (_) => Padding(
151:         padding: const EdgeInsets.all(24),
152:         child: Column(
153:           mainAxisSize: MainAxisSize.min,
154:           children: [
155:             const Text('Atualizar dados',
156:                 style: TextStyle(
157:                     color: Colors.white,
158:                     fontSize: 18,
159:                     fontWeight: FontWeight.bold)),
160:             const SizedBox(height: 24),
