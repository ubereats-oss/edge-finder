<file path="pipeline/build_nba_backtest_cache.js">
 1: const fs = require('fs');
 2: 
 3: // Lê nba_player_stats.json e gera nba_boxscores_cache.json no formato game-centric
 4: // esperado pelo backtest_nba_props_v2.js
 5: //
 6: // Agrupamento: date + opponent + location → cada entrada tem todos os jogadores
 7: // daquele time naquele jogo (home e away ficam em entradas separadas, o que é
 8: // suficiente para o backtest pois ele processa cada jogador individualmente).
 9: 
10: const STAT_KEYS = ['points', 'rebounds', 'assists', 'steals', 'fouls', 'threes'];
11: // Mapeamento de temporada ESPN → label do backtest
12: const SEASON_LABEL = { 2025: 'base', 2026: 'walk' };
13: 
14: function main() {
15:   if (!fs.existsSync('nba_player_stats.json')) {
16:     console.error('ERRO: nba_player_stats.json não encontrado.');
17:     process.exit(1);
18:   }
19: 
20:   const playerStats = JSON.parse(fs.readFileSync('nba_player_stats.json', 'utf8'));
21:   const playerTeam  = fs.existsSync('nba_player_team.json')
22:     ? JSON.parse(fs.readFileSync('nba_player_team.json', 'utf8'))
23:     : {};
24: 
25:   const games = {};
26: 
27:   for (const [playerName, seasonsData] of Object.entries(playerStats)) {
28:     const currentTeam = playerTeam[playerName] || 'Unknown';
29: 
30:     for (const [seasonStr, seasonData] of Object.entries(seasonsData)) {
31:       const season = SEASON_LABEL[parseInt(seasonStr)];
32:       if (!season) continue;
33: 
34:       for (const gameTypeData of Object.values(seasonData)) {
35:         for (const loc of ['home', 'away']) {
36:           const ctx = gameTypeData[loc];
37:           if (!ctx || !ctx.points || ctx.points.length === 0) continue;
38: 
39:           const n = ctx.points.length;
40:           for (let i = 0; i < n; i++) {
41:             const base = ctx.points[i];
42:             const { date, opponent } = base;
43:             if (!date || !opponent) continue;
44: 
45:             const gameKey = date.slice(0, 10) + '|' + opponent + '|' + loc;
46: 
47:             if (!games[gameKey]) {
48:               games[gameKey] = {
49:                 date,
50:                 season,
51:                 homeTeam: loc === 'home' ? currentTeam : opponent,
52:                 awayTeam: loc === 'away' ? currentTeam : opponent,
53:                 players: [],
54:               };
55:             }
56: 
57:             const stats = {};
58:             for (const stat of STAT_KEYS) {
59:               const arr = ctx[stat];
60:               stats[stat] = arr && arr[i] !== undefined ? (arr[i].value ?? 0) : 0;
61:             }
62: 
63:             games[gameKey].players.push({ playerName, location: loc, stats });
64:           }
65:         }
66:       }
67:     }
68:   }
69: 
70:   const gameCount      = Object.keys(games).length;
71:   const playerGames    = Object.values(games).reduce((s, g) => s + g.players.length, 0);
72:   const withThrees     = Object.values(games).flatMap(g => g.players).filter(p => p.stats.threes > 0).length;
73:   const baseCount      = Object.values(games).filter(g => g.season === 'base').length;
74:   const walkCount      = Object.values(games).filter(g => g.season === 'walk').length;
75: 
76:   console.log(`Games: ${gameCount} (base: ${baseCount} | walk: ${walkCount})`);
77:   console.log(`Player-games: ${playerGames} | com threes > 0: ${withThrees}`);
78: 
79:   fs.writeFileSync('nba_boxscores_cache.json', JSON.stringify(games));
80:   console.log('nba_boxscores_cache.json salvo.');
81: }
82: 
83: main();
</file>

<file path="pipeline/repair_mlb_strikeouts.js">
  1: // Corrige valores de strikeouts (K) no mlb_player_stats.json
  2: // ESPN usa label 'K', não 'SO'. Todos os valores estavam salvos como 0.
  3: // Processa meses a partir de 2024 (suficiente para base + walk do backtest).
  4: 
  5: const axios = require('axios');
  6: const fs    = require('fs');
  7: 
  8: const MONTHS_TO_REPAIR = [
  9:   { start: '20240320', end: '20240331', season: 2024 },
 10:   { start: '20240401', end: '20240430', season: 2024 },
 11:   { start: '20240501', end: '20240531', season: 2024 },
 12:   { start: '20240601', end: '20240630', season: 2024 },
 13:   { start: '20240701', end: '20240731', season: 2024 },
 14:   { start: '20240801', end: '20240831', season: 2024 },
 15:   { start: '20240901', end: '20240930', season: 2024 },
 16:   { start: '20241001', end: '20241031', season: 2024 },
 17:   { start: '20250318', end: '20250331', season: 2025 },
 18:   { start: '20250401', end: '20250430', season: 2025 },
 19:   { start: '20250501', end: '20250531', season: 2025 },
 20:   { start: '20260319', end: '20260331', season: 2026 },
 21:   { start: '20260401', end: '20260430', season: 2026 },
 22:   { start: '20260501', end: '20260531', season: 2026 },
 23: ];
 24: 
 25: function sleep(ms) { return new Promise(r => setTimeout(r, ms)); }
 26: 
 27: async function fetchEvents(start, end) {
 28:   const url = `https://site.api.espn.com/apis/site/v2/sports/baseball/mlb/scoreboard?limit=200&dates=${start}-${end}`;
 29:   const res = await axios.get(url);
 30:   return (res.data.events || [])
 31:     .filter(e => e.competitions?.[0]?.status?.type?.completed)
 32:     .map(e => {
 33:       const comp = e.competitions[0];
 34:       const home = comp.competitors.find(c => c.homeAway === 'home');
 35:       const away = comp.competitors.find(c => c.homeAway === 'away');
 36:       return {
 37:         id:       e.id,
 38:         date:     e.date,
 39:         season:   e.season?.year,
 40:         homeTeam: home?.team?.displayName,
 41:         awayTeam: away?.team?.displayName,
 42:       };
 43:     });
 44: }
 45: 
 46: async function fetchPitcherK(eventId) {
 47:   const url = `https://site.api.espn.com/apis/site/v2/sports/baseball/mlb/summary?event=${eventId}`;
 48:   const res = await axios.get(url);
 49:   const result = {};
 50:   for (const team of res.data.boxscore?.players || []) {
 51:     const teamName = team.team?.displayName;
 52:     for (const group of team.statistics || []) {
 53:       const labels = group.labels || [];
 54:       if (!labels.includes('IP')) continue;
 55:       const idxK = labels.indexOf('K') !== -1 ? labels.indexOf('K') : labels.indexOf('SO');
 56:       if (idxK === -1) continue;
 57:       for (const athlete of group.athletes || []) {
 58:         const name = athlete.athlete?.displayName;
 59:         if (!name) continue;
 60:         const k = parseFloat((athlete.stats || [])[idxK]) || 0;
 61:         result[name] = { k, team: teamName };
 62:       }
 63:     }
 64:   }
 65:   return result;
 66: }
 67: 
 68: async function main() {
 69:   if (!fs.existsSync('mlb_player_stats.json')) {
 70:     console.error('ERRO: mlb_player_stats.json não encontrado.');
 71:     process.exit(1);
 72:   }
 73: 
 74:   console.log('Carregando mlb_player_stats.json...');
 75:   const data = JSON.parse(fs.readFileSync('mlb_player_stats.json', 'utf8'));
 76: 
 77:   // Índice rápido: name -> season -> gameType -> loc -> Map<dateKey, entry>
 78:   const index = {};
 79:   for (const [name, playerData] of Object.entries(data)) {
 80:     index[name] = {};
 81:     for (const [seasonStr, seasonData] of Object.entries(playerData)) {
 82:       index[name][seasonStr] = {};
 83:       for (const [gt, gtd] of Object.entries(seasonData)) {
 84:         index[name][seasonStr][gt] = {};
 85:         for (const loc of ['home', 'away']) {
 86:           const ctx = gtd[loc];
 87:           if (!ctx?.strikeouts) continue;
 88:           const map = new Map();
 89:           for (const entry of ctx.strikeouts) {
 90:             const key = (entry.date || '').slice(0, 10) + '|' + (entry.opponent || '');
 91:             map.set(key, entry);
 92:           }
 93:           index[name][seasonStr][gt][loc] = map;
 94:         }
 95:       }
 96:     }
 97:   }
 98: 
 99:   let totalPatched = 0;
100:   let totalGames   = 0;
101: 
102:   for (const { start, end, season } of MONTHS_TO_REPAIR) {
103:     console.log(`Processando ${start}–${end} (season ${season})...`);
104:     let events;
105:     try {
106:       events = await fetchEvents(start, end);
107:     } catch (e) {
108:       console.warn(`  Erro ao buscar eventos: ${e.message}`);
109:       continue;
110:     }
111:     console.log(`  ${events.length} jogos completos`);
112: 
113:     for (const event of events) {
114:       totalGames++;
115:       try {
116:         const pitcherK = await fetchPitcherK(event.id);
117:         const seasonStr = String(season);
118:         const dateKey10 = (event.date || '').slice(0, 10);
119: 
120:         for (const [name, { k, team }] of Object.entries(pitcherK)) {
121:           const isHome = team === event.homeTeam;
122:           const opponent = isHome ? event.awayTeam : event.homeTeam;
123:           const loc = isHome ? 'home' : 'away';
124:           const entryKey = `${dateKey10}|${opponent}`;
125: 
126:           for (const gt of ['regular', 'playoffs']) {
127:             const entry = index[name]?.[seasonStr]?.[gt]?.[loc]?.get(entryKey);
128:             if (entry && entry.value !== k) {
129:               entry.value = k;
130:               totalPatched++;
131:             }
132:           }
133:         }
134:       } catch { /* boxscore indisponível */ }
135: 
136:       await sleep(150);
137:       if (totalGames % 50 === 0) console.log(`  ${totalGames} jogos, ${totalPatched} K corrigidos`);
138:     }
139:   }
140: 
141:   console.log(`\nTotal: ${totalGames} jogos processados, ${totalPatched} valores de K corrigidos.`);
142:   fs.writeFileSync('mlb_player_stats.json', JSON.stringify(data));
143:   console.log('mlb_player_stats.json salvo.');
144: }
145: 
146: main();
</file>

<file path=".github/workflows/update_all.yml">
  1: name: Atualizar Todos os Esportes
