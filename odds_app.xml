 870:   String _buildExportText() {
 871:     final now = DateTime.now();
 872:     final dateStr =
 873:         '${now.day.toString().padLeft(2, '0')}/${now.month.toString().padLeft(2, '0')}/${now.year}';
 874:     final buf = StringBuffer();
 875:     buf.writeln('MINHAS APOSTAS — EDGE FINDER');
 876:     buf.writeln('Exportado em $dateStr');
 877:     buf.writeln('=' * 40);
 878:     if (_resolved.isNotEmpty) {
 879:       final winRate = _wins / _resolved.length * 100;
 880:       buf.writeln('');
 881:       buf.writeln('RESUMO');
 882:       buf.writeln('Apostas resolvidas: ${_resolved.length}');
 883:       buf.writeln('Acertos: $_wins (${winRate.toStringAsFixed(1)}%)');
 884:       buf.writeln(
 885:           'Lucro total: ${_totalProfit >= 0 ? '+' : ''}R\$ ${_totalProfit.toStringAsFixed(2)}');
 886:       buf.writeln('-' * 40);
 887:     }
 888:     if (_pending.isNotEmpty) {
 889:       buf.writeln('');
 890:       buf.writeln('PENDENTES (${_pending.length})');
 891:       buf.writeln('-' * 40);
 892:       for (final b in _pending) {
 893:         _appendBet(buf, b);
 894:       }
 895:     }
 896:     if (_resolved.isNotEmpty) {
 897:       buf.writeln('');
 898:       buf.writeln('RESOLVIDAS (${_resolved.length})');
 899:       buf.writeln('-' * 40);
 900:       for (final b in _resolved) {
 901:         _appendBet(buf, b);
 902:       }
 903:     }
 904:     return buf.toString();
 905:   }
