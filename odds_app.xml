 40:       'hits': Color(0xFFFFD600),
 41:       'homeRuns': Color(0xFFFF6D00),
 42:       'strikeouts': Color(0xFF7C4DFF),
 43:       'hitsAllowed': Color(0xFF00B0FF),
 44:     };
 45:     return colors[p] ?? const Color(0xFFAAAAAA);
 46:   }
 47: 
 48:   String _formatCommenceTime(String? raw) {
 49:     if (raw == null) return '';
 50:     final dt = DateTime.tryParse(raw)?.toLocal();
 51:     if (dt == null) return '';
 52:     final d = '${dt.day.toString().padLeft(2, '0')}/${dt.month.toString().padLeft(2, '0')}';
 53:     final h = '${dt.hour.toString().padLeft(2, '0')}:${dt.minute.toString().padLeft(2, '0')}';
 54:     return '$d às $h';
 55:   }
 56: 
 57:   @override
 58:   Widget build(BuildContext context) {
 59:     final edge         = (widget.prop['edge'] as num).toDouble();
 60:     final avg          = (widget.prop['playerAvg'] as num).toDouble();
 61:     final std          = (widget.prop['playerStd'] as num).toDouble();
 62:     final avg5         = (widget.prop['playerAvg5'] as num?)?.toDouble();
 63:     final avg10        = (widget.prop['playerAvg10'] as num?)?.toDouble();
 64:     final playerTeam   = widget.prop['playerTeam'] as String?;
 65:     final line         = (widget.prop['line'] as num).toDouble();
 66:     final modelProb    = (widget.prop['modelProb'] as num).toDouble();
 67:     final impliedProb  = (widget.prop['impliedProb'] as num).toDouble();
 68:     final side         = widget.prop['side'] as String;
 69:     final odds         = (widget.prop['odds'] as num).toDouble();
 70:     final isPitcher    = widget.prop['isPitcher'] == true;
 71:     final kelly        = (widget.prop['kelly'] as num?)?.toDouble() ?? 0;
 72:     final lowSample    = widget.prop['lowSample'] == true;
