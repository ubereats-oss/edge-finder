 907:   void _appendBet(StringBuffer buf, Map<String, dynamic> b) {
 908:     final isH2h = b['type'] == 'h2h';
 909:     final isPending = b['status'] == 'pending';
 910:     final title = isH2h
 911:         ? (b['team'] as String? ?? b['game'] as String? ?? '')
 912:         : (b['player'] as String? ?? '');
 913:     final desc = isH2h
 914:         ? 'Vitória · ${b['game'] as String? ?? ''}'
 915:         : '${b['side']} ${b['line']} ${_propLabel(b['prop'] as String? ?? '')}';
 916:     final date = _formatDate(b['commence_time'] as String?);
 917:     final odds = (b['odds'] as num).toStringAsFixed(2);
 918:     final stake = (b['stake'] as num).toStringAsFixed(2);
 919:     final profit = (b['profit'] as num?)?.toDouble();
 920:     final won = b['won'] as bool?;
 921:     final bookmaker = b['bookmaker'] as String?;
 922: 
 923:     buf.writeln('• $title');
 924:     buf.writeln('  $desc');
 925:     if (date.isNotEmpty) buf.writeln('  $date');
 926:     if (bookmaker != null && bookmaker.isNotEmpty) buf.writeln('  Casa: $bookmaker');
 927:     buf.write('  @$odds  R\$ $stake');
 928:     if (!isPending && profit != null) {
 929:       buf.write(
 930:           '  →  ${won == true ? '✅' : '❌'} ${profit >= 0 ? '+' : ''}R\$ ${profit.toStringAsFixed(2)}');
 931:     } else {
 932:       buf.write('  ⏳ Pendente');
 933:     }
 934:     buf.writeln();
 935:     buf.writeln();
 936:   }
