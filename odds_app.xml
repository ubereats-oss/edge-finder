 42: function calibrate(p) {
 43:   if (p < 0.5) return 1 - calibrate(1 - p);
 44:   const n = CALIB_TABLE.length;
 45:   if (p <= CALIB_TABLE[0].raw) {
 46:     const slope = (CALIB_TABLE[1].cal - CALIB_TABLE[0].cal) / (CALIB_TABLE[1].raw - CALIB_TABLE[0].raw);
 47:     return Math.min(1, Math.max(0, CALIB_TABLE[0].cal + slope * (p - CALIB_TABLE[0].raw)));
 48:   }
 49:   if (p >= CALIB_TABLE[n - 1].raw) {
 50:     const slope = (CALIB_TABLE[n - 1].cal - CALIB_TABLE[n - 2].cal) / (CALIB_TABLE[n - 1].raw - CALIB_TABLE[n - 2].raw);
 51:     return Math.min(1, Math.max(0, CALIB_TABLE[n - 1].cal + slope * (p - CALIB_TABLE[n - 1].raw)));
 52:   }
 53:   for (let i = 0; i < n - 1; i++) {
 54:     if (p >= CALIB_TABLE[i].raw && p <= CALIB_TABLE[i + 1].raw) {
 55:       const t = (p - CALIB_TABLE[i].raw) / (CALIB_TABLE[i + 1].raw - CALIB_TABLE[i].raw);
 56:       return CALIB_TABLE[i].cal + t * (CALIB_TABLE[i + 1].cal - CALIB_TABLE[i].cal);
 57:     }
 58:   }
 59:   return p;
