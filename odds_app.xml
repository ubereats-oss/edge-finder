107: function calcKelly(p, odd) {
108:   const b = odd - 1;
109:   const q = 1 - p;
110:   const kelly = (p * b - q) / b;
111:   return Math.max(0, parseFloat((kelly * KELLY_FRACTION * 100).toFixed(2)));
112: }
