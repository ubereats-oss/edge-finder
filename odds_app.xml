 613:   Future<void> _exportExcel() async {
 614:     final ex = xl.Excel.createExcel();
 615:     final sheetName = 'Apostas';
 616:     final sheet = ex[sheetName];
 617:     ex.delete('Sheet1');
 618: 
 619:     const headers = [
 620:       'Esporte', 'Data', 'Jogo', 'Props', 'Aposta',
 621:       'Probabilidades', 'Aposta (BRL)', 'Saldo / Déficit', 'Status',
 622:     ];
 623:     for (int i = 0; i < headers.length; i++) {
 624:       sheet
 625:           .cell(xl.CellIndex.indexByColumnRow(columnIndex: i, rowIndex: 0))
 626:           .value = xl.TextCellValue(headers[i]);
 627:     }
 628: 
 629:     double totalStake = 0;
 630:     double totalProfit = 0;
 631: 
 632:     for (int i = 0; i < _bets.length; i++) {
 633:       final b = _bets[i];
 634:       final row = i + 1;
 635:       final isPending = b['status'] != 'resolved';
 636:       final profit = (b['profit'] as num?)?.toDouble();
 637:       final stake = (b['stake'] as num).toDouble();
 638:       final odds = (b['odds'] as num).toDouble();
 639:       final isH2h = b['type'] == 'h2h';
 640: 
 641:       sheet.cell(xl.CellIndex.indexByColumnRow(columnIndex: 0, rowIndex: row)).value =
 642:           xl.TextCellValue(_sportForBet(b));
 643:       sheet.cell(xl.CellIndex.indexByColumnRow(columnIndex: 1, rowIndex: row)).value =
 644:           xl.TextCellValue(_dateExcel(b['commence_time'] as String?));
 645:       sheet.cell(xl.CellIndex.indexByColumnRow(columnIndex: 2, rowIndex: row)).value =
 646:           xl.TextCellValue((b['game'] as String? ?? '').replaceAll(' x ', '\nx\n'));
 647:       sheet.cell(xl.CellIndex.indexByColumnRow(columnIndex: 3, rowIndex: row)).value =
 648:           xl.TextCellValue(isH2h ? '' : _propLabel(b['prop'] as String? ?? ''));
 649:       sheet.cell(xl.CellIndex.indexByColumnRow(columnIndex: 4, rowIndex: row)).value =
 650:           xl.TextCellValue(_betDescExcel(b));
 651:       sheet.cell(xl.CellIndex.indexByColumnRow(columnIndex: 5, rowIndex: row)).value =
 652:           xl.DoubleCellValue(odds);
 653:       sheet.cell(xl.CellIndex.indexByColumnRow(columnIndex: 6, rowIndex: row)).value =
 654:           xl.DoubleCellValue(stake);
 655:       if (profit != null) {
 656:         sheet.cell(xl.CellIndex.indexByColumnRow(columnIndex: 7, rowIndex: row)).value =
 657:             xl.DoubleCellValue(profit);
 658:       }
 659:       sheet.cell(xl.CellIndex.indexByColumnRow(columnIndex: 8, rowIndex: row)).value =
 660:           xl.TextCellValue(isPending ? 'Pendente' : (b['won'] == true ? 'Ganhou' : 'Perdeu'));
 661: 
 662:       totalStake += stake;
 663:       totalProfit += profit ?? 0;
 664:     }
 665: 
 666:     final totalRow = _bets.length + 1;
 667:     sheet.cell(xl.CellIndex.indexByColumnRow(columnIndex: 1, rowIndex: totalRow)).value =
 668:         xl.TextCellValue('Total');
 669:     sheet.cell(xl.CellIndex.indexByColumnRow(columnIndex: 6, rowIndex: totalRow)).value =
 670:         xl.DoubleCellValue(totalStake);
 671:     sheet.cell(xl.CellIndex.indexByColumnRow(columnIndex: 7, rowIndex: totalRow)).value =
 672:         xl.DoubleCellValue(totalProfit);
 673: 
 674:     final bytes = ex.encode()!;
 675:     await saveAndShareFile(
 676:         bytes, 'apostas_${DateTime.now().millisecondsSinceEpoch}.xlsx');
 677:   }
