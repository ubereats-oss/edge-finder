224:           final bP = b['isPitcher'] == true ? 0 : 1;
225:           if (aP != bP) return aP - bP;
226:           return (b['edge'] as num).compareTo(a['edge'] as num);
227:         });
228:       for (final prop in sorted) {
229:         widgets.add(MlbPropCard(prop: prop));
230:       }
231:     }
232:     return widgets;
