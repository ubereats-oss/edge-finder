327: function stripInternalFields(raw) {
328:   for (const playerData of Object.values(raw)) {
329:     for (const seasonData of Object.values(playerData)) {
330:       for (const gameTypeData of Object.values(seasonData)) {
331:         for (const loc of ['home', 'away']) {
332:           const ctx = gameTypeData[loc];
333:           if (!ctx) continue;
334:           for (const statKey of ALL_STAT_KEYS) {
335:             ctx[statKey] = (ctx[statKey] || []).map(({ _team, _eventDate, ...rest }) => rest);
336:           }
337:         }
338:       }
339:     }
340:   }
341: }
