307:   // ── Calibração e Brier Score ───────────────────────────────────────────────
308:   const buckets = {};
309:   for (let i = 0; i <= 9; i++) {
310:     buckets[(0.5 + i * 0.05).toFixed(2)] = { predicted: 0, actual: 0, n: 0 };
