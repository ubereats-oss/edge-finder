  4: class MatchCard extends StatelessWidget {
  5:   final Map<String, dynamic> match;
  6: 
  7:   const MatchCard({super.key, required this.match});
  8: 
  9:   Color _edgeColor(double edge) {
 10:     if (edge >= 5) return const Color(0xFF00C853);
 11:     if (edge >= 2) return const Color(0xFFFFD600);
 12:     return const Color(0xFFFF1744);
 13:   }
 14: 
 15:   String _formatCommenceTime(String? raw) {
 16:     if (raw == null) return '';
 17:     final dt = DateTime.tryParse(raw)?.toLocal();
 18:     if (dt == null) return '';
 19:     final d = '${dt.day.toString().padLeft(2, '0')}/${dt.month.toString().padLeft(2, '0')}';
 20:     final h = '${dt.hour.toString().padLeft(2, '0')}:${dt.minute.toString().padLeft(2, '0')}';
 21:     return '$d às $h';
 22:   }
 23: 
 24:   @override
 25:   Widget build(BuildContext context) {
 26:     final parts = (match['match'] as String).split(' x ');
 27:     final p1 = parts[0];
 28:     final p2 = parts.length > 1 ? parts[1] : '';
 29:     final e1 = (match['edge1'] as num).toDouble();
 30:     final e2 = (match['edge2'] as num).toDouble();
 31:     final bestEdge = e1 >= e2 ? e1 : e2;
 32:     final bestPlayer = e1 >= e2 ? p1 : p2;
 33:     final kelly = (match['kelly'] as num?)?.toDouble() ?? 0;
 34:     final banca = PrefsService.getBanca();
 35:     final valorKelly = banca > 0 ? banca * kelly / 100 : 0.0;
 36:     final commenceTime = _formatCommenceTime(match['commence_time'] as String?);
 37: 
 38:     return Card(
 39:       color: const Color(0xFF1E1E2E),
 40:       margin: const EdgeInsets.symmetric(horizontal: 16, vertical: 6),
 41:       shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(12)),
 42:       child: Padding(
 43:         padding: const EdgeInsets.all(16),
 44:         child: Column(
 45:           crossAxisAlignment: CrossAxisAlignment.start,
 46:           children: [
 47:             Row(
 48:               mainAxisAlignment: MainAxisAlignment.spaceBetween,
 49:               children: [
 50:                 Expanded(
 51:                   child: Text(
 52:                     match['match'] as String,
 53:                     style: const TextStyle(
 54:                         color: Colors.white,
 55:                         fontSize: 15,
 56:                         fontWeight: FontWeight.bold),
 57:                   ),
 58:                 ),
 59:                 if (commenceTime.isNotEmpty)
 60:                   Text(
 61:                     commenceTime,
 62:                     style: const TextStyle(
 63:                         color: Color(0xFF888888), fontSize: 11),
 64:                   ),
 65:               ],
 66:             ),
 67:             const SizedBox(height: 10),
 68:             Row(
 69:               children: [
 70:                 _probCol(p1, (match['modelProb1'] as num).toDouble(),
 71:                     (match['impliedProb1'] as num).toDouble()),
 72:                 const SizedBox(width: 12),
 73:                 _probCol(p2, (match['modelProb2'] as num).toDouble(),
 74:                     (match['impliedProb2'] as num).toDouble()),
 75:               ],
 76:             ),
 77:             const SizedBox(height: 10),
 78:             Container(
 79:               padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 6),
 80:               decoration: BoxDecoration(
 81:                 color: _edgeColor(bestEdge).withValues(alpha: 0.15),
 82:                 borderRadius: BorderRadius.circular(8),
 83:                 border: Border.all(color: _edgeColor(bestEdge), width: 1),
 84:               ),
 85:               child: Text(
 86:                 'Edge: $bestPlayer ${bestEdge.toStringAsFixed(2)}%',
 87:                 style: TextStyle(
 88:                     color: _edgeColor(bestEdge), fontWeight: FontWeight.bold),
 89:               ),
 90:             ),
 91:             if (kelly > 0) ...[
 92:               const SizedBox(height: 8),
 93:               Container(
 94:                 padding:
 95:                     const EdgeInsets.symmetric(horizontal: 12, vertical: 6),
 96:                 decoration: BoxDecoration(
 97:                   color: const Color(0xFF7C4DFF).withValues(alpha: 0.1),
 98:                   borderRadius: BorderRadius.circular(8),
 99:                   border: Border.all(
100:                       color: const Color(0xFF7C4DFF).withValues(alpha: 0.4)),
101:                 ),
102:                 child: Row(
103:                   children: [
104:                     Text(
105:                       'Kelly: ${kelly.toStringAsFixed(2)}%',
106:                       style: const TextStyle(
107:                           color: Color(0xFF7C4DFF),
108:                           fontWeight: FontWeight.bold,
109:                           fontSize: 13),
110:                     ),
111:                     if (banca > 0) ...[
112:                       const SizedBox(width: 8),
113:                       Text(
114:                         '→ R\$ ${valorKelly.toStringAsFixed(2)}',
115:                         style: const TextStyle(
116:                             color: Color(0xFF9E7DFF), fontSize: 13),
117:                       ),
118:                     ],
119:                   ],
120:                 ),
121:               ),
122:             ],
123:           ],
124:         ),
125:       ),
