 56: // ── Calibração isotônica ───────────────────────────────────────────────────────
 57: const CALIB_TABLE = [
 58:   { raw: 0.519, cal: 0.504 },
 59:   { raw: 0.576, cal: 0.572 },
 60:   { raw: 0.625, cal: 0.608 },
 61:   { raw: 0.674, cal: 0.671 },
 62:   { raw: 0.723, cal: 0.720 },
 63:   { raw: 0.771, cal: 0.764 },
 64:   { raw: 0.816, cal: 0.811 },
 65: ];
 66: 
 67: function calibrate(p) {
 68:   if (p < 0.5) return 1 - calibrate(1 - p);
 69:   const n = CALIB_TABLE.length;
 70:   if (p <= CALIB_TABLE[0].raw) {
 71:     const slope = (CALIB_TABLE[1].cal - CALIB_TABLE[0].cal) /
 72:                   (CALIB_TABLE[1].raw - CALIB_TABLE[0].raw);
 73:     return Math.min(1, Math.max(0, CALIB_TABLE[0].cal + slope * (p - CALIB_TABLE[0].raw)));
 74:   }
 75:   if (p >= CALIB_TABLE[n - 1].raw) {
 76:     const slope = (CALIB_TABLE[n - 1].cal - CALIB_TABLE[n - 2].cal) /
 77:                   (CALIB_TABLE[n - 1].raw - CALIB_TABLE[n - 2].raw);
 78:     return Math.min(1, Math.max(0, CALIB_TABLE[n - 1].cal + slope * (p - CALIB_TABLE[n - 1].raw)));
 79:   }
 80:   for (let i = 0; i < n - 1; i++) {
 81:     if (p >= CALIB_TABLE[i].raw && p <= CALIB_TABLE[i + 1].raw) {
 82:       const t = (p - CALIB_TABLE[i].raw) / (CALIB_TABLE[i + 1].raw - CALIB_TABLE[i].raw);
 83:       return CALIB_TABLE[i].cal + t * (CALIB_TABLE[i + 1].cal - CALIB_TABLE[i].cal);
 84:     }
 85:   }
 86:   return p;
 87: }
