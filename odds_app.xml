 75:   Future<void> _runQuick() async {
 76:     setState(() {
 77:       _loading = true;
 78:       _status = 'Buscando odds...';
 79:     });
 80:     try {
 81:       await ApiService.post('nba/update-odds');
 82:       setState(() => _status = 'Buscando props...');
 83:       await ApiService.post('nba/update-props');
 84:       setState(() => _status = 'Rodando modelos...');
 85:       await ApiService.post('nba/run-model');
 86:       await ApiService.post('nba/run-props-model');
 87:       setState(() => _status = 'Carregando...');
 88:       await _loadAll();
 89:       setState(() => _status = 'Concluído.');
 90:     } catch (e) {
 91:       _showError(e.toString());
 92:     } finally {
 93:       setState(() => _loading = false);
