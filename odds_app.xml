 30: const SPORTS_WITH_PROPS = new Set([
 31:   'basketball_nba',
 32: ]);
 33: 
 34: const HISTORY_DIR    = path.join(__dirname, 'odds_history');
 35: const KEY_STATE_FILE = path.join(HISTORY_DIR, '_key_state.json');
 36: const PROPS_MARKETS  = 'player_points,player_rebounds,player_assists,player_steals,player_threes';
 37: 
 38: let keyIndex = 0;
 39: const keyBalances = {};
 40: 
 41: function sleep(ms) { return new Promise(r => setTimeout(r, ms)); }
 42: 
 43: // ── Gestão de chaves ───────────────────────────────────────────────────────────
 44: function loadKeyState() {
 45:   if (!fs.existsSync(KEY_STATE_FILE)) return;
 46:   try {
 47:     const state = JSON.parse(fs.readFileSync(KEY_STATE_FILE));
 48:     if (state.month === monthStr()) keyIndex = state.keyIndex ?? 0;
 49:   } catch {}
 50: }
 51: 
 52: function saveKeyState() {
 53:   writeJson(KEY_STATE_FILE, { month: monthStr(), keyIndex, savedAt: nowISO(), balances: keyBalances });
 54: }
 55: 
 56: function currentKey() { return API_KEYS[keyIndex % API_KEYS.length]; }
 57: 
 58: function rotateKey() {
 59:   keyIndex = (keyIndex + 1) % API_KEYS.length;
 60:   saveKeyState();
 61:   console.log(`  [key] rotacionando para chave ${keyIndex}`);
 62: }
 63: 
 64: async function apiGet(url, params = {}) {
 65:   for (let i = 0; i < API_KEYS.length; i++) {
 66:     try {
 67:       const res = await axios.get(url, { params: { ...params, apiKey: currentKey() } });
 68:       const rem  = parseInt(res.headers['x-requests-remaining'] ?? '999');
 69:       const used = parseInt(res.headers['x-requests-used'] ?? '0');
 70:       const last = parseInt(res.headers['x-requests-last'] ?? '0');
 71:       keyBalances[keyIndex] = { remaining: rem, used, lastCost: last, updatedAt: nowISO() };
 72:       saveKeyState();
 73:       if (rem < 10) { console.log(`  [key] chave ${keyIndex} quase esgotada (${rem}) — rotacionando`); rotateKey(); }
 74:       return res.data;
 75:     } catch (e) {
 76:       if (e.response?.status === 401 || e.response?.status === 429) {
 77:         console.warn(`  [key] chave ${keyIndex} inválida/esgotada — rotacionando`);
 78:         rotateKey();
 79:         await sleep(500);
 80:       } else throw e;
 81:     }
 82:   }
 83:   throw new Error('Todas as chaves esgotadas');
 84: }
 85: 
 86: // ── Utilitários ────────────────────────────────────────────────────────────────
 87: function ensureDir(dir) { if (!fs.existsSync(dir)) fs.mkdirSync(dir, { recursive: true }); }
 88: function todayStr()     { return new Date().toISOString().slice(0, 10); }
 89: function monthStr()     { return new Date().toISOString().slice(0, 7); }
 90: function nowISO()       { return new Date().toISOString(); }
 91: 
 92: function readJson(filePath) {
 93:   if (!fs.existsSync(filePath)) return [];
 94:   try { return JSON.parse(fs.readFileSync(filePath, 'utf8')); } catch { return []; }
 95: }
 96: 
 97: function writeJson(filePath, data) {
 98:   fs.writeFileSync(filePath, JSON.stringify(data, null, 2));
 99: }
100: 
101: function appendRecords(sport, type, records) {
102:   const file    = path.join(HISTORY_DIR, `${sport}_${type}_${monthStr()}.json`);
103:   const history = readJson(file);
104:   const existing = new Set(history.map(e => e._key));
105:   let added = 0;
106:   for (const r of records) {
107:     if (existing.has(r._key)) continue;
108:     history.push(r);
109:     existing.add(r._key);
110:     added++;
111:   }
112:   writeJson(file, history);
113:   console.log(`  [${sport}/${type}] +${added} novos (total: ${history.length})`);
114: }
115: 
116: // ── Coleta H2H ────────────────────────────────────────────────────────────────
117: async function collectH2H(sportKey) {
118:   const data = await apiGet(
119:     `https://api.the-odds-api.com/v4/sports/${sportKey}/odds/`,
120:     { regions: 'eu', markets: 'h2h', oddsFormat: 'decimal' }
121:   );
122:   if (!data?.length) return;
123: 
124:   const today = todayStr();
125:   const now   = nowISO();
126:   const records = [];
127: 
128:   for (const event of data) {
129:     for (const bm of event.bookmakers ?? []) {
130:       const market = bm.markets?.find(m => m.key === 'h2h');
131:       if (!market) continue;
132:       const o = market.outcomes;
133:       records.push({
134:         _key:          `${sportKey}|${event.id}|${bm.key}|${today}`,
135:         sport:         sportKey,
136:         savedDate:     today,
137:         savedAt:       now,
138:         eventId:       event.id,
139:         commence_time: event.commence_time,
140:         home_team:     event.home_team,
141:         away_team:     event.away_team,
142:         bookmaker:     bm.key,
143:         last_update:   bm.last_update ?? null,
144:         sport_key:     sportKey,
145:         odds_home:     o.find(x => x.name === event.home_team)?.price ?? null,
146:         odds_away:     o.find(x => x.name === event.away_team)?.price ?? null,
147:       });
148:     }
149:   }
150: 
151:   appendRecords(sportKey, 'h2h', records);
152: }
153: 
154: // ── Coleta Props ───────────────────────────────────────────────────────────────
155: async function collectProps(sportKey) {
156:   const events = await apiGet(`https://api.the-odds-api.com/v4/sports/${sportKey}/events`, {});
157:   if (!events?.length) return;
158: 
159:   const today   = todayStr();
160:   const now     = nowISO();
161:   const records = [];
162: 
163:   for (const event of events) {
164:     try {
165:       const data = await apiGet(
166:         `https://api.the-odds-api.com/v4/sports/${sportKey}/events/${event.id}/odds`,
167:         { regions: 'eu', markets: PROPS_MARKETS, oddsFormat: 'decimal' }
168:       );
169:       for (const bm of data.bookmakers ?? []) {
170:         for (const market of bm.markets ?? []) {
171:           const players = {};
172:           for (const outcome of market.outcomes ?? []) {
173:             const p = outcome.description;
174:             if (!players[p]) players[p] = {};
175:             players[p][outcome.name] = { price: outcome.price, line: outcome.point };
176:           }
177:           for (const [player, sides] of Object.entries(players)) {
178:             if (!sides.Over || !sides.Under) continue;
179:             records.push({
180:               _key:          `${sportKey}|${event.id}|${bm.key}|${market.key}|${player}|${today}`,
181:               sport:         sportKey,
182:               savedDate:     today,
183:               savedAt:       now,
184:               eventId:       event.id,
185:               commence_time: event.commence_time,
186:               home_team:     event.home_team,
187:               away_team:     event.away_team,
188:               bookmaker:     bm.key,
189:               prop:          market.key,
190:               player,
191:               line:          sides.Over.line,
192:               oddsOver:      sides.Over.price,
193:               oddsUnder:     sides.Under.price,
194:               last_update:   market.last_update ?? null,
195:               sport_key:     sportKey,
196:             });
197:           }
198:         }
199:       }
200:       await sleep(300);
201:     } catch (e) {
202:       console.warn(`  [${sportKey}/props] erro no evento ${event.id}: ${e.message}`);
203:     }
204:   }
205: 
206:   appendRecords(sportKey, 'props', records);
207: }
208: 
209: // ── Relatório ──────────────────────────────────────────────────────────────────
210: function printReport() {
211:   console.log('\n── Histórico acumulado ──────────────────────────');
212:   const files = fs.readdirSync(HISTORY_DIR)
213:     .filter(f => f.endsWith('.json') && !f.startsWith('_'))
214:     .sort();
215:   for (const f of files) {
216:     const data = readJson(path.join(HISTORY_DIR, f));
217:     const days = [...new Set(data.map(e => e.savedDate))].length;
218:     console.log(`  ${f.padEnd(50)} ${String(data.length).padStart(6)} registros | ${days} dias`);
219:   }
220:   console.log('────────────────────────────────────────────────');
221: }
222: 
223: // ── Main ───────────────────────────────────────────────────────────────────────
224: async function main() {
225:   console.log(`\n[save_odds_history] ${nowISO()}`);
226:   ensureDir(HISTORY_DIR);
227:   loadKeyState();
228: 
229:   console.log('Esportes configurados:', [...SPORTS_TO_COLLECT].join(', '));
230:   const sportKeys = [...SPORTS_TO_COLLECT];
231: 
232:   for (const sportKey of sportKeys) {
233:     console.log(`\n[${sportKey}]`);
234:     try {
235:       await collectH2H(sportKey);
236:       if (SPORTS_WITH_PROPS.has(sportKey)) await collectProps(sportKey);
237:       await sleep(200);
238:     } catch (e) {
239:       console.error(`  ERRO: ${e.message}`);
240:     }
241:   }
242: 
243:   saveKeyState();
244:   printReport();
245:   console.log('\n[save_odds_history] concluído.\n');
246: }
247: 
248: main().catch(e => { console.error('ERRO FATAL:', e.message); process.exit(1); });
