  1: const fs = require('fs');
  2: 
  3: if (!fs.existsSync('mlb_team_rating.json')) {
  4:   console.log('mlb_team_rating.json não encontrado — pulando modelo MLB H2H.');
  5:   process.exit(0);
  6: }
  7: if (!fs.existsSync('mlb_odds.json')) {
  8:   console.log('mlb_odds.json não encontrado — pulando modelo MLB H2H.');
  9:   process.exit(0);
 10: }
 11: 
 12: const teamRating = JSON.parse(fs.readFileSync('mlb_team_rating.json'));
 13: const odds = JSON.parse(fs.readFileSync('mlb_odds.json'));
 14: 
 15: const SEASON_WEIGHT = { 2023: 1, 2024: 2, 2025: 3, 2026: 4 };
 16: const CURRENT_SEASON = 2026;
 17: const KELLY_FRACTION = 0.25;
 18: 
 19: function calcProb(r1, r2) {
 20:   return 1 / (1 + Math.exp(-(r1 - r2) / 0.5));
 21: }
 22: 
 23: function calcKelly(p, odd) {
 24:   const b = odd - 1;
 25:   const q = 1 - p;
 26:   const kelly = (p * b - q) / b;
 27:   return Math.max(0, parseFloat((kelly * KELLY_FRACTION * 100).toFixed(2)));
 28: }
 29: 
 30: function getWeightedRating(teamName, location) {
 31:   const data = teamRating[teamName];
 32:   if (!data) return null;
 33:   let weightedSum = 0;
 34:   let totalWeight = 0;
 35:   let hasCurrentSeason = false;
 36:   for (const [seasonStr, seasonData] of Object.entries(data)) {
 37:     const season = parseInt(seasonStr);
 38:     const w = SEASON_WEIGHT[season] || 1;
 39:     const r = seasonData?.regular?.[location];
 40:     if (r === undefined) continue;
 41:     weightedSum += r * w;
 42:     totalWeight += w;
 43:     if (season === CURRENT_SEASON) hasCurrentSeason = true;
 44:   }
 45:   if (totalWeight === 0) return null;
 46:   return { rating: weightedSum / totalWeight, hasCurrentSeason };
 47: }
 48: 
 49: function findTeam(name) {
 50:   if (teamRating[name]) return name;
 51:   const lower = name.toLowerCase();
 52:   for (const key of Object.keys(teamRating)) {
 53:     if (key.toLowerCase().includes(lower) || lower.includes(key.toLowerCase())) return key;
 54:   }
 55:   return null;
 56: }
 57: 
 58: if (!odds.length) {
 59:   console.log('mlb_odds.json vazio — sem partidas disponíveis.');
 60:   process.exit(0);
 61: }
 62: 
 63: let descartados = 0;
 64: const results = [];
 65: 
 66: for (const m of odds) {
 67:   const t1Key = findTeam(m.team1);
 68:   const t2Key = findTeam(m.team2);
 69:   if (!t1Key || !t2Key) { descartados++; continue; }
 70:   const r1 = getWeightedRating(t1Key, 'away');
 71:   const r2 = getWeightedRating(t2Key, 'home');
 72:   if (!r1 || !r2) { descartados++; continue; }
 73:   const modelProb1 = calcProb(r1.rating, r2.rating);
 74:   const modelProb2 = 1 - modelProb1;
 75:   const impliedProb1 = 1 / m.odds1;
 76:   const impliedProb2 = 1 / m.odds2;
 77:   const edge1 = modelProb1 - impliedProb1;
 78:   const edge2 = modelProb2 - impliedProb2;
 79:   const bestEdge = edge1 >= edge2 ? edge1 : edge2;
 80:   const bestProb = edge1 >= edge2 ? modelProb1 : modelProb2;
 81:   const bestOdds = edge1 >= edge2 ? m.odds1 : m.odds2;
 82:   results.push({
 83:     match: `${m.team1} x ${m.team2}`,
 84:     commence_time: m.commence_time,
 85:     modelProb1: parseFloat((modelProb1 * 100).toFixed(1)),
 86:     modelProb2: parseFloat((modelProb2 * 100).toFixed(1)),
 87:     impliedProb1: parseFloat((impliedProb1 * 100).toFixed(1)),
 88:     impliedProb2: parseFloat((impliedProb2 * 100).toFixed(1)),
 89:     edge1: parseFloat((edge1 * 100).toFixed(2)),
 90:     edge2: parseFloat((edge2 * 100).toFixed(2)),
 91:     kelly: calcKelly(bestProb, bestOdds),
 92:   });
 93: }
 94: 
 95: console.log(`Partidas processadas: ${results.length} | Descartadas: ${descartados}`);
 96: results.sort((a, b) => Math.max(b.edge1, b.edge2) - Math.max(a.edge1, a.edge2));
 97: results.slice(0, 10).forEach((m, i) => {
 98:   const edge = m.edge1 >= m.edge2
 99:     ? `${m.match.split(' x ')[0]} EDGE: ${m.edge1}% | Kelly: ${m.kelly}%`
100:     : `${m.match.split(' x ')[1]} EDGE: ${m.edge2}% | Kelly: ${m.kelly}%`;
101:   console.log(`[${i + 1}] ${m.match} | ${edge}`);
102: });
103: 
104: fs.writeFileSync('mlb_results.json', JSON.stringify(results, null, 2));
105: console.log('mlb_results.json salvo.');
</file>

