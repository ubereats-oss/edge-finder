  1: const axios = require('axios');
  2: const fs = require('fs');
  3: 
  4: if (fs.existsSync('.env')) {
  5:   for (const line of fs.readFileSync('.env', 'utf-8').split('\n')) {
  6:     const [k, ...v] = line.split('=');
  7:     if (k) process.env[k.trim()] = v.join('=').trim();
  8:   }
  9: }
 10: 
 11: const API_KEYS = [];
 12: for (let i = 1; i <= 19; i++) {
 13:   const key = i === 1 ? process.env.ODDS_API_KEY : process.env[`ODDS_API_KEY_${i}`];
 14:   if (key && key.trim()) API_KEYS.push(key.trim());
 15: }
 16: if (!API_KEYS.length) { console.error('Nenhuma chave ODDS_API_KEY encontrada.'); process.exit(1); }
 17: 
 18: const exhaustedKeys = new Set();
 19: let keyIndex = 0;
 20: 
 21: function getNextValidKey() {
 22:   for (let i = 0; i < API_KEYS.length; i++) {
 23:     const idx = (keyIndex + i) % API_KEYS.length;
 24:     if (!exhaustedKeys.has(idx)) {
 25:       keyIndex = (idx + 1) % API_KEYS.length;
 26:       return API_KEYS[idx];
 27:     }
 28:   }
 29:   return null;
 30: }
 31: 
 32: function markCurrentKeyExhausted() {
 33:   const idx = (keyIndex - 1 + API_KEYS.length) % API_KEYS.length;
 34:   exhaustedKeys.add(idx);
 35: }
 36: 
 37: const MARKETS = 'player_pass_yds,player_pass_tds,player_rush_yds,player_receptions,player_reception_yds';
 38: 
 39: function sleep(ms) {
 40:   return new Promise(resolve => setTimeout(resolve, ms));
 41: }
 42: 
 43: async function fetchEvents() {
 44:   const key = getNextValidKey();
 45:   if (!key) throw new Error('Todas as chaves esgotadas.');
 46:   const url = `https://api.the-odds-api.com/v4/sports/americanfootball_nfl/events?apiKey=${key}`;
 47:   const res = await axios.get(url);
 48:   return res.data;
 49: }
 50: 
 51: async function fetchEventProps(eventId) {
 52:   let lastError = null;
 53:   for (let attempt = 0; attempt < API_KEYS.length; attempt++) {
 54:     const key = getNextValidKey();
 55:     if (!key) break;
 56:     try {
 57:       const res = await axios.get(
 58:         `https://api.the-odds-api.com/v4/sports/americanfootball_nfl/events/${eventId}/odds`,
 59:         { params: { apiKey: key, regions: 'us', markets: MARKETS, oddsFormat: 'decimal' } }
 60:       );
 61:       const remaining = res.headers['x-requests-remaining'];
 62:       if (remaining !== undefined) console.log(`    Créditos restantes: ${remaining}`);
 63:       return res.data;
 64:     } catch (e) {
 65:       const msg = e.response?.data?.message || e.message || '';
 66:       if (msg.toLowerCase().includes('quota')) {
 67:         markCurrentKeyExhausted();
 68:         console.warn(`    Chave esgotada (${exhaustedKeys.size}/${API_KEYS.length}), tentando próxima...`);
 69:         await sleep(300);
 70:         lastError = e;
 71:         continue;
 72:       }
 73:       throw e;
 74:     }
 75:   }
 76:   throw lastError || new Error('Todas as chaves esgotadas para este evento.');
 77: }
 78: 
 79: async function getNflProps() {
 80:   let playerTeam = {};
 81:   if (fs.existsSync('nfl_player_team.json')) {
 82:     playerTeam = JSON.parse(fs.readFileSync('nfl_player_team.json'));
 83:   } else {
 84:     console.warn('nfl_player_team.json não encontrado — location não será preenchido.');
 85:   }
 86: 
 87:   try {
 88:     const events = await fetchEvents();
 89:     if (!events.length) {
 90:       console.log('Sem jogos NFL disponíveis.');
 91:       fs.writeFileSync('nfl_props.json', JSON.stringify([], null, 2));
 92:       return;
 93:     }
 94: 
 95:     console.log(`Jogos NFL encontrados: ${events.length}`);
 96:     const allProps = [];
 97: 
 98:     for (const event of events) {
 99:       if (exhaustedKeys.size >= API_KEYS.length) {
100:         console.error('Todas as chaves esgotadas — abortando.');
101:         break;
102:       }
103:       try {
104:         const data = await fetchEventProps(event.id);
105:         if (!data.bookmakers?.length) continue;
106: 
107:         // Agrega a melhor odd Over e Under por mercado entre todas as casas disponíveis
108:         const bestMarkets = {};
109:         for (const bm of data.bookmakers) {
110:           for (const mkt of (bm.markets ?? [])) {
111:             if (!bestMarkets[mkt.key]) bestMarkets[mkt.key] = { key: mkt.key, bestOutcomes: {} };
112:             for (const outcome of mkt.outcomes) {
113:               const k = `${outcome.description}||${outcome.name}`;
114:               if (!bestMarkets[mkt.key].bestOutcomes[k] ||
115:                   outcome.price > bestMarkets[mkt.key].bestOutcomes[k].price) {
116:                 bestMarkets[mkt.key].bestOutcomes[k] = outcome;
117:               }
118:             }
119:           }
120:         }
121: 
122:         for (const market of Object.values(bestMarkets)) {
123:           const propType = {
124:             player_pass_yds:      'passYards',
125:             player_pass_tds:      'passTDs',
126:             player_rush_yds:      'rushYards',
127:             player_receptions:    'receptions',
128:             player_reception_yds: 'receptionYards',
129:           }[market.key];
130:           if (!propType) continue;
131: 
132:           const players = {};
133:           for (const outcome of Object.values(market.bestOutcomes)) {
134:             const player = outcome.description;
135:             if (!players[player]) players[player] = {};
136:             players[player][outcome.name] = { price: outcome.price, line: outcome.point };
137:           }
138: 
139:           for (const [player, sides] of Object.entries(players)) {
140:             if (!sides.Over || !sides.Under) continue;
141:             const team = playerTeam[player];
142:             let location = 'unknown';
143:             if (team) {
144:               if (team === event.home_team) location = 'home';
145:               else if (team === event.away_team) location = 'away';
146:             }
147:             allProps.push({
148:               game: `${event.home_team} x ${event.away_team}`,
149:               commence_time: event.commence_time,
150:               player,
151:               prop: propType,
152:               location,
153:               line: sides.Over.line,
154:               oddsOver: sides.Over.price,
155:               oddsUnder: sides.Under.price,
156:             });
157:           }
158:         }
159: 
160:         console.log(`  ${event.home_team} x ${event.away_team}: OK`);
161:         await sleep(300);
162:       } catch (e) {
163:         console.error(`  Erro no evento ${event.id}:`, e.response?.data?.message || e.message);
164:       }
165:     }
166: 
167:     fs.writeFileSync('nfl_props.json', JSON.stringify(allProps, null, 2));
168:     console.log(`Props NFL salvas: ${allProps.length} entradas.`);
169:   } catch (e) {
170:     console.error('Erro ao buscar props NFL:', e.response?.data || e.message);
171:   }
172: }
173: 
174: getNflProps();
</file>

