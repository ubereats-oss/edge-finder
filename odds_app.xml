  4: function readJsonSafe(file, fallback) {
  5:   if (!fs.existsSync(file)) return fallback;
  6:   const raw = fs.readFileSync(file, 'utf-8').trim();
  7:   if (!raw) return fallback;
  8:   try { return JSON.parse(raw); } catch (e) {
  9:     console.warn(`Aviso: ${file} inválido — usando fallback. ${e.message}`);
 10:     return fallback;
 11:   }
 12: }
