  1: const fs = require('fs');
  2: 
  3: // ── Configuração ───────────────────────────────────────────────────────────────
  4: const BOXSCORES_CACHE = 'nba_boxscores_cache.json';
  5: const KELLY_FRACTION  = 0.25;
  6: const HOUSE_MARGIN    = 0.05;
  7: const MIN_GAMES_MKT   = 10;
  8: const MIN_GAMES_MODEL = 5;
  9: const STAT_KEYS       = ['points', 'rebounds', 'assists', 'steals', 'threes', 'fouls'];
 10: const BANKROLL_START  = 1000;
 11: const FLAT_STAKE_CAP  = BANKROLL_START * 0.05;
 12: const DECAY           = 0.98;
 13: 
 14: // ── Utilitários ────────────────────────────────────────────────────────────────
 15: function erf(x) {
 16:   const sign = x >= 0 ? 1 : -1;
 17:   x = Math.abs(x);
 18:   const a1 = 0.254829592, a2 = -0.284496736, a3 = 1.421413741;
 19:   const a4 = -1.453152027, a5 = 1.061405429, p = 0.3275911;
 20:   const t = 1 / (1 + p * x);
 21:   const y = 1 - (((((a5 * t + a4) * t) + a3) * t + a2) * t + a1) * t * Math.exp(-x * x);
 22:   return sign * y;
 23: }
 24: 
 25: function normalCDF(x, mu, sigma) {
 26:   if (sigma <= 0) return x >= mu ? 1 : 0;
 27:   return 0.5 * (1 + erf((x - mu) / (sigma * Math.sqrt(2))));
 28: }
 29: 
 30: function probOver(mu, sigma, line)  { return 1 - normalCDF(line, mu, sigma); }
 31: function probUnder(mu, sigma, line) { return normalCDF(line, mu, sigma); }
 32: 
 33: function marketOdd(p) {
 34:   if (p <= 0.01) return null;
 35:   return 1 / (p * (1 + HOUSE_MARGIN));
 36: }
 37: 
 38: function calcKelly(prob, odds) {
 39:   const b = odds - 1;
 40:   const q = 1 - prob;
 41:   const k = (prob * b - q) / b;
 42:   return Math.max(0, k * KELLY_FRACTION);
 43: }
 44: 
 45: function calcAvgStd(values) {
 46:   if (!values || values.length === 0) return null;
 47:   const avg = values.reduce((s, v) => s + v, 0) / values.length;
 48:   const variance = values.reduce((s, v) => s + Math.pow(v - avg, 2), 0) / values.length;
 49:   return { avg, std: Math.sqrt(variance), count: values.length };
 50: }
 51: 
 52: function calcWeightedAvgStd(values) {
 53:   if (!values || values.length === 0) return null;
 54:   let wSum = 0, wSumSq = 0, totalW = 0;
 55:   const n = values.length;
 56:   for (let i = 0; i < n; i++) {
 57:     const w = Math.pow(DECAY, n - 1 - i);
 58:     wSum   += values[i] * w;
 59:     wSumSq += values[i] * values[i] * w;
 60:     totalW += w;
 61:   }
 62:   const avg = wSum / totalW;
 63:   const variance = Math.max(0, wSumSq / totalW - avg * avg);
 64:   return { avg, std: Math.sqrt(variance), count: n };
 65: }
 66: 
 67: // ── Calibração isotônica ───────────────────────────────────────────────────────
 68: const CALIB_TABLE = [
 69:   { raw: 0.519, cal: 0.504 },
 70:   { raw: 0.576, cal: 0.572 },
 71:   { raw: 0.625, cal: 0.608 },
 72:   { raw: 0.674, cal: 0.671 },
 73:   { raw: 0.723, cal: 0.720 },
 74:   { raw: 0.771, cal: 0.764 },
 75:   { raw: 0.816, cal: 0.811 },
 76: ];
 77: 
 78: function calibrate(p) {
 79:   if (p < 0.5) return 1 - calibrate(1 - p);
 80:   const n = CALIB_TABLE.length;
 81:   if (p <= CALIB_TABLE[0].raw) {
 82:     const slope = (CALIB_TABLE[1].cal - CALIB_TABLE[0].cal) /
 83:                   (CALIB_TABLE[1].raw - CALIB_TABLE[0].raw);
 84:     return Math.min(1, Math.max(0, CALIB_TABLE[0].cal + slope * (p - CALIB_TABLE[0].raw)));
 85:   }
 86:   if (p >= CALIB_TABLE[n - 1].raw) {
 87:     const slope = (CALIB_TABLE[n - 1].cal - CALIB_TABLE[n - 2].cal) /
 88:                   (CALIB_TABLE[n - 1].raw - CALIB_TABLE[n - 2].raw);
 89:     return Math.min(1, Math.max(0, CALIB_TABLE[n - 1].cal + slope * (p - CALIB_TABLE[n - 1].raw)));
 90:   }
 91:   for (let i = 0; i < n - 1; i++) {
 92:     if (p >= CALIB_TABLE[i].raw && p <= CALIB_TABLE[i + 1].raw) {
 93:       const t = (p - CALIB_TABLE[i].raw) / (CALIB_TABLE[i + 1].raw - CALIB_TABLE[i].raw);
 94:       return CALIB_TABLE[i].cal + t * (CALIB_TABLE[i + 1].cal - CALIB_TABLE[i].cal);
 95:     }
 96:   }
 97:   return p;
 98: }
