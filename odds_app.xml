102: // ── Linha de mercado simulada por stat ────────────────────────────────────────
103: // shots: arredonda para o 0.5 mais próximo; demais: piso + 0.5
104: function calcLine(stat, avg) {
105:   if (stat === 'shots') return Math.round(avg * 2) / 2;
106:   return Math.floor(avg) + 0.5;
107: }
