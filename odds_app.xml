292:     // Atualiza modelRaw APÓS todas as predições desta partida
293:     if (!modelRaw[playerName]) modelRaw[playerName] = {};
294:     for (const surf of [surface, 'all']) {
295:       if (!modelRaw[playerName][surf]) modelRaw[playerName][surf] = {};
296:       for (const stat of STAT_KEYS) {
297:         const v = stats[stat];
298:         if (v === null || v === undefined) continue;
299:         if (!modelRaw[playerName][surf][stat]) modelRaw[playerName][surf][stat] = [];
300:         modelRaw[playerName][surf][stat].push({ value: v });
301:       }
302:     }
