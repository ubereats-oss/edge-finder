name: Atualizar Todos os Esportes

on:
  schedule:
    - cron: '0 18 * * *'
  workflow_dispatch:
    inputs:
      sports:
        description: 'Esporte(s) a atualizar'
        required: false
        default: 'all'
        type: choice
        options:
          - all
          - nba
          - mlb
          - nhl
          - nfl
          - tennis

permissions:
  contents: write

jobs:

  # ── NBA ───────────────────────────────────────────────────────────────────
  nba:
    if: >-
      github.event_name == 'schedule' ||
      github.event.inputs.sports == 'all' ||
      github.event.inputs.sports == 'nba'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          token: ${{ secrets.GH_PAT }}
          persist-credentials: true

      - uses: actions/setup-node@v4
        with:
          node-version: '24'

      - run: npm install axios

      - name: Injetar chaves
        run: |
          node -e "
          const keys = process.env.ODDS_API_KEYS.split(',');
          const lines = keys.map((k,i) => (i===0?'ODDS_API_KEY':'ODDS_API_KEY_'+(i+1))+'='+k.trim());
          require('fs').appendFileSync(process.env.GITHUB_ENV, lines.join('\n')+'\n');
          console.log('Chaves injetadas:',keys.length);
          "
        env:
          ODDS_API_KEYS: ${{ secrets.ODDS_API_KEYS }}

      - name: Restaurar stats NBA
        run: |
          git fetch origin data 2>/dev/null || true
          git show origin/data:nba_player_stats.json.gz > /tmp/nba_ps.gz 2>/dev/null && \
            gunzip -c /tmp/nba_ps.gz > nba_player_stats.json || true
          for f in nba_player_team.json nba_boxscores_cache.json nba_injuries_today.json nba_rating.json; do
            git show origin/data:$f > $f 2>/dev/null || true
          done
          git show origin/data:bets.json > bets.json 2>/dev/null || echo '[]' > bets.json

      - run: node pipeline/get_nba_injuries.js
      - run: node pipeline/get_nba_player_teams.js
      - run: node pipeline/get_nba_props_br.js
      - run: node pipeline/model_nba_props_br.js
      - run: node pipeline/get_nba_odds.js
      - run: node pipeline/model_nba.js

      - name: Empacotar artefatos NBA
        run: |
          mkdir -p /tmp/nba-out
          gzip -c nba_player_stats.json > /tmp/nba-out/nba_player_stats.json.gz 2>/dev/null || true
          for f in nba_props_br_results.json nba_results.json nba_player_team.json nba_player_positions.json nba_boxscores_cache.json nba_injuries_today.json nba_rating.json bets.json; do
            [ -f "$f" ] && cp "$f" /tmp/nba-out/ || true
          done

      - uses: actions/upload-artifact@v4
        with:
          name: nba-out
          path: /tmp/nba-out/
          if-no-files-found: warn

  # ── MLB ───────────────────────────────────────────────────────────────────
