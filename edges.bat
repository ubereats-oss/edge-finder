node -e "require('fs').readFileSync('.env','utf-8').split('\n').forEach(l=>{const[k,...v]=l.split('=');if(k)process.env[k.trim()]=v.join('=').trim()});const https=require('https');https.get('https://firestore.googleapis.com/v1/projects/odds-app-edge/databases/(default)/documents/results/nba_props_br',res=>{let d='';res.on('data',c=>d+=c);res.on('end',()=>{const b=JSON.parse(d);const vals=b.fields?.data?.arrayValue?.values??[];const props=vals.map(v=>{const f=v.mapValue?.fields??{};const g=k=>f[k]?.stringValue??f[k]?.doubleValue??f[k]?.integerValue??null;return{player:g('player'),prop:g('prop'),line:g('line'),side:g('side'),edge:g('edge'),kelly:g('kelly'),modelProb:g('modelProb'),oddsOver:g('oddsOver'),oddsUnder:g('oddsUnder'),game:g('game')};}).filter(p=>p.edge>0).sort((a,b)=>b.edge-a.edge);console.log(JSON.stringify(props,null,2));});}).on('error',e=>console.error(e.message));"