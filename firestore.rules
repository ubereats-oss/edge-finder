rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // results/ e odds_history/ — somente leitura pública
    match /results/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /odds_history/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // model_report/ — relatório de desempenho do modelo, gravado só pelo
    // pipeline (Admin SDK, ignora estas regras). Leitura para usuário
    // autenticado (todo usuário do app já é autenticado — login anônimo
    // automático em main.dart), sem escrita nenhuma do cliente.
    match /model_report/{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // bets/ — usuário autenticado acessa apenas as próprias apostas
    // O pipeline (service account) tem acesso admin via SDK e ignora estas regras
    match /bets/{betId} {
      allow read, delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      // uid do documento existente precisa continuar igual depois do
      // update — sem isso, o dono podia trocar o campo uid da própria
      // aposta pra outro valor (nunca sobrescreve odd/dado de outro
      // usuário sozinho, mas corrompe a própria aposta ou, sabendo/
      // adivinhando o uid de outra vítima, "planta" um registro nela).
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid;
    }
  }
}
