rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Dono único do app — login e-mail/senha restrito a esta conta
    // (main.dart/auth_gate.dart bloqueiam qualquer outra no cliente; isto
    // é a garantia no servidor). Agora que qualquer pessoa pode criar
    // conta por e-mail/senha no endereço público do app, request.auth !=
    // null sozinho não basta em nenhuma coleção — toda regra abaixo usa
    // isOwner(). UID não é usado porque a conta foi criada direto pelo
    // Admin SDK; o claim de e-mail verificado do token é equivalente em
    // segurança.
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'sallesconsultant@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // results/ e odds_history/ — dados de odds/resultados do pipeline.
    // Eram de leitura pública (allow read: if true); com cadastro aberto
    // por e-mail/senha isso deixou de fazer sentido. O app só lê essas
    // coleções depois do login (api_service.dart já manda o token em
    // todas as chamadas), então restringir não quebra nada.
    match /results/{document=**} {
      allow read: if isOwner();
      allow write: if false;
    }

    match /odds_history/{document=**} {
      allow read: if isOwner();
      allow write: if false;
    }

    // model_report/ — relatório de desempenho do modelo, gravado só pelo
    // pipeline (Admin SDK, ignora estas regras). Antes bastava
    // request.auth != null (só existia o dono autenticado); agora precisa
    // de isOwner(). Sem escrita do cliente.
    match /model_report/{document=**} {
      allow read: if isOwner();
      allow write: if false;
    }

    // pinnacle_reference/ — referência de odds da Pinnacle (tela "Conferir
    // odds"), gravada só pelo pipeline (Admin SDK). Leitura restrita ao
    // dono (repositório é público; qualquer um podia ler antes).
    match /pinnacle_reference/{document=**} {
      allow read: if isOwner();
      allow write: if false;
    }

    // pt_value_report/ — relatório "Valor real nas casas que posso usar",
    // gravado só pelo pipeline. Leitura restrita ao dono.
    match /pt_value_report/{document=**} {
      allow read: if isOwner();
      allow write: if false;
    }

    // odds_checks/ — conferências de odds da tela "Conferir odds". Só o
    // dono (única conta autorizada a logar no app) lê/escreve; o pipeline
    // (sync_pt_odds_checks.js, Admin SDK) ignora estas regras.
    match /odds_checks/{checkId} {
      allow read, write: if isOwner();
    }

    // bets/ — histórico de apostas, só do dono. Antes era por igualdade de
    // uid (fazia sentido com 1 uid por sessão anônima); com cadastro
    // aberto por e-mail/senha, qualquer conta nova podia criar/ler as
    // próprias apostas nesse modelo — trocado para isOwner(), mesma
    // condição das outras coleções. Bônus: como a condição não depende
    // mais de resource.data, a listagem sem filtro que o app já fazia
    // (fetchBets) funciona sem precisar de query por uid.
    match /bets/{betId} {
      allow read, write: if isOwner();
    }
  }
}
