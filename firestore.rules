rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // results/ e odds_history/ — somente leitura pública
    match /results/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /odds_history/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // model_report/ — relatório de desempenho do modelo, gravado só pelo
    // pipeline (Admin SDK, ignora estas regras). Leitura para usuário
    // autenticado (todo usuário do app já é autenticado — login anônimo
    // automático em main.dart), sem escrita nenhuma do cliente.
    match /model_report/{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // pinnacle_reference/ — referência de odds da Pinnacle (tela "Conferir
    // odds"), gravada só pelo pipeline (Admin SDK). Leitura para usuário
    // autenticado, sem escrita do cliente — mesmo padrão de model_report/.
    match /pinnacle_reference/{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // pt_value_report/ — relatório "Valor real nas casas que posso usar",
    // gravado só pelo pipeline. Mesmo padrão de model_report/.
    match /pt_value_report/{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // odds_checks/ — conferências de odds da tela "Conferir odds". O
    // próprio usuário cria e marca como feita; o pipeline
    // (sync_pt_odds_checks.js, Admin SDK) também atualiza syncedToLedger,
    // ignorando estas regras. Mesmo modelo de bets/: só o dono lê/edita.
    match /odds_checks/{checkId} {
      allow read, delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid;
    }

    // bets/ — usuário autenticado acessa apenas as próprias apostas
    // O pipeline (service account) tem acesso admin via SDK e ignora estas regras
    match /bets/{betId} {
      allow read, delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      // uid do documento existente precisa continuar igual depois do
      // update — sem isso, o dono podia trocar o campo uid da própria
      // aposta pra outro valor (nunca sobrescreve odd/dado de outro
      // usuário sozinho, mas corrompe a própria aposta ou, sabendo/
      // adivinhando o uid de outra vítima, "planta" um registro nela).
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid;
    }
  }
}
